<Project Sdk="Microsoft.NET.Sdk">

  <!-- Wegwerf-Werkzeug, kein Produktivcode. Steht unter tools/ und ist NICHT in
       GonkNote.slnx eingetragen — dieselbe Regel wie beim Stylus-Prototyp (HANDOFF §3).

       Aus der zentralen Paketverwaltung ausgeklinkt, weil es keine Pakete benutzt: es
       ruft zwei Systembibliotheken auf, die auf jedem X-System liegen. Genau das ist der
       Sinn — es soll ohne Installation laufen. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <AssemblyName>zeiger</AssemblyName>
    <RootNamespace>GonkNote.Werkzeug</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
