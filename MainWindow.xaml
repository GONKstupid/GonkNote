<Window x:Class="GonkNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GonkNote.ViewModels"
        xmlns:views="clr-namespace:GonkNote.Views"
        xmlns:loc="clr-namespace:GonkNote.Services"
        Title="Gonk Note" Width="1280" Height="820"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowBg}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource Brush.Text}">

    <Window.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <views:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <views:ZeroToVisibilityConverter x:Key="ZeroToVis"/>

        <DataTemplate DataType="{x:Type vm:WhiteboardTabViewModel}">
            <views:WhiteboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TextTabViewModel}">
            <views:TextEditorView/>
        </DataTemplate>

        <!-- Fensterknöpfe der einblendbaren Titelleiste (im maximierten Fenster) -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}"/>
        <KeyBinding Modifiers="Control+Shift" Key="S" Command="{Binding SaveAllCommand}"/>
        <KeyBinding Modifiers="Control" Key="T" Command="{Binding ToggleThemeCommand}"/>
        <KeyBinding Modifiers="Control" Key="W" Command="{Binding CloseTabCommand}"
                    CommandParameter="{Binding SelectedTab}"/>
    </Window.InputBindings>

    <!-- Wurzel-Grid: normaler Inhalt + darüberliegende einblendbare Titelleiste -->
    <Grid>
    <DockPanel>

        <!-- ===== Menüleiste ===== -->
        <!-- Doppelklick maximiert/verkleinert (das maximierte Fenster hat keine Titelleiste) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.SidebarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <DockPanel>
            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE700;"
                    ToolTip="{loc:T Sidebar.Toggle}" Margin="4,2"
                    Click="ToggleSidebar_Click"/>
            <Menu Padding="0,2">
                <MenuItem Header="{loc:T Menu.File}">
                    <MenuItem Header="{loc:T Menu.File.NewFolder}" Command="{Binding NewFolderCommand}"/>
                    <MenuItem Header="{loc:T Menu.File.NewNotebook}" Command="{Binding NewNotebookCommand}"/>
                    <MenuItem Header="{loc:T Menu.File.NewWhiteboard}" Command="{Binding NewWhiteboardCommand}"/>
                    <MenuItem Header="{loc:T Menu.File.NewText}" Command="{Binding NewTextDocCommand}"/>
                    <Separator/>
                    <MenuItem Header="{loc:T Menu.File.Import}" Command="{Binding ImportDocxCommand}"/>
                    <MenuItem Header="{loc:T Menu.File.Export}" Command="{Binding ExportCommand}"/>
                    <Separator/>
                    <MenuItem Header="{loc:T Menu.File.Save}" Command="{Binding SaveCommand}" InputGestureText="{loc:T Shortcut.Save}"/>
                    <MenuItem Header="{loc:T Menu.File.SaveAll}" Command="{Binding SaveAllCommand}" InputGestureText="{loc:T Shortcut.SaveAll}"/>
                    <Separator/>
                    <MenuItem Header="{loc:T Menu.File.Quit}" Command="{Binding ExitCommand}" InputGestureText="{loc:T Shortcut.Quit}"/>
                </MenuItem>
                <MenuItem Header="{loc:T Menu.View}">
                    <MenuItem Header="{loc:T Menu.View.Sidebar}" Click="ToggleSidebar_Click" InputGestureText="{loc:T Shortcut.Sidebar}"/>
                    <MenuItem Header="{loc:T Menu.View.Theme}" Command="{Binding ToggleThemeCommand}" InputGestureText="{loc:T Shortcut.Theme}"/>
                    <MenuItem Header="{loc:T Menu.View.Language}">
                        <MenuItem x:Name="LangGerman" Header="{loc:T Menu.View.Language.German}"
                                  IsCheckable="True" Click="Language_Click" Tag="de"/>
                        <MenuItem x:Name="LangEnglish" Header="{loc:T Menu.View.Language.English}"
                                  IsCheckable="True" Click="Language_Click" Tag="en"/>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{loc:T Menu.Help}">
                    <MenuItem Header="{loc:T Menu.Help.About}" Click="About_Click"/>
                </MenuItem>
            </Menu>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarCol" Width="260" MinWidth="180" MaxWidth="450"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Seitenleiste ===== -->
            <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource Brush.SidebarBg}">
                <DockPanel Margin="10,10,6,10">

                    <!-- App-Titel -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,10">
                        <Image Source="/Assets/gonk-note-Icon.png" Width="22" Height="22"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <TextBlock Text="Gonk Note" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0"
                                   Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Schnellzugriff: Neu -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,8">
                        <Button Style="{StaticResource IconButton}" Content="&#xE8F4;" ToolTip="{loc:T New.Folder}"
                                Command="{Binding NewFolderCommand}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE82D;" ToolTip="{loc:T New.Notebook}"
                                Command="{Binding NewNotebookCommand}"/>
                        <Button Style="{StaticResource IconButton}" ToolTip="{loc:T New.Whiteboard}"
                                Command="{Binding NewWhiteboardCommand}">
                            <Path Data="{StaticResource Icon.Whiteboard}" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="16" Height="16"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8A5;" ToolTip="{loc:T New.Text}"
                                Command="{Binding NewTextDocCommand}"/>
                    </StackPanel>

                    <!-- Schnellzugriff: angepinnte Ordner -->
                    <StackPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PinnedFolders.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{loc:T Sidebar.Pinned}" FontSize="10" FontWeight="SemiBold" Margin="6,2,0,5"
                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                        <!-- Icon-Kachel-Raster (angelehnt an Zen-Browser-Pinned-Tabs) -->
                        <ItemsControl ItemsSource="{Binding PinnedFolders}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="46" Height="46" Margin="3" Cursor="Hand"
                                            Command="{Binding DataContext.OpenPinnedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Name}"
                                            ToolTipService.InitialShowDelay="250"
                                            ToolTipService.ShowDuration="8000"
                                            ToolTipService.Placement="Bottom">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="tile" CornerRadius="11"
                                                        Background="{DynamicResource Brush.CardBg}"
                                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                    <Grid>
                                                        <TextBlock Text="{Binding IconGlyph}" FontFamily="{StaticResource IconFont}"
                                                                   FontSize="21" Foreground="{Binding IconBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Text="&#xE840;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,4,0"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="tile" Property="BorderBrush"
                                                                Value="{DynamicResource Brush.Accent}"/>
                                                        <Setter TargetName="tile" Property="BorderThickness" Value="1.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="4,8,4,0"/>
                    </StackPanel>

                    <!-- Fußzeile -->
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource FlatButton}"
                            HorizontalAlignment="Left" Margin="2,8,0,0"
                            Command="{Binding ToggleThemeCommand}" ToolTip="{loc:T Sidebar.ThemeTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE793;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:T Sidebar.SwitchTheme}" Margin="8,0,0,0"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                    </Button>

                    <!-- Ordnerbaum -->
                    <TreeView x:Name="Tree" ItemsSource="{Binding RootItems}"
                              AllowDrop="True"
                              SelectedItemChanged="Tree_SelectedItemChanged"
                              MouseDoubleClick="Tree_MouseDoubleClick"
                              PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="Tree_PreviewMouseLeftButtonUp"
                              PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                              MouseMove="Tree_MouseMove"
                              Drop="Tree_Drop" DragOver="Tree_DragOver"
                              KeyDown="Tree_KeyDown"
                              VirtualizingPanel.IsVirtualizing="False">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:T New.Folder}" Command="{Binding NewFolderCommand}"
                                          CommandParameter="{Binding SelectedTreeItem}"/>
                                <MenuItem Header="{loc:T New.Notebook}" Command="{Binding NewNotebookCommand}"
                                          CommandParameter="{Binding SelectedTreeItem}"/>
                                <MenuItem Header="{loc:T New.Whiteboard}" Command="{Binding NewWhiteboardCommand}"
                                          CommandParameter="{Binding SelectedTreeItem}"/>
                                <MenuItem Header="{loc:T New.Text}" Command="{Binding NewTextDocCommand}"
                                          CommandParameter="{Binding SelectedTreeItem}"/>
                                <Separator/>
                                <MenuItem Header="{loc:T Tree.Open}" Command="{Binding OpenItemCommand}"
                                          CommandParameter="{Binding SelectedTreeItem}"/>
                                <MenuItem Header="{loc:T Tree.Rename}" InputGestureText="{loc:T Shortcut.Rename}"
                                          Command="{Binding RenameCommand}"
                                          CommandParameter="{Binding SelectedTreeItem}"/>
                                <MenuItem Header="{Binding SelectedTreeItem.PinMenuHeader}"
                                          Command="{Binding TogglePinCommand}"
                                          CommandParameter="{Binding SelectedTreeItem}"
                                          Visibility="{Binding SelectedTreeItem.IsFolder,
                                                       Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE840;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   Foreground="{DynamicResource Brush.TextMuted}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{Binding SelectedTreeItem.FavoriteMenuHeader}"
                                          Command="{Binding ToggleFavoriteCommand}"
                                          CommandParameter="{Binding SelectedTreeItem}"
                                          Visibility="{Binding SelectedTreeItem.IsFolder,
                                                       Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   Foreground="#EAB308"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:T Tree.IconColor}">
                                    <MenuItem Header="{loc:T Tree.IconColor.Auto}" Click="IconColor_Click" Tag=""
                                              ToolTip="{loc:T Tree.IconColor.AutoTooltip}">
                                        <MenuItem.Icon>
                                            <Ellipse Width="12" Height="12" Fill="{DynamicResource Brush.Turquoise}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="{loc:T Color.Blue}" Click="IconColor_Click" Tag="#2563EB">
                                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#2563EB"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:T Color.Teal}" Click="IconColor_Click" Tag="#14B8A6">
                                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#14B8A6"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:T Color.Pink}" Click="IconColor_Click" Tag="#EC4899">
                                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#EC4899"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:T Color.Purple}" Click="IconColor_Click" Tag="#8B5CF6">
                                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#8B5CF6"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:T Color.Red}" Click="IconColor_Click" Tag="#EF4444">
                                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#EF4444"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:T Color.Orange}" Click="IconColor_Click" Tag="#F97316">
                                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#F97316"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:T Color.Yellow}" Click="IconColor_Click" Tag="#EAB308">
                                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#EAB308"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:T Color.Green}" Click="IconColor_Click" Tag="#22C55E">
                                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#22C55E"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:T Color.Gray}" Click="IconColor_Click" Tag="#94A3B8">
                                        <MenuItem.Icon><Ellipse Width="12" Height="12" Fill="#94A3B8"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="{loc:T Tree.IconColor.Custom}" Click="IconColorCustom_Click"/>
                                </MenuItem>
                                <MenuItem Header="{loc:T Tree.Delete}" InputGestureText="{loc:T Shortcut.Delete}"
                                          Command="{Binding DeleteCommand}"
                                          CommandParameter="{Binding SelectedTreeItem}"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:TreeItemViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <Grid VerticalAlignment="Center" Width="16" Height="16">
                                        <TextBlock x:Name="glyphIcon" Text="{Binding IconGlyph}"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Foreground="{Binding IconBrush}"/>
                                        <Path x:Name="boardIcon" Data="{StaticResource Icon.Whiteboard}"
                                              Stroke="{Binding IconBrush}" StrokeThickness="1.3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Visibility="Collapsed"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" Margin="8,0,4,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Text}"
                                               Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}"/>
                                    <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Margin="2,0,0,0" VerticalAlignment="Center" Foreground="#EAB308"
                                               ToolTip="{loc:T Tree.Favorite}" Visibility="{Binding FavoriteVisibility}"/>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="6,0,4,0" MinWidth="110" Padding="2,1"
                                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                             IsVisibleChanged="RenameBox_IsVisibleChanged"
                                             LostKeyboardFocus="RenameBox_LostFocus"
                                             KeyDown="RenameBox_KeyDown"/>
                                </StackPanel>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Whiteboard">
                                        <Setter TargetName="glyphIcon" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="boardIcon" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <!-- ===== Arbeitsbereich ===== -->
            <Grid Grid.Column="2">

                <!-- „Big Picture"-Galerie: Inhalt des aktuellen Ordners, wenn kein Dokument offen ist -->
                <Grid Background="{DynamicResource Brush.WindowBg}"
                      Visibility="{Binding OpenTabs.Count, Converter={StaticResource ZeroToVis}}">
                    <DockPanel Margin="28,18,20,0">

                        <!-- Kopf: Breadcrumb, Zurück + Titel, „Neu" -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,8,14">
                            <StackPanel HorizontalAlignment="Left">
                                <ItemsControl ItemsSource="{Binding Breadcrumb}" Margin="0,0,0,2"
                                              Visibility="{Binding ShowBreadcrumb, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{Binding Label}" Style="{StaticResource FlatButton}"
                                                        Padding="2,0" Foreground="{DynamicResource Brush.TextMuted}"
                                                        Command="{Binding DataContext.GalleryNavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Folder}"/>
                                                <TextBlock Text="&#160;›&#160;" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE72B;" FontSize="18"
                                            ToolTip="{loc:T Gallery.Back}" Margin="0,0,6,0" VerticalAlignment="Center"
                                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding GalleryBackCommand}"/>
                                    <TextBlock Text="{Binding GalleryTitle}" FontSize="26" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="GalleryNew_Click"
                                    Style="{StaticResource FlatButton}" Padding="14,7"
                                    Background="{DynamicResource Brush.Accent}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:T Gallery.New}" Margin="7,0,2,0" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                               Foreground="White" VerticalAlignment="Center" Margin="4,1,0,0"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:T New.Folder}" Command="{Binding NewFolderCommand}" CommandParameter="{Binding GalleryFolder}"/>
                                        <MenuItem Header="{loc:T New.Notebook}" Command="{Binding NewNotebookCommand}" CommandParameter="{Binding GalleryFolder}"/>
                                        <MenuItem Header="{loc:T New.Whiteboard}" Command="{Binding NewWhiteboardCommand}" CommandParameter="{Binding GalleryFolder}"/>
                                        <MenuItem Header="{loc:T New.Text}" Command="{Binding NewTextDocCommand}" CommandParameter="{Binding GalleryFolder}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>

                        <!-- Leerer Ordner -->
                        <StackPanel DockPanel.Dock="Top" Margin="2,30,0,0" HorizontalAlignment="Center"
                                    Visibility="{Binding GalleryItems.Count, Converter={StaticResource ZeroToVis}}">
                            <Image Source="/Assets/gonk-note-Icon.png" Width="56" Height="56"
                                   RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" Opacity="0.7"/>
                            <TextBlock Text="{loc:T Gallery.Empty.Title}" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,4"
                                       Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:T Gallery.Empty.Hint}"
                                       Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Kachelraster -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding GalleryItems}" Margin="0,0,0,24">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GalleryItemViewModel}">
                                        <Button Width="168" Margin="8,8,8,4" Cursor="Hand"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.GalleryOpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                MouseRightButtonUp="GalleryTile_RightClick">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="tileBg" Background="Transparent" CornerRadius="10" Padding="6">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="tileBg" Property="Background" Value="#18808080"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel>
                                                <!-- Vorschau -->
                                                <Grid Height="152" Margin="0,4,0,10">
                                                    <!-- Ordner: großes farbiges Symbol -->
                                                    <Viewbox Width="118" Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding IconGlyph}" FontFamily="{StaticResource IconFont}"
                                                                   Foreground="{Binding IconBrush}">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                    </Viewbox>
                                                    <!-- Notizbuch: Cover-Vorschau -->
                                                    <Border Visibility="{Binding IsNotebook, Converter={StaticResource BoolToVis}}"
                                                            Width="112" Height="150" CornerRadius="8" ClipToBounds="True"
                                                            Background="{Binding CoverBrush}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.35" Color="Black"/>
                                                        </Border.Effect>
                                                        <Grid>
                                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                                                   Visibility="{Binding HasCoverImage, Converter={StaticResource BoolToVis}}"/>
                                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" TextAlignment="Center" Margin="10"
                                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                       Visibility="{Binding HasCoverImage, Converter={StaticResource InverseBoolToVis}}"/>
                                                        </Grid>
                                                    </Border>
                                                    <!-- Whiteboard: helle Karte mit Punktraster -->
                                                    <Border Visibility="{Binding IsWhiteboard, Converter={StaticResource BoolToVis}}"
                                                            Width="150" Height="112" CornerRadius="8" ClipToBounds="True"
                                                            Background="White" BorderBrush="#22000000" BorderThickness="1"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.3" Color="Black"/>
                                                        </Border.Effect>
                                                        <Rectangle>
                                                            <Rectangle.Fill>
                                                                <DrawingBrush TileMode="Tile" Viewport="0,0,15,15" ViewportUnits="Absolute" Stretch="None">
                                                                    <DrawingBrush.Drawing>
                                                                        <GeometryDrawing Brush="#22000000">
                                                                            <GeometryDrawing.Geometry>
                                                                                <EllipseGeometry Center="2,2" RadiusX="1.1" RadiusY="1.1"/>
                                                                            </GeometryDrawing.Geometry>
                                                                        </GeometryDrawing>
                                                                    </DrawingBrush.Drawing>
                                                                </DrawingBrush>
                                                            </Rectangle.Fill>
                                                        </Rectangle>
                                                    </Border>
                                                    <!-- Textdokument: Blatt mit angedeuteten Zeilen -->
                                                    <Border Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}"
                                                            Width="112" Height="150" CornerRadius="4"
                                                            Background="White" BorderBrush="#22000000" BorderThickness="1"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.3" Color="Black"/>
                                                        </Border.Effect>
                                                        <StackPanel Margin="12,14">
                                                            <TextBlock Text="{Binding Name}" FontSize="9" FontWeight="SemiBold"
                                                                       Foreground="#333" TextTrimming="CharacterEllipsis"/>
                                                            <Rectangle Height="2" Fill="#E5E5E5" Margin="0,9,0,0"/>
                                                            <Rectangle Height="2" Fill="#E5E5E5" Margin="0,6,0,0"/>
                                                            <Rectangle Height="2" Fill="#E5E5E5" Margin="0,6,8,0"/>
                                                            <Rectangle Height="2" Fill="#E5E5E5" Margin="0,6,0,0"/>
                                                            <Rectangle Height="2" Fill="#E5E5E5" Margin="0,6,14,0"/>
                                                            <Rectangle Height="2" Fill="#E5E5E5" Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- Favoritenstern -->
                                                    <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                               Foreground="#EAB308" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                               Margin="0,2,6,0" Visibility="{Binding StarVisibility}">
                                                        <TextBlock.Effect>
                                                            <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.6" Color="Black"/>
                                                        </TextBlock.Effect>
                                                    </TextBlock>
                                                </Grid>
                                                <!-- Name + Chevron -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text}"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               MaxWidth="128" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="9"
                                                            Width="18" Height="18" Margin="3,0,0,0" ToolTip="{loc:T Gallery.Options}"
                                                            Click="GalleryChevron_Click"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource Brush.TextMuted}"
                                                           FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <TabControl ItemsSource="{Binding OpenTabs}" SelectedItem="{Binding SelectedTab}">
                    <TabControl.Style>
                        <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OpenTabs.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TabControl.Style>
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TabHeader}" VerticalAlignment="Center" MaxWidth="180"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="9"
                                        Width="20" Height="20" Margin="8,0,0,0" ToolTip="{loc:T Window.CloseTab}"
                                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>

    <!-- Einblendbare Titelleiste: nur im maximierten Fenster (dort ist die native Leiste aus).
         Gleitet bei Mauskontakt am oberen Rand animiert herein (siehe Root_MouseMove). -->
    <Border x:Name="AutoTitleBar" VerticalAlignment="Top" Height="34" Panel.ZIndex="50"
            Background="{DynamicResource Brush.SidebarBg}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
            Visibility="Collapsed" MouseLeftButtonDown="AutoTitleBar_MouseLeftButtonDown">
        <Border.RenderTransform>
            <TranslateTransform x:Name="AutoTitleBarTransform" Y="-40"/>
        </Border.RenderTransform>
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                        ToolTip="{loc:T Window.Minimize}" Click="Caption_Minimize"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE923;"
                        ToolTip="{loc:T Window.Restore}" Click="Caption_Restore"/>
                <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                        ToolTip="{loc:T Window.Close}" Click="Caption_Close"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <Image Source="/Assets/gonk-note-Icon.png" Width="16" Height="16"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Gonk Note" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
            </StackPanel>
        </DockPanel>
    </Border>
    </Grid>
</Window>
