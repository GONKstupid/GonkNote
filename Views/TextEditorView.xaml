<UserControl x:Class="GonkNote.Views.TextEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PathIcon" TargetType="Path">
            <Setter Property="StrokeThickness" Value="1.3"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- ===== Formatierungsleiste (2 Zeilen, OnlyOffice-Kompaktstil) ===== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.ToolbarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="8,4">
            <StackPanel>

                <!-- Zeile 1: Verlauf, Schrift, Größe, Styles -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" ToolTip="Rückgängig (Strg+Z)"
                            Click="Undo_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE7A6;" ToolTip="Wiederholen (Strg+Y)"
                            Click="Redo_Click"/>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <ComboBox x:Name="StyleCombo" Width="118" SelectionChanged="StyleCombo_Changed"
                              ToolTip="Absatzformat">
                        <ComboBoxItem Content="Standard" IsSelected="True"/>
                        <ComboBoxItem Content="Überschrift 1"/>
                        <ComboBoxItem Content="Überschrift 2"/>
                        <ComboBoxItem Content="Überschrift 3"/>
                    </ComboBox>

                    <ComboBox x:Name="FontCombo" Width="150" Margin="6,0,0,0" SelectionChanged="FontCombo_Changed"
                              ToolTip="Schriftart"/>
                    <ComboBox x:Name="SizeCombo" Width="58" Margin="6,0,0,0" SelectionChanged="SizeCombo_Changed"
                              ToolTip="Schriftgröße"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8E8;" ToolTip="Schrift vergrößern"
                            Command="EditingCommands.IncreaseFontSize" CommandTarget="{Binding ElementName=Editor}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8E7;" ToolTip="Schrift verkleinern"
                            Command="EditingCommands.DecreaseFontSize" CommandTarget="{Binding ElementName=Editor}"/>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <Button Style="{StaticResource IconButton}" ToolTip="Formatierung löschen" Click="ClearFormat_Click">
                        <TextBlock FontFamily="Segoe UI" FontSize="12">
                            <Run Text="A"/><Run Text="a" FontSize="9"/><Run Text="✕" FontSize="8"/>
                        </TextBlock>
                    </Button>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <Button Style="{StaticResource IconButton}" Content="&#xE721;" ToolTip="Suchen &amp; Ersetzen (Strg+F)"
                            Click="ToggleFind_Click"/>
                </StackPanel>

                <!-- Zeile 2: Zeichen- und Absatzformate, Einfügen -->
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="BtnBold" Style="{StaticResource ToolButton}" FontFamily="Segoe UI"
                                  Click="Bold_Click" ToolTip="Fett (Strg+B)">
                        <TextBlock Text="F" FontWeight="Bold" FontFamily="Segoe UI"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnItalic" Style="{StaticResource ToolButton}" FontFamily="Segoe UI"
                                  Click="Italic_Click" ToolTip="Kursiv (Strg+I)">
                        <TextBlock Text="K" FontStyle="Italic" FontFamily="Segoe UI"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnUnderline" Style="{StaticResource ToolButton}" FontFamily="Segoe UI"
                                  Click="Underline_Click" ToolTip="Unterstrichen (Strg+U)">
                        <TextBlock Text="U" TextDecorations="Underline" FontFamily="Segoe UI"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnStrike" Style="{StaticResource ToolButton}" FontFamily="Segoe UI"
                                  Click="Strike_Click" ToolTip="Durchgestrichen">
                        <TextBlock Text="S" TextDecorations="Strikethrough" FontFamily="Segoe UI"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnSub" Style="{StaticResource ToolButton}" FontFamily="Segoe UI"
                                  Content="x₂" Click="Sub_Click" ToolTip="Tiefgestellt"/>
                    <ToggleButton x:Name="BtnSuper" Style="{StaticResource ToolButton}" FontFamily="Segoe UI"
                                  Content="x²" Click="Super_Click" ToolTip="Hochgestellt"/>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <!-- Textfarbe / Marker -->
                    <Button Style="{StaticResource IconButton}" Click="ApplyTextColor_Click" ToolTip="Textfarbe anwenden">
                        <StackPanel>
                            <TextBlock Text="A" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13"
                                       HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                            <Rectangle x:Name="TextColorBar" Height="3" Width="14" Fill="#EC4899" RadiusX="1" RadiusY="1"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="8"
                            ToolTip="Textfarbe wählen" Width="18" Click="PickTextColor_Click"/>
                    <Button Style="{StaticResource IconButton}" Click="ApplyHighlight_Click" ToolTip="Textmarker anwenden">
                        <StackPanel>
                            <TextBlock Text="&#xE7E6;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       HorizontalAlignment="Center"/>
                            <Rectangle x:Name="HighlightBar" Height="3" Width="14" Fill="#FDE047" RadiusX="1" RadiusY="1"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="8"
                            ToolTip="Markerfarbe wählen (inkl. „keine“)" Width="18" Click="PickHighlight_Click"/>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <!-- Ausrichtung -->
                    <ToggleButton x:Name="BtnAlignLeft" Style="{StaticResource ToolButton}" Content="&#xE8E4;"
                                  Click="Align_Click" Tag="Left" ToolTip="Linksbündig"/>
                    <ToggleButton x:Name="BtnAlignCenter" Style="{StaticResource ToolButton}" Content="&#xE8E3;"
                                  Click="Align_Click" Tag="Center" ToolTip="Zentriert"/>
                    <ToggleButton x:Name="BtnAlignRight" Style="{StaticResource ToolButton}" Content="&#xE8E2;"
                                  Click="Align_Click" Tag="Right" ToolTip="Rechtsbündig"/>
                    <ToggleButton x:Name="BtnAlignJustify" Style="{StaticResource ToolButton}"
                                  Click="Align_Click" Tag="Justify" ToolTip="Blocksatz">
                        <Path Style="{StaticResource PathIcon}" Data="{StaticResource Icon.Justify}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <!-- Listen & Einzug -->
                    <Button Style="{StaticResource IconButton}" Content="&#xE8FD;" ToolTip="Aufzählung"
                            Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=Editor}"/>
                    <Button Style="{StaticResource IconButton}" FontFamily="Segoe UI" Content="№"
                            ToolTip="Nummerierte Liste"
                            Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=Editor}"/>
                    <Button Style="{StaticResource IconButton}" ToolTip="Einzug vergrößern"
                            Command="EditingCommands.IncreaseIndentation" CommandTarget="{Binding ElementName=Editor}">
                        <Path Style="{StaticResource PathIcon}" Data="{StaticResource Icon.IndentInc}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Einzug verkleinern"
                            Command="EditingCommands.DecreaseIndentation" CommandTarget="{Binding ElementName=Editor}">
                        <Path Style="{StaticResource PathIcon}" Data="{StaticResource Icon.IndentDec}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>

                    <!-- Zeilenabstand -->
                    <ComboBox x:Name="SpacingCombo" Width="62" Margin="6,0,0,0" SelectionChanged="Spacing_Changed"
                              ToolTip="Zeilenabstand">
                        <ComboBoxItem Content="1,0" Tag="1.0" IsSelected="True"/>
                        <ComboBoxItem Content="1,15" Tag="1.15"/>
                        <ComboBoxItem Content="1,5" Tag="1.5"/>
                        <ComboBoxItem Content="2,0" Tag="2.0"/>
                    </ComboBox>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <!-- Einfügen -->
                    <Button Style="{StaticResource IconButton}" Content="&#xE8B9;" ToolTip="Bild einfügen"
                            Click="InsertImage_Click"/>
                    <Button Style="{StaticResource IconButton}" ToolTip="Tabelle einfügen" Click="InsertTable_Click">
                        <Path Style="{StaticResource PathIcon}" Data="{StaticResource Icon.Table}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" FontFamily="Segoe UI" Content="—"
                            ToolTip="Trennlinie einfügen" Click="InsertRule_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Suchen & Ersetzen ===== -->
        <Border x:Name="FindPanel" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="{DynamicResource Brush.SidebarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="FindBox" Width="180" KeyDown="FindBox_KeyDown" ToolTip="Suchbegriff"/>
                <Button Style="{StaticResource FlatButton}" Content="Weiter" Margin="6,0,0,0" Click="FindNext_Click"/>
                <TextBox x:Name="ReplaceBox" Width="180" Margin="12,0,0,0" ToolTip="Ersetzen durch"/>
                <Button Style="{StaticResource FlatButton}" Content="Ersetzen" Margin="6,0,0,0" Click="ReplaceOne_Click"/>
                <Button Style="{StaticResource FlatButton}" Content="Alle ersetzen" Margin="2,0,0,0" Click="ReplaceAll_Click"/>
                <TextBlock x:Name="FindStatus" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Margin="6,0,0,0"
                        ToolTip="Schließen (Esc)" Click="CloseFind_Click"/>
            </StackPanel>
        </Border>

        <!-- ===== Schreibfläche ===== -->
        <Grid Background="{DynamicResource Brush.WindowBg}">
            <Border MaxWidth="900" Margin="24" CornerRadius="10"
                    Background="{DynamicResource Brush.CardBg}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <RichTextBox x:Name="Editor"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource Brush.Text}"
                             CaretBrush="{DynamicResource Brush.Accent}"
                             SelectionBrush="{DynamicResource Brush.Selection}"
                             FontFamily="Segoe UI" FontSize="15"
                             Padding="28,24"
                             VerticalScrollBarVisibility="Auto"
                             AcceptsTab="True"
                             SpellCheck.IsEnabled="False"
                             TextChanged="Editor_TextChanged"
                             SelectionChanged="Editor_SelectionChanged"
                             PreviewKeyDown="Editor_PreviewKeyDown"/>
            </Border>
        </Grid>

    </DockPanel>
</UserControl>
