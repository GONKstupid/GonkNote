<Application x:Class="GonkNote.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] füllt WpfThemeHost zur Laufzeit aus der Farbtabelle in Core.
                     Bis zum 2026-09-10 stand hier `Themes/Light.xaml`; die Datei ist
                     gelöscht, weil dieselben zwanzig Farben sonst zweimal im Baum stünden
                     (einmal hier, einmal in Core für den Linux-Kopf). Der Platzhalter bleibt
                     leer und wird noch im Start ersetzt — **vor dem ersten Fenster**, siehe
                     App.xaml.cs. -->
                <ResourceDictionary/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
