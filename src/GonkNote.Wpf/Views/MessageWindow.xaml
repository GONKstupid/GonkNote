<Window x:Class="GonkNote.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gonk Note"
        SizeToContent="WidthAndHeight"
        MinWidth="340" MaxWidth="560"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.WindowBg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Ui}" FontSize="13">

    <!-- Das Gegenstueck zu Views/MessageWindow.axaml des Linux-Kopfs (HANDOFF §4.75).

         **Warum es das jetzt auch hier gibt:** Dieser Kopf zeigte seine Meldungen ueber die
         native `MessageBox` — an 28 Aufrufstellen. Die traegt die Systemfarben, die
         Systemschrift und das Systemsymbol und sah damit an keiner Stelle aus wie die App,
         waehrend der Linux-Kopf ein eigenes, gestaltetes Fenster hat. **Jede Fehlermeldung
         und jede Rueckfrage war ein sichtbarer Unterschied**, und der Linux-Kopf ist die
         Vorlage.

         Aufbau, Masse, Farben und Knopfreihenfolge sind aus dem Linux-Kopf uebernommen. -->

    <StackPanel Margin="22,20,22,16">

        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <!-- Der Punkt traegt die Schwere: blau = Mitteilung, pink = Warnung,
                 tuerkis = Frage. Bewusst kein Symbol — drueben gibt es keine Icon-Schrift,
                 und zwei Gestalten desselben Hinweises waeren einer zu viel. -->
            <Ellipse x:Name="SchwereZeichen" Width="12" Height="12"
                     VerticalAlignment="Top" Margin="0,4,14,0"/>
            <TextBlock x:Name="Nachricht" TextWrapping="Wrap" MaxWidth="440"
                       Foreground="{DynamicResource Brush.Text}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- Reihenfolge wie bei der Windows-MessageBox: die bestaetigende Antwort links,
                 die abweisende rechts. Bei einer Mitteilung ist NeinKnopf ausgeblendet. -->
            <Button x:Name="JaKnopf" Style="{StaticResource AccentButton}" MinWidth="88"
                    Padding="14,7" IsDefault="True" Click="Ja_Click"/>
            <Button x:Name="NeinKnopf" Style="{StaticResource FlatButton}" MinWidth="88"
                    Padding="14,7" Margin="8,0,0,0" IsCancel="True" Click="Nein_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
