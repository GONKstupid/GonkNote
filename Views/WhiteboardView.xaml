<UserControl x:Class="GonkNote.Views.WhiteboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             Focusable="True">
    <DockPanel>

        <!-- ===== Werkzeugleiste ===== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.ToolbarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="8,4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">

                    <!-- Stifte -->
                    <ToggleButton x:Name="BtnPen" Style="{StaticResource ToolButton}" Content="&#xE70F;"
                                  ToolTip="Stift (S)" Checked="Tool_Checked" Tag="Pen"/>
                    <ToggleButton x:Name="BtnPencil" Style="{StaticResource ToolButton}" Content="&#xE76D;"
                                  ToolTip="Bleistift (B)" Checked="Tool_Checked" Tag="Pencil"/>
                    <ToggleButton x:Name="BtnHighlighter" Style="{StaticResource ToolButton}" Content="&#xE7E6;"
                                  ToolTip="Textmarker (M)" Checked="Tool_Checked" Tag="Highlighter"/>
                    <ToggleButton x:Name="BtnEraser" Style="{StaticResource ToolButton}" Content="&#xE75C;"
                                  ToolTip="Radiergummi (E)" Checked="Tool_Checked" Tag="Eraser"/>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <ToggleButton x:Name="BtnLasso" Style="{StaticResource ToolButton}" Content="&#xE8B3;"
                                  ToolTip="Lasso-Auswahl (L)" Checked="Tool_Checked" Tag="Lasso"/>
                    <ToggleButton x:Name="BtnText" Style="{StaticResource ToolButton}" Content="&#xE8D2;"
                                  ToolTip="Textfeld (T)" Checked="Tool_Checked" Tag="Text"/>
                    <ToggleButton x:Name="BtnShape" Style="{StaticResource ToolButton}" Content="&#xE739;"
                                  ToolTip="Formen (F)" Checked="Tool_Checked" Tag="Shape"/>
                    <ToggleButton x:Name="BtnPan" Style="{StaticResource ToolButton}" Content="&#xE7C9;"
                                  ToolTip="Verschieben (H) – oder mittlere Maustaste" Checked="Tool_Checked" Tag="Pan"/>

                    <!-- Formauswahl (nur bei Formen-Werkzeug sichtbar) -->
                    <StackPanel x:Name="ShapePicker" Orientation="Horizontal" Visibility="Collapsed">
                        <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>
                        <ToggleButton x:Name="BtnShapeLine" Style="{StaticResource ToolButton}" FontFamily="Segoe UI"
                                      Content="╱" ToolTip="Linie" Checked="Shape_Checked" Tag="Line"/>
                        <ToggleButton x:Name="BtnShapeArrow" Style="{StaticResource ToolButton}" FontFamily="Segoe UI"
                                      Content="→" ToolTip="Pfeil" Checked="Shape_Checked" Tag="Arrow"/>
                        <ToggleButton x:Name="BtnShapeRect" Style="{StaticResource ToolButton}" FontFamily="Segoe UI"
                                      Content="▭" ToolTip="Rechteck" Checked="Shape_Checked" Tag="Rectangle"/>
                        <ToggleButton x:Name="BtnShapeEllipse" Style="{StaticResource ToolButton}" FontFamily="Segoe UI"
                                      Content="◯" ToolTip="Ellipse" Checked="Shape_Checked" Tag="Ellipse"/>
                        <ToggleButton x:Name="BtnShapeTriangle" Style="{StaticResource ToolButton}" FontFamily="Segoe UI"
                                      Content="△" ToolTip="Dreieck" Checked="Shape_Checked" Tag="Triangle"/>
                    </StackPanel>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <!-- Farben -->
                    <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="ink" IsChecked="True"
                                     Background="{DynamicResource Brush.Text}" Tag="auto"
                                     ToolTip="Standard" Checked="Color_Checked"/>
                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="ink"
                                     Background="#2563EB" Tag="#FF2563EB" ToolTip="Blau" Checked="Color_Checked"/>
                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="ink"
                                     Background="#14B8A6" Tag="#FF14B8A6" ToolTip="Türkis" Checked="Color_Checked"/>
                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="ink"
                                     Background="#EC4899" Tag="#FFEC4899" ToolTip="Pink" Checked="Color_Checked"/>
                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="ink"
                                     Background="#8B5CF6" Tag="#FF8B5CF6" ToolTip="Lila" Checked="Color_Checked"/>
                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="ink"
                                     Background="#EF4444" Tag="#FFEF4444" ToolTip="Rot" Checked="Color_Checked"/>
                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="ink"
                                     Background="#EAB308" Tag="#FFEAB308" ToolTip="Gelb" Checked="Color_Checked"/>
                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="ink"
                                     Background="#22C55E" Tag="#FF22C55E" ToolTip="Grün" Checked="Color_Checked"/>
                    </StackPanel>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <!-- Strichstärke -->
                    <TextBlock Text="&#xE76D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="2,0"/>
                    <Slider x:Name="WidthSlider" Width="90" Minimum="1" Maximum="20" Value="2.5"
                            VerticalAlignment="Center" ValueChanged="WidthSlider_ValueChanged"/>
                    <TextBlock x:Name="WidthLabel" Text="2,5" Width="26" VerticalAlignment="Center" Margin="4,0,0,0"
                               Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <!-- Undo / Redo -->
                    <Button x:Name="BtnUndo" Style="{StaticResource IconButton}" Content="&#xE7A7;"
                            ToolTip="Rückgängig (Strg+Z)" Click="Undo_Click" IsEnabled="False"/>
                    <Button x:Name="BtnRedo" Style="{StaticResource IconButton}" Content="&#xE7A6;"
                            ToolTip="Wiederholen (Strg+Y)" Click="Redo_Click" IsEnabled="False"/>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <!-- Zoom -->
                    <Button Style="{StaticResource IconButton}" Content="&#xE71F;" ToolTip="Verkleinern"
                            Click="ZoomOut_Click"/>
                    <Button x:Name="ZoomLabel" Style="{StaticResource FlatButton}" Content="100 %"
                            ToolTip="Zoom zurücksetzen" Click="ZoomReset_Click" MinWidth="52"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" ToolTip="Vergrößern"
                            Click="ZoomIn_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===== Seitenleiste unten (nur Notizbücher) ===== -->
        <Border x:Name="PageBar" DockPanel.Dock="Bottom" Background="{DynamicResource Brush.ToolbarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="8,3" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Vorherige Seite"
                        Click="PrevPage_Click"/>
                <TextBlock x:Name="PageLabel" Text="Seite 1 / 1" VerticalAlignment="Center" Margin="10,0"
                           Foreground="{DynamicResource Brush.Text}"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="Nächste Seite"
                        Click="NextPage_Click"/>
                <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="8,4"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="Neue Seite"
                        Click="AddPage_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Seite löschen"
                        Click="DeletePage_Click"/>
            </StackPanel>
        </Border>

        <!-- ===== Zeichenfläche ===== -->
        <Grid x:Name="CanvasHost" Background="Transparent" ClipToBounds="True">
            <skia:SKElement x:Name="Skia" PaintSurface="Skia_PaintSurface"/>
            <Canvas x:Name="Overlay" Background="{x:Null}">
                <TextBox x:Name="EditBox" Visibility="Collapsed" AcceptsReturn="True"
                         MinWidth="60" FontFamily="Segoe UI" BorderThickness="1"
                         LostKeyboardFocus="EditBox_LostFocus" PreviewKeyDown="EditBox_KeyDown"/>
            </Canvas>
        </Grid>

    </DockPanel>
</UserControl>
