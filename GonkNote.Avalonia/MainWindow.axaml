<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GonkNote.Avalonia"
        x:Class="GonkNote.Avalonia.MainWindow"
        Width="960" Height="660"
        Title="Gonk Note — Avalonia-Port (Linux-ready)">
    <Window.Styles>
        <!-- Galerie-Kachel: flache Karte statt Standard-Button-Chrome -->
        <Style Selector="Button.tile">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.tile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22808080"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <!-- Breadcrumb-Segment: wie ein Link, ohne Button-Chrome -->
        <Style Selector="Button.crumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>
        <Style Selector="Button.crumb:pointerover">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- Aktives Werkzeug in der Whiteboard-Leiste -->
        <Style Selector="Button.active">
            <Setter Property="Background" Value="#5B21B6"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- Farbkachel der Stift-Werkzeugleiste -->
        <Style Selector="Button.ink">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Styles>
    <DockPanel>

        <!-- Kopfleiste -->
        <Border DockPanel.Dock="Top" Background="#22808080" Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Name="NewButton" Content="＋ Neu" Padding="10,5">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Ordner"        Click="New_Click" Tag="Folder"/>
                                <MenuItem Header="Notizbuch"     Click="New_Click" Tag="Notebook"/>
                                <MenuItem Header="Whiteboard"    Click="New_Click" Tag="Whiteboard"/>
                                <MenuItem Header="Textdokument"  Click="New_Click" Tag="TextDocument"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Name="ThemeToggle" Content="🌓 Theme" Padding="10,5"/>
                    <Button Name="OpenEditor" Content="Editor-Prototyp →" Padding="10,5"/>
                    <Button Name="OpenProbe" Content="Render-Probe" Padding="10,5"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Gonk Note — Avalonia-Port" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Opacity="0.7" FontSize="12"
                               Text="Shell (Schritt 3a): Ordnerbaum aus der echten LiteDB, Farbvererbung, Navigation, Theme."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Linkes Panel: Ordnerbaum -->
        <Border DockPanel.Dock="Left" Width="300" BorderBrush="#33808080" BorderThickness="0,0,1,0" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Dokumente" FontWeight="SemiBold"
                           Margin="4,2,0,8" Opacity="0.8"/>
                <TreeView Name="Tree" ItemsSource="{Binding Roots}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Umbenennen" Click="Ctx_Rename_Click"/>
                                        <MenuItem Header="{Binding FavoriteMenuHeader}" Click="Ctx_Favorite_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Löschen" Click="Ctx_Delete_Click"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                                         Fill="{Binding IconBrush}"/>
                                <TextBlock Text="{Binding Glyph}" FontSize="14" VerticalAlignment="Center"/>
                                <!-- Anzeige bzw. Inline-Umbenennung (Doppelklick startet sie) -->
                                <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"
                                           IsVisible="{Binding IsNotRenaming}"/>
                                <TextBlock Text="{Binding FavoriteMark}" Foreground="#F5C542"
                                           FontSize="13" VerticalAlignment="Center"/>
                                <TextBox Name="RenameBox" Text="{Binding EditName, Mode=TwoWay}"
                                         FontSize="14" MinWidth="140" Padding="4,1"
                                         IsVisible="{Binding IsRenaming}"
                                         KeyDown="RenameBox_KeyDown"
                                         GotFocus="RenameBox_GotFocus"
                                         LostFocus="RenameBox_LostFocus"/>
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- Inhaltsbereich (Platzhalter bis Schritt 4/5). Breite wird im Code-behind an die
             Fensterbreite gekoppelt — Workaround gegen den Fill-Panel-Measure-Quirk (§9.5),
             damit Inhalt korrekt umbricht/zentriert statt rechts überzulaufen. -->
        <Panel Name="ContentHost" HorizontalAlignment="Left">

            <!-- Big-Picture-Galerie (Ordner-Inhalt als Kacheln) -->
            <ScrollViewer IsVisible="{Binding ShowGallery}">
                <StackPanel Margin="28,22" Spacing="16">
                    <!-- Breadcrumb-Pfadleiste (klickbare Segmente) -->
                    <ItemsControl ItemsSource="{Binding Breadcrumb}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Classes="crumb" Content="{Binding Label}"
                                            Command="{Binding DataContext.NavigateCrumb, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <TextBlock Text="›" Opacity="0.4" Margin="4,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding GalleryTitle}" FontSize="24" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding GalleryItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="tile" Margin="0,0,16,16"
                                        Command="{Binding DataContext.OpenItem, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Width="150" Spacing="8">
                                        <!-- Karte: Ordner farbig, Dokument neutral -->
                                        <Border Height="96" CornerRadius="10">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding IconBrush.Color}" Opacity="0.85"/>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Glyph}" FontSize="40"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding KindLabel}" Opacity="0.6" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock IsVisible="{Binding GalleryEmpty}" Opacity="0.5"
                               Text="Dieser Ordner ist leer."/>
                </StackPanel>
            </ScrollViewer>

            <!-- Whiteboard / Notizbuch: echte Skia-Ansicht + Stift-Eingabe (Schritt 4) -->
            <DockPanel IsVisible="{Binding ShowWhiteboard}">
                <Border DockPanel.Dock="Top" Padding="10,6" Background="#18808080">
                    <WrapPanel>
                        <WrapPanel.Styles>
                            <Style Selector="Button">
                                <Setter Property="Margin" Value="0,0,6,0"/>
                                <Setter Property="Padding" Value="8,3"/>
                            </Style>
                        </WrapPanel.Styles>
                        <Button Content="✒ Stift"     Tag="Pen"         Click="Tool_Click"/>
                        <Button Content="✏ Bleistift" Tag="Pencil"      Click="Tool_Click"/>
                        <Button Content="🖍 Marker"    Tag="Highlighter" Click="Tool_Click"/>
                        <Button Content="⌫ Radierer"  Tag="Eraser"      Click="Tool_Click"/>
                        <Button Content="✋ Hand"      Tag="Pan"         Click="Tool_Click"/>
                        <Border Width="1" Background="#33808080" Margin="4,2"/>
                        <Button Classes="ink" Tag="#111827" Click="Ink_Click" Background="#111827"/>
                        <Button Classes="ink" Tag="#2563EB" Click="Ink_Click" Background="#2563EB"/>
                        <Button Classes="ink" Tag="#DC2626" Click="Ink_Click" Background="#DC2626"/>
                        <Button Classes="ink" Tag="#16A34A" Click="Ink_Click" Background="#16A34A"/>
                        <Border Width="1" Background="#33808080" Margin="4,2"/>
                        <Button Content="dünn"   Tag="2" Click="Width_Click"/>
                        <Button Content="mittel" Tag="4" Click="Width_Click"/>
                        <Button Content="dick"   Tag="9" Click="Width_Click"/>
                        <Border Width="1" Background="#33808080" Margin="4,2"/>
                        <Button Content="↶ Rückgängig" Click="Undo_Click"/>
                        <Button Content="↷ Wiederholen" Click="Redo_Click"/>
                        <Button Content="⤢ 100 %" Click="ZoomReset_Click"/>
                    </WrapPanel>
                </Border>
                <local:WhiteboardCanvas Name="Board" Page="{Binding CurrentPage}"/>
            </DockPanel>

            <!-- Dokument-Kontext (echte Ansicht folgt Schritt 5) -->
            <StackPanel IsVisible="{Binding ShowDocument}" Margin="28,26" Spacing="6"
                        VerticalAlignment="Top">
                <TextBlock Text="{Binding SelectedKindText}" Opacity="0.6" FontSize="12"/>
                <TextBlock Text="{Binding SelectedTitle}" FontSize="26" FontWeight="SemiBold"/>
                <Border Margin="0,14,0,0" Padding="14" CornerRadius="8" Background="#1A808080"
                        HorizontalAlignment="Left">
                    <TextBlock Opacity="0.75" MaxWidth="440" TextWrapping="Wrap"
                               Text="Die echte Dokumentansicht (Whiteboard / Notizbuch / Text) folgt in Schritt 4/5 des Ports."/>
                </Border>
            </StackPanel>

        </Panel>

    </DockPanel>
</Window>
