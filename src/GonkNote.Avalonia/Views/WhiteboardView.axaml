<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GonkNote.Views"
             xmlns:loc="clr-namespace:GonkNote.Services"
             xmlns:vm="clr-namespace:GonkNote.ViewModels;assembly=GonkNote.ViewModels"
             x:Class="GonkNote.Views.WhiteboardView"
             x:DataType="vm:WhiteboardTabViewModel"
             Focusable="True">

    <!-- Die Zeichenfläche des Linux-Kopfs. Aufbau wie beim WPF-Gegenstück
         (src/GonkNote.Wpf/Views/WhiteboardView.xaml), aber **bewusst kürzer**: für
         Meilenstein M1 zählen Seiten anzeigen, zeichnen, radieren, speichern. Sticker,
         OCR, Zahlenblock, Schnellaktionen und Geodreieck sind nicht M1 (HANDOFF §6).

         Die Farben kommen durchgehend aus der Farbtabelle in Core, über die von
         AvaloniaThemeHost gelegten „Brush.X"-Ressourcen — hier steht keine einzige. -->

    <DockPanel>

        <!-- ==================== Werkzeugleiste ==================== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.ToolbarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Margin="8,5" Spacing="1">

                    <!-- ==================== Die Werkzeuge ====================
                         **Die Reihenfolge ist keine Geschmackssache, sie steht in Core**
                         (WbLeiste.Reihenfolge, §4.61) und ist die des WPF-Kopfs: Hand, dann
                         die Stifte samt Radierer, dann die Auswahl, dann alles, was etwas
                         auf die Fläche legt. Bis V2-83 stand sie hier anders, und mit den
                         Stücken 1 bis 4 war die Leiste so lang geworden, dass sie rollte.

                         **Vier Gruppen klappen** (Stifte, Auswahl, Formen, Zeichenhilfen):
                         eingeklappt bleibt nur der zuletzt benutzte Knopf stehen, das
                         Anwählen klappt die Gruppe auf. Die Regel steht in
                         WbLeiste.IstSichtbar, damit beide Köpfe dieselbe haben.

                         **Der Glättstift fehlt weiterhin** — er gehört zum Formen-Stift, und
                         der ist eigene Arbeit (§6). WbLeiste.Reihenfolge führt ihn schon;
                         die Liste ist eine Vorgabe und keine Beschreibung. -->

                    <ToggleButton x:Name="BtnPan" Classes="werkzeug" Tag="Pan"
                                  IsCheckedChanged="Tool_Changed" ToolTip.Tip="{loc:T Tool.Hand.Tip}">
                        <views:Symbol Icon="Hand" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>

                    <Border Classes="trenner"/>

                    <!-- Stifte. Tag = der ToolType-Name; der Code-Behind liest ihn, statt je
                         Knopf ein eigenes Ereignis zu haben (wie im WPF-Kopf). -->
                    <ToggleButton x:Name="BtnPen" Classes="werkzeug" Tag="Pen"
                                  IsCheckedChanged="Tool_Changed" ToolTip.Tip="{loc:T Tool.Pen}">
                        <views:Symbol Icon="Pen" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnPencil" Classes="werkzeug" Tag="Pencil"
                                  IsCheckedChanged="Tool_Changed" ToolTip.Tip="{loc:T Tool.Pencil}">
                        <views:Symbol Icon="Pencil" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnHighlighter" Classes="werkzeug" Tag="Highlighter"
                                  IsCheckedChanged="Tool_Changed" ToolTip.Tip="{loc:T Tool.Highlighter}">
                        <views:Symbol Icon="Highlighter" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>

                    <!-- Der Radierer steht neben den Stiften, gehört aber zu keiner Gruppe:
                         er ist immer zu sehen. Dieselbe Stelle wie drüben. -->
                    <ToggleButton x:Name="BtnEraser" Classes="werkzeug" Tag="Eraser"
                                  IsCheckedChanged="Tool_Changed" ToolTip.Tip="{loc:T Tool.Eraser}">
                        <views:Symbol Icon="Eraser" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>

                    <Border Classes="trenner"/>

                    <!-- Auswahl (Lasso und Verschieben) — klappbare Gruppe wie die Stifte. -->
                    <ToggleButton x:Name="BtnLasso" Classes="werkzeug" Tag="Lasso"
                                  IsCheckedChanged="Tool_Changed" ToolTip.Tip="{loc:T Tool.Lasso}">
                        <views:Symbol Icon="Lasso" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnMove" Classes="werkzeug" Tag="Move"
                                  IsCheckedChanged="Tool_Changed" ToolTip.Tip="{loc:T Tool.Move.Tip}">
                        <views:Symbol Icon="Move" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>

                    <Border Classes="trenner"/>

                    <!-- Textfeld. Gehört zu den Werkzeugen mit „genau einer ist gedrückt"
                         und steht deshalb in ToolButtons — anders als die fünf Formen, die
                         sich eines teilen. -->
                    <ToggleButton x:Name="BtnText" Classes="werkzeug" Tag="Text"
                                  IsCheckedChanged="Tool_Changed" ToolTip.Tip="{loc:T Tool.Text}">
                        <views:Symbol Icon="TextTool" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>

                    <!-- Die fünf Formen. Tag = der ShapeKind-Name; sie teilen sich ein
                         eigenes Ereignis, weil alle fünf dasselbe Werkzeug einschalten und
                         sich nur in der Art unterscheiden. Rechteck zuerst — es ist die
                         Vorgabe, und eingeklappt steht hier die zuletzt benutzte Form. -->
                    <ToggleButton x:Name="BtnFormRechteck" Classes="werkzeug" Tag="Rectangle"
                                  IsCheckedChanged="Form_Gewaehlt" ToolTip.Tip="{loc:T Tool.Shape.Rect}">
                        <views:Symbol Icon="ShapeRect" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnFormLinie" Classes="werkzeug" Tag="Line"
                                  IsCheckedChanged="Form_Gewaehlt" ToolTip.Tip="{loc:T Tool.Shape.Line}">
                        <views:Symbol Icon="ShapeLine" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnFormPfeil" Classes="werkzeug" Tag="Arrow"
                                  IsCheckedChanged="Form_Gewaehlt" ToolTip.Tip="{loc:T Tool.Shape.Arrow}">
                        <views:Symbol Icon="ShapeArrow" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnFormEllipse" Classes="werkzeug" Tag="Ellipse"
                                  IsCheckedChanged="Form_Gewaehlt" ToolTip.Tip="{loc:T Tool.Shape.Ellipse}">
                        <views:Symbol Icon="ShapeEllipse" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnFormDreieck" Classes="werkzeug" Tag="Triangle"
                                  IsCheckedChanged="Form_Gewaehlt" ToolTip.Tip="{loc:T Tool.Shape.Triangle}">
                        <views:Symbol Icon="ShapeTriangle" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>

                    <ToggleButton x:Name="BtnZettel" Classes="werkzeug" Tag="Sticky"
                                  IsCheckedChanged="Tool_Changed" ToolTip.Tip="{loc:T Tool.Sticky}">
                        <views:Symbol Icon="StickyNote" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnSticker" Classes="werkzeug" Tag="Sticker"
                                  IsCheckedChanged="Tool_Changed" ToolTip.Tip="{loc:T Tool.Sticker.Tip}">
                        <views:Symbol Icon="Sticker" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>

                    <!-- Lineal und Geodreieck. **Sie stehen bewusst nicht in ToolButtons**:
                         dort gilt „genau einer ist gedrückt", und eine Zeichenhilfe ist kein
                         Werkzeug — sie liegt auf der Seite, während man mit dem Stift daran
                         entlangfährt. Wer sie mit hineinnähme, verlöre beim Einschalten des
                         Lineals seinen Stift. Klappbar sind sie trotzdem. -->
                    <ToggleButton x:Name="BtnLineal" Classes="werkzeug"
                                  Click="Lineal_Click" ToolTip.Tip="{loc:T Tool.Ruler.Tip}">
                        <views:Symbol Icon="Ruler" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnGeodreieck" Classes="werkzeug"
                                  Click="Geodreieck_Click" ToolTip.Tip="{loc:T Tool.SetSquare.Tip}">
                        <views:Symbol Icon="SetSquare" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>

                    <Border Classes="trenner"/>

                    <!-- Farben. Die erste Kachel ist „auto": schwarz auf hellen, weiß auf
                         dunklen Seiten — sie wird im Zeichenpfad nachgeführt. -->
                    <RadioButton x:Name="AutoSwatch" Classes="farbe" GroupName="Tinte" Tag="auto"
                                 IsChecked="True" IsCheckedChanged="Color_Changed"/>
                    <!-- **Die Farbkacheln entstehen im Code aus WbTinte.Palette** (Core) —
                         dieselbe Liste, aus der sie auch der WPF-Kopf baut (§4.74). -->

                    <!-- Die zuletzt frei gewaehlte Farbe. Sie ist zunaechst verborgen und
                         erscheint erst, wenn der Waehler eine geliefert hat — genau wie
                         drueben (CustomSwatch). -->
                    <RadioButton x:Name="CustomSwatch" Classes="farbe" GroupName="Tinte"
                                 Tag="#FF000000" IsVisible="False"
                                 ToolTip.Tip="{loc:T Color.Custom}"
                                 IsCheckedChanged="Color_Changed"/>
                    <Button Classes="flach symbol" ToolTip.Tip="{loc:T Color.Pick}"
                            Click="EigeneTinte_Click">
                        <Ellipse Width="16" Height="16">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Color="#EF4444" Offset="0"/>
                                    <GradientStop Color="#EAB308" Offset="0.25"/>
                                    <GradientStop Color="#22C55E" Offset="0.5"/>
                                    <GradientStop Color="#2563EB" Offset="0.75"/>
                                    <GradientStop Color="#8B5CF6" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Button>

                    <Border Classes="trenner"/>

                    <!-- Größe. Bedient je nach Werkzeug die Strichstärke oder den
                         Radierradius — beide Werte werden getrennt gemerkt, damit ein
                         Werkzeugwechsel den jeweils anderen nicht überschreibt.

                         **Alle drei Bedienelemente öffnen per Langdruck denselben
                         Zahlenblock** (Phase 4.5, Stück 5) — Symbol, Schieber, Wertanzeige.
                         Bis dahin versprach der Tooltip „lange drücken für Zahleneingabe"
                         etwas, das es hier nicht gab. Das Symbol fehlte ebenfalls; es ist
                         der dritte Auslöser und zugleich die Anzeige, was gerade eingestellt
                         wird (Stift oder Radierer).

                         **Die drei Zeigerereignisse hängen im Code-Behind am Tunnel und
                         nicht hier.** Als gewöhnliches (Bubble-)Ereignis kommt der Handler
                         nie an: der Slider markiert den Druck als erledigt, und der
                         Langdruck fing gar nicht erst an — am laufenden Programm gesehen,
                         der Schieber sprang auf den angeklickten Wert und sonst geschah
                         nichts. Dieselbe Falle wie beim Tippen über der Fläche (§4.55). -->
                    <views:Symbol x:Name="WidthIcon" Icon="Pencil" Size="12" Cursor="Hand"
                                  VerticalAlignment="Center" Margin="2,0"
                                  Stroke="{DynamicResource Brush.TextMuted}"
                                  ToolTip.Tip="{loc:T Size.Tip}"/>
                    <Slider x:Name="WidthSlider" Width="110" Minimum="0.5" Maximum="40" Value="2.5"
                            VerticalAlignment="Center" Margin="6,0"
                            PropertyChanged="WidthSlider_Changed"/>
                    <TextBlock x:Name="WidthLabel" VerticalAlignment="Center" Width="26"
                               TextAlignment="Right" FontSize="12"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               ToolTip.Tip="{loc:T Size.Tip}"/>

                    <!-- Der Zahlenblock. **IsLightDismissEnabled schließt ihn bei einem Druck
                         daneben** — und das ist hier der einfachere Weg als im WPF-Kopf, wo
                         dieselbe Sache von Hand nachgebaut werden musste: dort lebt der
                         Popup-Inhalt in einem eigenen Visual-Baum, ein Hochlauf vom Klickziel
                         erreichte die Werkzeugleiste nie, und jeder Ziffernklick galt als
                         „außerhalb". Avalonia behandelt Drücke **im** Popup von sich aus
                         richtig. Der Preis: ein Druck auf den Schieber schließt den Block —
                         was in Ordnung ist, denn dann bedient der Nutzer eben den Schieber. -->
                    <Popup x:Name="Zahlenblock" PlacementTarget="{Binding #WidthSlider}"
                           Placement="Bottom" IsLightDismissEnabled="True">
                        <Border Background="{DynamicResource Brush.CardBg}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="12" Padding="10" Margin="8" Width="196"
                                BoxShadow="0 2 16 0 #47000000">
                            <StackPanel>
                                <TextBlock x:Name="ZahlenblockAnzeige" Text="2,5" FontSize="28"
                                           Margin="8,2,8,10"
                                           Foreground="{DynamicResource Brush.Text}"/>
                                <UniformGrid Columns="3" Rows="4">
                                    <Button Classes="zifferntaste" Content="7" Click="Ziffer_Click"/>
                                    <Button Classes="zifferntaste" Content="8" Click="Ziffer_Click"/>
                                    <Button Classes="zifferntaste" Content="9" Click="Ziffer_Click"/>
                                    <Button Classes="zifferntaste" Content="4" Click="Ziffer_Click"/>
                                    <Button Classes="zifferntaste" Content="5" Click="Ziffer_Click"/>
                                    <Button Classes="zifferntaste" Content="6" Click="Ziffer_Click"/>
                                    <Button Classes="zifferntaste" Content="1" Click="Ziffer_Click"/>
                                    <Button Classes="zifferntaste" Content="2" Click="Ziffer_Click"/>
                                    <Button Classes="zifferntaste" Content="3" Click="Ziffer_Click"/>
                                    <Button Classes="zifferntaste" Content="0" Click="Ziffer_Click"/>
                                    <Button Classes="zifferntaste" Content="," Click="Ziffer_Click"/>
                                    <Button Classes="zifferntaste" Click="Rueckschritt_Click"
                                            ToolTip.Tip="{loc:T Action.Delete}">
                                        <views:Symbol Icon="Backspace"
                                                      Stroke="{DynamicResource Brush.Text}"/>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Border Classes="trenner"/>

                    <!-- Rückgängig und Wiederholen. **Sie stehen hinter der Größe und nicht
                         vorn** — dieselbe Stelle wie im WPF-Kopf: die Werkzeugleiste ist
                         nach „womit zeichne ich" und „wie sieht es aus" geordnet, und was
                         etwas zurücknimmt, gehört hinter beides. -->
                    <Button x:Name="BtnUndo" Classes="flach symbol" Click="Undo_Click"
                            ToolTip.Tip="{loc:T Action.Undo}">
                        <views:Symbol Icon="Undo" Stroke="{DynamicResource Brush.Text}"/>
                    </Button>
                    <Button x:Name="BtnRedo" Classes="flach symbol" Click="Redo_Click"
                            ToolTip.Tip="{loc:T Action.Redo}">
                        <views:Symbol Icon="Redo" Stroke="{DynamicResource Brush.Text}"/>
                    </Button>

                    <Border Classes="trenner"/>

                    <Button Classes="flach symbol" Click="ZoomOut_Click" ToolTip.Tip="{loc:T Zoom.Out}">
                        <views:Symbol Icon="ZoomOut"
                              Stroke="{DynamicResource Brush.Text}"/>
                    </Button>
                    <Button x:Name="ZoomLabel" Classes="flach" Click="ZoomReset_Click"
                            ToolTip.Tip="{loc:T Zoom.Reset}" MinWidth="52" Content="100 %"
                            FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <Button Classes="flach symbol" Click="ZoomIn_Click" ToolTip.Tip="{loc:T Zoom.In}">
                        <views:Symbol Icon="ZoomIn"
                              Stroke="{DynamicResource Brush.Text}"/>
                    </Button>

                    <Border Classes="trenner"/>

                    <!-- Einfügen (Phase 4.5). Steht bewusst NICHT in ToolButtons: er schaltet
                         kein Werkzeug ein, sondern öffnet einen Dialog — gedrückt stehen
                         bleiben würde er zu Unrecht. Dieselbe Stelle wie im WPF-Kopf. -->
                    <Button x:Name="BtnEinfuegen" Classes="flach symbol"
                            Click="DateiEinfuegen_Click" ToolTip.Tip="{loc:T Wb.InsertFile.Tip}">
                        <views:Symbol Icon="Image"
                              Stroke="{DynamicResource Brush.Text}"/>
                    </Button>

                    <Button x:Name="BtnEinstellungen" Classes="flach symbol"
                            Click="Einstellungen_Click" ToolTip.Tip="{loc:T Wb.Settings.PageTip}">
                        <views:Symbol Icon="Settings"
                              Stroke="{DynamicResource Brush.Text}"/>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ==================== Seitenleiste unten ==================== -->
        <Border x:Name="PageBar" DockPanel.Dock="Bottom"
                Background="{DynamicResource Brush.ToolbarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="8,4" Spacing="2">
                <Button Classes="flach symbol" Click="PrevPage_Click">
                    <views:Symbol Icon="ChevronLeft"
                          Stroke="{DynamicResource Brush.Text}"/>
                </Button>
                <TextBlock x:Name="PageLabel" VerticalAlignment="Center" MinWidth="110"
                           TextAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
                <Button Classes="flach symbol" Click="NextPage_Click">
                    <views:Symbol Icon="ChevronRight"
                          Stroke="{DynamicResource Brush.Text}"/>
                </Button>
                <Border Classes="trenner"/>
                <Button Classes="flach symbol" Click="AddPage_Click" ToolTip.Tip="{loc:T Page.Add}">
                    <views:Symbol Icon="Plus"
                          Stroke="{DynamicResource Brush.Text}"/>
                </Button>
                <Button Classes="flach symbol" Click="DeletePage_Click" ToolTip.Tip="{loc:T Page.Delete}">
                    <views:Symbol Icon="Trash"
                          Stroke="{DynamicResource Brush.Text}"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ==================== Einstellungen (rechte Seitenleiste) ==================== -->
        <!-- **Nur die Seite.** Der WPF-Kopf hat hier zusätzlich Formen, Text, Notizzettel,
             Sticker, Export und Cover — sieben Klappgruppen gegen diese eine.

             ⛔ **Die Begründung, die hier stand, ist abgelaufen** (HANDOFF §4.71, dieselbe
             Falle wie §4.60). Sie lautete: „Werkzeuge, die es im Linux-Kopf nicht gibt
             (nicht M1, HANDOFF §6)". **Das stimmte bis Phase 4.5 und stimmt seitdem für
             vier der fünf nicht mehr** — Formen (§4.53), Text und Notizzettel (§4.55) und
             Sticker (§4.56) gibt es hier. **Nur das Cover fehlt wirklich.**

             Der Satz dahinter gilt unverändert und ist der Grund, warum hier trotzdem noch
             nichts steht: eine Sektion für ein fehlendes Werkzeug wäre ein halbes Feature,
             und ein halbes Feature ist schlechter als ein fehlendes — niemand sieht ihm an,
             dass es halb ist. **Was fehlt, wird nachgebaut und nicht drüben gelöscht**
             (§5 Nr. 26); das ist Phase 5, Schritt ①b.

             Änderungen wirken sofort auf die aktuelle Seite, ohne OK-Knopf — genau wie
             drüben (WhiteboardView.Settings.cs, PageSetting_Changed). -->
        <Border x:Name="EinstellungenLeiste" DockPanel.Dock="Right" Width="262" IsVisible="False"
                Background="{DynamicResource Brush.ToolbarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="14,8"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="flach symbol"
                                ToolTip.Tip="{loc:T Wb.Settings.Close}" Click="Einstellungen_Click">
                            <views:Symbol Icon="Close"
                                  Stroke="{DynamicResource Brush.Text}"/>
                        </Button>
                        <TextBlock Text="{loc:T Settings.Page}" FontWeight="SemiBold" FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text}"/>
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12">

                        <!-- Muster -->
                        <TextBlock Text="{loc:T Settings.Page.Pattern}" FontWeight="SemiBold"
                                   Margin="0,0,0,4" Foreground="{DynamicResource Brush.Text}"/>
                        <UniformGrid Columns="2" Margin="0,0,0,14">
                            <RadioButton x:Name="SetzeMusterBlanko" GroupName="setzeMuster" Margin="0,2"
                                         Content="{loc:T Settings.Page.Blank}"
                                         IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                            <RadioButton x:Name="SetzeMusterLinien" GroupName="setzeMuster" Margin="0,2"
                                         Content="{loc:T Settings.Page.Lines}"
                                         IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                            <RadioButton x:Name="SetzeMusterKaro" GroupName="setzeMuster" Margin="0,2"
                                         Content="{loc:T Settings.Page.Grid}"
                                         IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                            <RadioButton x:Name="SetzeMusterPunkte" GroupName="setzeMuster" Margin="0,2"
                                         Content="{loc:T Settings.Page.Dots}"
                                         IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                        </UniformGrid>

                        <!-- Farbton -->
                        <TextBlock Text="{loc:T Settings.Page.Shade}" FontWeight="SemiBold"
                                   Margin="0,0,0,4" Foreground="{DynamicResource Brush.Text}"/>
                        <StackPanel Margin="0,0,0,14">
                            <RadioButton x:Name="SetzeTonAuto" GroupName="setzeTon" Margin="0,2"
                                         Content="{loc:T Settings.Page.Shade.Auto}"
                                         IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                            <RadioButton x:Name="SetzeTonHell" GroupName="setzeTon" Margin="0,2"
                                         Content="{loc:T Settings.Page.Shade.Light}"
                                         IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                            <RadioButton x:Name="SetzeTonDunkel" GroupName="setzeTon" Margin="0,2"
                                         Content="{loc:T Settings.Page.Shade.Dark}"
                                         IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                        </StackPanel>

                        <!-- Format und Ausrichtung. Die unendliche Fläche hat kein Blatt,
                             dessen Maße man setzen könnte — dort verschwindet der Abschnitt. -->
                        <StackPanel x:Name="FormatAbschnitt">
                            <TextBlock Text="{loc:T Settings.Page.Format}" FontWeight="SemiBold"
                                       Margin="0,0,0,4" Foreground="{DynamicResource Brush.Text}"/>
                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <RadioButton x:Name="SetzeFormatA4" GroupName="setzeFormat" Margin="0,2"
                                             Content="A4" IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                                <RadioButton x:Name="SetzeFormatA3" GroupName="setzeFormat" Margin="0,2"
                                             Content="A3" IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                            </UniformGrid>

                            <TextBlock Text="{loc:T Settings.Page.Orientation}" FontWeight="SemiBold"
                                       Margin="0,0,0,4" Foreground="{DynamicResource Brush.Text}"/>
                            <StackPanel Margin="0,0,0,14">
                                <RadioButton x:Name="SetzeHochformat" GroupName="setzeLage" Margin="0,2"
                                             Content="{loc:T Settings.Page.Portrait}"
                                             IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                                <RadioButton x:Name="SetzeQuerformat" GroupName="setzeLage" Margin="0,2"
                                             Content="{loc:T Settings.Page.Landscape}"
                                             IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                            </StackPanel>

                            <CheckBox x:Name="SetzeAlsStandard" Margin="0,0,0,12"
                                      Content="{loc:T Settings.Page.AsDefault}"
                                      IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                        </StackPanel>

                        <!-- Auf dem Cover ändert nichts davon etwas: es hat weder Muster
                             noch Farbton, sein Aussehen kommt aus WhiteboardDoc.Cover. -->
                        <TextBlock x:Name="CoverHinweis" IsVisible="False" TextWrapping="Wrap"
                                   FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="{loc:T Settings.Page.CoverHint}"/>

                        <!-- ==================== Formen ==================== -->
                        <!-- Neu in Phase 4.5. Die Sektion erscheint nur, solange das
                             Formen-Werkzeug aktiv ist — dieselbe Regel wie drüben, wo sie in
                             einem Expander sitzt: eine Füllfarbe ohne Form daneben ist eine
                             Einstellung ohne Gegenstand. -->
                        <StackPanel x:Name="FormenBereich" IsVisible="False" Margin="0,18,0,0">
                            <TextBlock Text="{loc:T Settings.Shapes}" FontWeight="SemiBold" FontSize="14"
                                       Margin="0,0,0,6" Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="{loc:T Settings.Shapes.Hint}" TextWrapping="Wrap" FontSize="11"
                                       Margin="0,0,0,8" Foreground="{DynamicResource Brush.TextMuted}"/>

                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                                <!-- Der Schalter trägt die Vorschau: er zeigt, was er
                                     einschaltet. Das Schachbrett dahinter macht die
                                     Deckkraft sichtbar. -->
                                <ToggleButton x:Name="FuellungAn" Classes="werkzeug"
                                              ToolTip.Tip="{loc:T Settings.Shapes.FillToggle}"
                                              IsCheckedChanged="Fuellung_Umgeschaltet">
                                    <Border Width="16" Height="16" CornerRadius="3" ClipToBounds="True"
                                            Background="{StaticResource Schachbrett}">
                                        <Border x:Name="FuellungVorschau"/>
                                    </Border>
                                </ToggleButton>
                                <Button Classes="flach symbol" Click="Fuellfarbe_Click"
                                        ToolTip.Tip="{loc:T Settings.Shapes.FillColor}">
                                    <views:Symbol Icon="Palette" Stroke="{DynamicResource Brush.Text}"/>
                                </Button>
                                <TextBlock Text="{loc:T Settings.Shapes.Fill}" VerticalAlignment="Center"
                                           Margin="6,0,0,0" Foreground="{DynamicResource Brush.Text}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{loc:T Settings.Shapes.Opacity}" VerticalAlignment="Center"
                                           Margin="0,0,6,0" FontSize="11"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                                <Slider x:Name="FuellungDeckkraft" Width="110" Minimum="0" Maximum="100" Value="40"
                                        VerticalAlignment="Center"
                                        PropertyChanged="Deckkraft_Geaendert"/>
                                <TextBlock x:Name="DeckkraftAnzeige" Text="40 %" Width="38" VerticalAlignment="Center"
                                           Margin="4,0,0,0" FontSize="11"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ==================== Textfeld ==================== -->
                        <StackPanel x:Name="TextBereich" IsVisible="False" Margin="0,18,0,0">
                            <TextBlock Text="{loc:T Settings.Text}" FontWeight="SemiBold" FontSize="14"
                                       Margin="0,0,0,6" Foreground="{DynamicResource Brush.Text}"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <!-- Der Schalter trägt die Vorschau, wie bei der Formfüllung. -->
                                <ToggleButton x:Name="TextGrundAn" Classes="werkzeug"
                                              ToolTip.Tip="{loc:T Settings.Text.BgTip}"
                                              IsCheckedChanged="TextGrund_Umgeschaltet">
                                    <Border Width="16" Height="16" CornerRadius="3" ClipToBounds="True"
                                            Background="{StaticResource Schachbrett}">
                                        <Border x:Name="TextGrundVorschau"/>
                                    </Border>
                                </ToggleButton>
                                <Button Classes="flach symbol" Click="TextGrundfarbe_Click"
                                        ToolTip.Tip="{loc:T Settings.Text.BgTip}">
                                    <views:Symbol Icon="Palette" Stroke="{DynamicResource Brush.Text}"/>
                                </Button>
                                <TextBlock Text="{loc:T Settings.Text.Bg}" VerticalAlignment="Center"
                                           Margin="6,0,0,0" Foreground="{DynamicResource Brush.Text}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ==================== Notizzettel ==================== -->
                        <StackPanel x:Name="ZettelBereich" IsVisible="False" Margin="0,18,0,0">
                            <TextBlock Text="{loc:T Settings.Sticky}" FontWeight="SemiBold" FontSize="14"
                                       Margin="0,0,0,6" Foreground="{DynamicResource Brush.Text}"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border x:Name="ZettelVorschau" Width="26" Height="26" CornerRadius="4"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"/>
                                <Button Classes="flach symbol" Click="Zettelfarbe_Click"
                                        ToolTip.Tip="{loc:T Settings.Sticky.CustomColor}">
                                    <views:Symbol Icon="Palette" Stroke="{DynamicResource Brush.Text}"/>
                                </Button>
                                <TextBlock Text="{loc:T Settings.Sticky.Color}" VerticalAlignment="Center"
                                           Margin="6,0,0,0" Foreground="{DynamicResource Brush.Text}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ==================== Sticker ==================== -->
                        <!-- Die Sammlung ist die Bedienung: ein Sticker wird nicht auf die
                             Fläche gezogen, sondern durch Klick auf seine Kachel eingefügt —
                             genau wie drüben. Deshalb steht hier ein Kachelraster und kein
                             Farbwähler. -->
                        <StackPanel x:Name="StickerBereich" IsVisible="False" Margin="0,18,0,0">
                            <TextBlock Text="{loc:T Tool.Sticker}" FontWeight="SemiBold" FontSize="14"
                                       Margin="0,0,0,6" Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="{loc:T Settings.Sticker.Hint}" TextWrapping="Wrap" FontSize="11"
                                       Margin="0,0,0,8" Foreground="{DynamicResource Brush.TextMuted}"/>

                            <!-- Der Hinweis für die leere Sammlung steht **im XAML** und wird
                                 nur ein- und ausgeblendet: im Code erzeugt, müsste er bei
                                 jedem Neuladen mit seiner Farbe und seinem Umbruch von Hand
                                 aufgebaut werden. -->
                            <TextBlock x:Name="StickerLeerHinweis" IsVisible="False" TextWrapping="Wrap"
                                       FontSize="11" Margin="0,0,0,8"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       Text="{loc:T Settings.Sticker.Empty}"/>

                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="StickerRaster"/>
                            </ScrollViewer>

                            <Button Classes="flach" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Click="StickerHinzufuegen_Click">
                                <StackPanel Orientation="Horizontal">
                                    <views:Symbol Icon="Plus" VerticalAlignment="Center"
                                                  Stroke="{DynamicResource Brush.Text}"/>
                                    <TextBlock Text="{loc:T Settings.Sticker.Add}" Margin="6,0,0,0"
                                               Foreground="{DynamicResource Brush.Text}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ==================== Die Fläche ==================== -->
        <!-- ClipToBounds, damit ein Strich am Rand nicht über die Werkzeugleiste läuft. -->
        <Panel ClipToBounds="True">
            <views:SkiaCanvas x:Name="Skia"/>

            <!-- Die Überlagerung fürs Tippen (Phase 4.5). Textfelder und Notizzettel werden
                 nicht auf der Skia-Fläche bearbeitet, sondern in einem echten Eingabefeld
                 darüber — nur so gibt es Marke, Auswahl, Zwischenablage und die
                 Eingabemethode für Umlaute und tote Tasten geschenkt. Dasselbe Verfahren wie
                 im WPF-Kopf (WhiteboardView.xaml, „Overlay").

                 **Der Canvas hat bewusst KEINEN Hintergrund** (`{x:Null}`, nicht
                 `Transparent`): er liegt über der ganzen Fläche, und mit Hintergrund finge er
                 jeden Zeigerdruck ab — es ließe sich kein Strich mehr zeichnen. Ohne
                 Hintergrund ist nur anfassbar, was darin steht, also das Eingabefeld.
                 `IsHitTestVisible="False"` wäre der falsche Weg: das schlägt auf die Kinder
                 durch, und dann ließe sich der Text nicht mehr mit der Maus markieren. -->
            <Canvas x:Name="Ueberlagerung" Background="{x:Null}">
                <!-- KeyDown wird im Code-Behind mit `Tunnel` angehängt und NICHT hier: als
                     gewöhnliches (Bubble-)Ereignis kommt der Handler erst, nachdem der
                     TextBox die Taste schon verarbeitet hat — Strg+Eingabe stand dann als
                     Zeichen im Text, bevor die Bearbeitung abschloss. Am laufenden Programm
                     gesehen. -->
                <TextBox x:Name="EditFeld" IsVisible="False" AcceptsReturn="True"
                         MinWidth="60" BorderThickness="1"
                         LostFocus="EditFeld_Verlassen"/>
            </Canvas>

            <!-- Die Schnellaktionen (Phase 4.5, Stück 5). Eine schwebende Leiste statt eines
                 Rechtsklick-Menüs — der Zweck ist die Bedienung **ohne Tastatur**, für den
                 Stift also der einzige Weg zu Kopieren und Einfügen.

                 **Sie liegt im selben Panel wie die Fläche und wird über den Rand gesetzt**
                 (HorizontalAlignment/VerticalAlignment auf Top-Left, dann Margin): so ist die
                 Ecke oben links ihre Position, und genau damit rechnet
                 WbSchnellaktionen.ImBlick.

                 **Kein Aufklappen nach einer frischen Auswahl** — anders als im WPF-Kopf.
                 Dort legt sich die Leiste über die Oberkante der Auswahl und verdeckt den
                 Dreh-Griff (§4.51, ein Wächter rechnet die Überschneidung nach). -->
            <Border x:Name="Schnellaktionen" IsVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Top" ZIndex="50"
                    Background="{DynamicResource Brush.CardBg}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="10" Padding="4"
                    BoxShadow="0 2 14 0 #47000000">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="Sa_Ausschneiden" Classes="flach symbol" Click="Sa_Ausschneiden_Click"
                            ToolTip.Tip="{loc:T Quick.Cut.Tip}">
                        <views:Symbol Icon="Cut" Stroke="{DynamicResource Brush.Text}"/>
                    </Button>
                    <Button x:Name="Sa_Kopieren" Classes="flach symbol" Click="Sa_Kopieren_Click"
                            ToolTip.Tip="{loc:T Quick.Copy.Tip}">
                        <views:Symbol Icon="Copy" Stroke="{DynamicResource Brush.Text}"/>
                    </Button>
                    <Button x:Name="Sa_Duplizieren" Classes="flach symbol" Click="Sa_Duplizieren_Click"
                            ToolTip.Tip="{loc:T Quick.Duplicate.Tip}">
                        <views:Symbol Icon="Duplicate" Stroke="{DynamicResource Brush.Text}"/>
                    </Button>
                    <Button x:Name="Sa_Einfuegen" Classes="flach symbol" Click="Sa_Einfuegen_Click"
                            ToolTip.Tip="{loc:T Quick.Paste.Tip}">
                        <views:Symbol Icon="Paste" Stroke="{DynamicResource Brush.Text}"/>
                    </Button>

                    <!-- Die Texterkennung (Stück 6). **Sie wird ausgeblendet und nicht bloß
                         ausgegraut**, wenn es auf diesem System keine gibt — ein dauerhaft
                         grauer Knopf sieht aus wie ein Fehler. Der Trenner davor geht mit ihm
                         mit, sonst stünden zwei Trenner nebeneinander
                         (WbSchnellaktionen.Zustand.TexterkennungSichtbar). -->
                    <Border x:Name="Sa_TrennerOcr" Classes="trenner"/>
                    <Button x:Name="Sa_Texterkennung" Classes="flach symbol" Click="Sa_Texterkennung_Click"
                            ToolTip.Tip="{loc:T Quick.Ocr}">
                        <views:Symbol Icon="Ocr" Stroke="{DynamicResource Brush.Text}"/>
                    </Button>

                    <Border Classes="trenner"/>

                    <Button x:Name="Sa_Loeschen" Classes="flach symbol" Click="Sa_Loeschen_Click"
                            ToolTip.Tip="{loc:T Quick.Delete.Tip}">
                        <views:Symbol Icon="Trash" Stroke="{DynamicResource Brush.Text}"/>
                    </Button>
                    <Button x:Name="Sa_AllesWaehlen" Classes="flach symbol" Click="Sa_AllesWaehlen_Click"
                            ToolTip.Tip="{loc:T Quick.SelectAll.Tip}">
                        <views:Symbol Icon="SelectAll" Stroke="{DynamicResource Brush.Text}"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Die Wartesperre beim Einfügen (Phase 4.5). Sie hat **Hintergrund und liegt
                 über allem**, und das ist der Zweck: ein PDF wird im Hintergrund gerendert,
                 und solange das läuft, soll auf der Fläche nichts anderes passieren — sonst
                 zeichnet jemand auf eine Seite, die gleich durch die eingefügten Blätter
                 verdeckt wird. Der WPF-Kopf hat dasselbe (WhiteboardView.xaml, „BusyOverlay").

                 Der Fortschritt steht **im Text** und nicht im Balken: die Renderdauer je
                 Seite schwankt stark, ein Balken sprünge dann vor und zurück. -->
            <Border x:Name="WarteSperre" IsVisible="False" Background="#66000000">
                <Border Background="{DynamicResource Brush.CardBg}" CornerRadius="10" Padding="26,20"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <StackPanel>
                        <ProgressBar x:Name="WarteBalken" Width="240" Height="6" IsIndeterminate="True"/>
                        <TextBlock x:Name="WarteText" Margin="0,12,0,0" HorizontalAlignment="Center"
                                   Text="{loc:T Busy.Importing}"
                                   Foreground="{DynamicResource Brush.Text}"/>
                    </StackPanel>
                </Border>
            </Border>
        </Panel>

    </DockPanel>
</UserControl>
