<Window x:Class="GonkNote.Views.TableSortDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tabelle sortieren" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.WindowBg}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource Brush.Text}"
        ShowInTaskbar="False">
    <StackPanel Margin="18">
        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="Sortieren nach" Width="110" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
            <ComboBox x:Name="ColumnCombo"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="Typ" Width="110" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
            <ComboBox x:Name="TypeCombo">
                <ComboBoxItem Content="Text" IsSelected="True"/>
                <ComboBoxItem Content="Zahl"/>
                <ComboBoxItem Content="Datum"/>
            </ComboBox>
        </DockPanel>
        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="Reihenfolge" Width="110" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
            <ComboBox x:Name="DirCombo">
                <ComboBoxItem Content="Aufsteigend" IsSelected="True"/>
                <ComboBoxItem Content="Absteigend"/>
            </ComboBox>
        </DockPanel>
        <CheckBox x:Name="HeaderCheck" Content="Erste Zeile ist Kopfzeile (nicht mitsortieren)"
                  IsChecked="True" Foreground="{DynamicResource Brush.Text}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Abbrechen" Style="{StaticResource FlatButton}" MinWidth="90"
                    IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Sortieren" Style="{StaticResource AccentButton}" MinWidth="100"
                    Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
