<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GonkNote.ViewModels;assembly=GonkNote.ViewModels"
        xmlns:loc="clr-namespace:GonkNote.Services"
        x:Class="GonkNote.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Gonk Note" Width="1280" Height="820"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="avares://GonkNote.Avalonia/Assets/gonk-note-Icon.png"
        Background="{DynamicResource Brush.WindowBg}"
        Foreground="{DynamicResource Brush.Text}"
        FontSize="13">

    <!-- Der Aufbau folgt MainWindow.xaml des WPF-Kopfs, damit beide nebeneinander
         vergleichbar bleiben: Menüleiste oben, Seitenleiste mit Baum links, rechts
         entweder die Galerie (wenn nichts offen ist) oder die Registerkarten.

         **Was hier noch fehlt und in den nächsten Brocken gehört:** die Zeichenfläche
         (eine geöffnete Tafel führt zu einer leeren Registerkarte), Drag & Drop im Baum
         und die einblendbare Titelleiste des maximierten Fensters. -->

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand}"/>
        <KeyBinding Gesture="Ctrl+T" Command="{Binding ToggleThemeCommand}"/>
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}"
                    CommandParameter="{Binding SelectedTab}"/>
    </Window.KeyBindings>

    <DockPanel>

        <!-- ===== Menüleiste ===== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.SidebarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Left" Classes="flach symbol" Margin="4,2"
                        ToolTip.Tip="{loc:T Sidebar.Toggle}" Click="Seitenleiste_Click">
                    <Path Classes="symbol" Data="{StaticResource Icon.Seitenleiste}"
                          Stroke="{DynamicResource Brush.Text}"/>
                </Button>

                <Menu VerticalAlignment="Center">
                    <MenuItem Header="{loc:T Menu.File}">
                        <MenuItem Header="{loc:T Menu.File.NewFolder}" Command="{Binding NewFolderCommand}"/>
                        <MenuItem Header="{loc:T Menu.File.NewNotebook}" Command="{Binding NewNotebookCommand}"/>
                        <MenuItem Header="{loc:T Menu.File.NewWhiteboard}" Command="{Binding NewWhiteboardCommand}"/>
                        <MenuItem Header="{loc:T Menu.File.NewText}" Command="{Binding NewTextDocCommand}"/>
                        <Separator/>
                        <MenuItem Header="{loc:T Menu.File.Import}" Command="{Binding ImportDocxCommand}"/>
                        <MenuItem Header="{loc:T Menu.File.Export}" Command="{Binding ExportCommand}"/>
                        <Separator/>
                        <MenuItem Header="{loc:T Menu.File.Save}" Command="{Binding SaveCommand}"
                                  InputGesture="Ctrl+S"/>
                        <MenuItem Header="{loc:T Menu.File.SaveAll}" Command="{Binding SaveAllCommand}"
                                  InputGesture="Ctrl+Shift+S"/>
                        <Separator/>
                        <MenuItem Header="{loc:T Menu.File.Quit}" Command="{Binding ExitCommand}"/>
                    </MenuItem>

                    <MenuItem Header="{loc:T Menu.View}">
                        <MenuItem Header="{loc:T Menu.View.Sidebar}" Click="Seitenleiste_Click"/>
                        <MenuItem Header="{loc:T Menu.View.Theme}" Command="{Binding ToggleThemeCommand}"
                                  InputGesture="Ctrl+T"/>
                        <MenuItem Header="{loc:T Menu.View.Language}">
                            <MenuItem x:Name="SpracheDeutsch" Header="{loc:T Menu.View.Language.German}"
                                      ToggleType="Radio" GroupName="Sprache" Tag="de" Click="Sprache_Click"/>
                            <MenuItem x:Name="SpracheEnglisch" Header="{loc:T Menu.View.Language.English}"
                                      ToggleType="Radio" GroupName="Sprache" Tag="en" Click="Sprache_Click"/>
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Header="{loc:T Menu.Help}">
                        <MenuItem Header="{loc:T Menu.Help.About}" Click="Ueber_Click"/>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <Grid ColumnDefinitions="260,4,*">

            <!-- ===== Seitenleiste ===== -->
            <Border x:Name="Seitenleiste" Grid.Column="0" Background="{DynamicResource Brush.SidebarBg}">
                <DockPanel Margin="10,10,6,10">

                    <!-- App-Titel -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,10" Spacing="8">
                        <Image Source="avares://GonkNote.Avalonia/Assets/gonk-note-Icon.png"
                               Width="22" Height="22" VerticalAlignment="Center"/>
                        <TextBlock Text="Gonk Note" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Schnellzugriff: Neu -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,8">
                        <Button Classes="flach symbol" ToolTip.Tip="{loc:T New.Folder}"
                                Command="{Binding NewFolderCommand}">
                            <Path Classes="symbol" Data="{StaticResource Icon.Folder}"
                                  Stroke="{DynamicResource Brush.Text}"/>
                        </Button>
                        <Button Classes="flach symbol" ToolTip.Tip="{loc:T New.Notebook}"
                                Command="{Binding NewNotebookCommand}">
                            <Path Classes="symbol" Data="{StaticResource Icon.Notebook}"
                                  Stroke="{DynamicResource Brush.Text}"/>
                        </Button>
                        <Button Classes="flach symbol" ToolTip.Tip="{loc:T New.Whiteboard}"
                                Command="{Binding NewWhiteboardCommand}">
                            <Path Classes="symbol" Data="{StaticResource Icon.Whiteboard}"
                                  Stroke="{DynamicResource Brush.Text}"/>
                        </Button>
                        <Button Classes="flach symbol" ToolTip.Tip="{loc:T New.Text}"
                                Command="{Binding NewTextDocCommand}">
                            <Path Classes="symbol" Data="{StaticResource Icon.Text}"
                                  Stroke="{DynamicResource Brush.Text}"/>
                        </Button>
                    </StackPanel>

                    <!-- Schnellzugriff: angepinnte Ordner -->
                    <StackPanel DockPanel.Dock="Top" Margin="2,0,0,6"
                                IsVisible="{Binding PinnedFolders.Count, Converter={StaticResource IstDa}}">
                        <TextBlock Text="{loc:T Sidebar.Pinned}" FontSize="10" FontWeight="SemiBold"
                                   Margin="6,2,0,5" Foreground="{DynamicResource Brush.TextMuted}"/>
                        <ItemsControl ItemsSource="{Binding PinnedFolders}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TreeItemViewModel">
                                    <Button Classes="pinkachel" ToolTip.Tip="{Binding Name}"
                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenPinnedCommand}"
                                            CommandParameter="{Binding}">
                                        <Panel>
                                            <Path Data="{Binding Kind, Converter={StaticResource KindToIcon}}"
                                                  Stroke="{Binding IconColorHex, Converter={StaticResource HexToBrush}}"
                                                  StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round"
                                                  Width="21" Height="21" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Path Data="{StaticResource Icon.Pin}"
                                                  Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.2"
                                                  Width="9" Height="9" Stretch="Uniform"
                                                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,5,0"/>
                                        </Panel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="4,8,4,0"/>
                    </StackPanel>

                    <!-- Fußzeile: Design wechseln -->
                    <Button DockPanel.Dock="Bottom" Classes="flach" HorizontalAlignment="Left"
                            Margin="2,8,0,0" Command="{Binding ToggleThemeCommand}"
                            ToolTip.Tip="{loc:T Sidebar.ThemeTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Classes="symbol" Data="{StaticResource Icon.Design}"
                                  Stroke="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:T Sidebar.SwitchTheme}"
                                       Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Ordnerbaum -->
                    <TreeView x:Name="Baum" ItemsSource="{Binding RootItems}"
                              SelectionChanged="Baum_SelectionChanged"
                              DoubleTapped="Baum_DoubleTapped"
                              KeyDown="Baum_KeyDown">
                        <TreeView.ContextFlyout>
                            <MenuFlyout>
                                <MenuItem Header="{loc:T New.Folder}" Command="{Binding NewFolderCommand}"
                                          CommandParameter="{Binding SelectedTreeItem}"/>
                                <MenuItem Header="{loc:T New.Notebook}" Command="{Binding NewNotebookCommand}"
                                          CommandParameter="{Binding SelectedTreeItem}"/>
                                <MenuItem Header="{loc:T New.Whiteboard}" Command="{Binding NewWhiteboardCommand}"
                                          CommandParameter="{Binding SelectedTreeItem}"/>
                                <MenuItem Header="{loc:T New.Text}" Command="{Binding NewTextDocCommand}"
                                          CommandParameter="{Binding SelectedTreeItem}"/>
                                <Separator/>
                                <MenuItem Header="{loc:T Tree.Open}" Command="{Binding OpenItemCommand}"
                                          CommandParameter="{Binding SelectedTreeItem}"/>
                                <MenuItem Header="{loc:T Tree.Rename}" Command="{Binding RenameCommand}"
                                          CommandParameter="{Binding SelectedTreeItem}"/>
                                <MenuItem Header="{Binding SelectedTreeItem.PinMenuHeader}"
                                          IsVisible="{Binding SelectedTreeItem.IsFolder, FallbackValue=False}"
                                          Command="{Binding TogglePinCommand}"
                                          CommandParameter="{Binding SelectedTreeItem}"/>
                                <MenuItem Header="{Binding SelectedTreeItem.FavoriteMenuHeader}"
                                          IsVisible="{Binding SelectedTreeItem.IsFolder, FallbackValue=False}"
                                          Command="{Binding ToggleFavoriteCommand}"
                                          CommandParameter="{Binding SelectedTreeItem}"/>
                                <MenuItem Header="{loc:T Tree.IconColor}">
                                    <MenuItem Header="{loc:T Tree.IconColor.Auto}" Tag="" Click="Symbolfarbe_Click"/>
                                    <Separator/>
                                    <MenuItem Header="{loc:T Color.Blue}"   Tag="#2563EB" Click="Symbolfarbe_Click"/>
                                    <MenuItem Header="{loc:T Color.Teal}"   Tag="#14B8A6" Click="Symbolfarbe_Click"/>
                                    <MenuItem Header="{loc:T Color.Pink}"   Tag="#EC4899" Click="Symbolfarbe_Click"/>
                                    <MenuItem Header="{loc:T Color.Purple}" Tag="#8B5CF6" Click="Symbolfarbe_Click"/>
                                    <MenuItem Header="{loc:T Color.Red}"    Tag="#EF4444" Click="Symbolfarbe_Click"/>
                                    <MenuItem Header="{loc:T Color.Orange}" Tag="#F97316" Click="Symbolfarbe_Click"/>
                                    <MenuItem Header="{loc:T Color.Yellow}" Tag="#EAB308" Click="Symbolfarbe_Click"/>
                                    <MenuItem Header="{loc:T Color.Green}"  Tag="#22C55E" Click="Symbolfarbe_Click"/>
                                    <MenuItem Header="{loc:T Color.Gray}"   Tag="#94A3B8" Click="Symbolfarbe_Click"/>
                                </MenuItem>
                                <MenuItem Header="{loc:T Tree.Delete}" Command="{Binding DeleteCommand}"
                                          CommandParameter="{Binding SelectedTreeItem}"/>
                            </MenuFlyout>
                        </TreeView.ContextFlyout>

                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="vm:TreeItemViewModel" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,4" Spacing="0">
                                    <Path Data="{Binding Kind, Converter={StaticResource KindToIcon}}"
                                          Stroke="{Binding IconColorHex, Converter={StaticResource HexToBrush}}"
                                          StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round"
                                          Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" Margin="8,0,4,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Text}"
                                               IsVisible="{Binding !IsRenaming}"/>
                                    <Path Data="{StaticResource Icon.Stern}" Fill="#EAB308"
                                          Width="10" Height="10" Stretch="Uniform" Margin="2,0,0,0"
                                          VerticalAlignment="Center" ToolTip.Tip="{loc:T Tree.Favorite}"
                                          IsVisible="{Binding IsFavorite}"/>
                                    <TextBox Text="{Binding Name, Mode=TwoWay}" Margin="6,0,4,0"
                                             MinWidth="110" Padding="4,2" FontSize="13"
                                             IsVisible="{Binding IsRenaming}"
                                             AttachedToVisualTree="Umbenennen_Sichtbar"
                                             LostFocus="Umbenennen_Fokus"
                                             KeyDown="Umbenennen_Taste"/>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns"/>

            <!-- ===== Arbeitsbereich ===== -->
            <Grid Grid.Column="2">

                <!-- „Big Picture"-Galerie: Inhalt des aktuellen Ordners, wenn nichts offen ist -->
                <Grid Background="{DynamicResource Brush.WindowBg}"
                      IsVisible="{Binding OpenTabs.Count, Converter={StaticResource IstLeer}}">
                    <DockPanel Margin="28,18,20,0">

                        <!-- Kopf: Pfadleiste, Zurück + Titel, „Neu" -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,8,14">
                            <StackPanel HorizontalAlignment="Left">
                                <ItemsControl ItemsSource="{Binding Breadcrumb}" Margin="0,0,0,2"
                                              IsVisible="{Binding ShowBreadcrumb}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BreadcrumbEntry">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Classes="pfad" Content="{Binding Label}"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).GalleryNavigateCommand}"
                                                        CommandParameter="{Binding Folder}"/>
                                                <TextBlock Text="&#160;›&#160;" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Classes="flach symbol" ToolTip.Tip="{loc:T Gallery.Back}"
                                            VerticalAlignment="Center" IsVisible="{Binding CanGoBack}"
                                            Command="{Binding GalleryBackCommand}">
                                        <Path Classes="symbol" Data="{StaticResource Icon.Zurueck}"
                                              Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.6"/>
                                    </Button>
                                    <TextBlock Text="{Binding GalleryTitle}" FontSize="26" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Classes="akzent" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Path Data="{StaticResource Icon.Plus}" Stroke="White" StrokeThickness="1.6"
                                          StrokeLineCap="Round" Width="12" Height="12" Stretch="Uniform"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:T Gallery.New}" Foreground="White" VerticalAlignment="Center"/>
                                    <Path Data="{StaticResource Icon.ChevronUnten}" Stroke="White" StrokeThickness="1.6"
                                          StrokeLineCap="Round" Width="9" Height="9" Stretch="Uniform"
                                          VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="{loc:T New.Folder}" Tag="Folder" Click="GalerieNeu_Click"/>
                                        <MenuItem Header="{loc:T New.Notebook}" Tag="Notebook" Click="GalerieNeu_Click"/>
                                        <MenuItem Header="{loc:T New.Whiteboard}" Tag="Whiteboard" Click="GalerieNeu_Click"/>
                                        <MenuItem Header="{loc:T New.Text}" Tag="TextDocument" Click="GalerieNeu_Click"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <!-- Leerer Ordner -->
                        <StackPanel DockPanel.Dock="Top" Margin="2,30,0,0" HorizontalAlignment="Center"
                                    IsVisible="{Binding GalleryItems.Count, Converter={StaticResource IstLeer}}">
                            <Image Source="avares://GonkNote.Avalonia/Assets/gonk-note-Icon.png"
                                   Width="56" Height="56" Opacity="0.7" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:T Gallery.Empty.Title}" FontSize="17" FontWeight="SemiBold"
                                       Margin="0,12,0,4" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="{loc:T Gallery.Empty.Hint}" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>

                        <!-- Kachelraster -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding GalleryItems}" Margin="0,0,0,24">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GalleryItemViewModel">
                                        <Button Classes="kachel"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).GalleryOpenCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel>

                                                <!-- Vorschau -->
                                                <Panel Height="152" Margin="0,4,0,10">

                                                    <!-- Ordner: großes farbiges Symbol -->
                                                    <Path Data="{Binding Kind, Converter={StaticResource KindToIcon}}"
                                                          Stroke="{Binding IconColorHex, Converter={StaticResource HexToBrush}}"
                                                          StrokeThickness="0.7" StrokeLineCap="Round" StrokeJoin="Round"
                                                          Width="118" Height="106" Stretch="Uniform"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          IsVisible="{Binding IsFolder}"/>

                                                    <!-- Notizbuch: Cover-Vorschau -->
                                                    <Border IsVisible="{Binding IsNotebook}"
                                                            Width="112" Height="150" CornerRadius="8" ClipToBounds="True"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            BoxShadow="0 3 12 0 #59000000">
                                                        <Border.Background>
                                                            <MultiBinding Converter="{StaticResource GradientBrush}">
                                                                <Binding Path="CoverGradientStart"/>
                                                                <Binding Path="CoverGradientEnd"/>
                                                            </MultiBinding>
                                                        </Border.Background>
                                                        <Panel>
                                                            <Image Source="{Binding CoverImageData, Converter={StaticResource BytesToImage}}"
                                                                   Stretch="UniformToFill"
                                                                   IsVisible="{Binding HasCoverImage}"/>
                                                            <TextBlock Text="{Binding Name}" Foreground="White"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" TextAlignment="Center" Margin="10"
                                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                       IsVisible="{Binding !HasCoverImage}"/>
                                                        </Panel>
                                                    </Border>

                                                    <!-- Whiteboard: helle Karte mit Punktraster -->
                                                    <Border IsVisible="{Binding IsWhiteboard}"
                                                            Width="150" Height="112" CornerRadius="8" ClipToBounds="True"
                                                            Background="White" BorderBrush="#22000000" BorderThickness="1"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            BoxShadow="0 3 12 0 #4D000000">
                                                        <!-- Punktraster als gekachelte Zeichnung, wie im WPF-Kopf -->
                                                        <Rectangle>
                                                            <Rectangle.Fill>
                                                                <!-- SourceRect/DestinationRect ohne Prozentzeichen heißt in Avalonia
                                                                     **absolut** — genau das ist hier gemeint: eine 15×15-Kachel,
                                                                     unabhängig von der Größe der Karte. -->
                                                                <DrawingBrush TileMode="Tile"
                                                                              SourceRect="0,0,15,15" DestinationRect="0,0,15,15"
                                                                              Stretch="None">
                                                                    <DrawingBrush.Drawing>
                                                                        <GeometryDrawing Brush="#22000000"
                                                                                         Geometry="M2,2 m-1.1,0 a1.1,1.1 0 1,0 2.2,0 a1.1,1.1 0 1,0 -2.2,0"/>
                                                                    </DrawingBrush.Drawing>
                                                                </DrawingBrush>
                                                            </Rectangle.Fill>
                                                        </Rectangle>
                                                    </Border>

                                                    <!-- Textdokument: Blatt mit angedeuteten Zeilen -->
                                                    <Border IsVisible="{Binding IsText}"
                                                            Width="112" Height="150" CornerRadius="4"
                                                            Background="White" BorderBrush="#22000000" BorderThickness="1"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            BoxShadow="0 3 12 0 #4D000000">
                                                        <StackPanel Margin="12,14">
                                                            <TextBlock Text="{Binding Name}" FontSize="9" FontWeight="SemiBold"
                                                                       Foreground="#333333" TextTrimming="CharacterEllipsis"/>
                                                            <Rectangle Height="2" Fill="#E5E5E5" Margin="0,9,0,0"/>
                                                            <Rectangle Height="2" Fill="#E5E5E5" Margin="0,6,0,0"/>
                                                            <Rectangle Height="2" Fill="#E5E5E5" Margin="0,6,8,0"/>
                                                            <Rectangle Height="2" Fill="#E5E5E5" Margin="0,6,0,0"/>
                                                            <Rectangle Height="2" Fill="#E5E5E5" Margin="0,6,14,0"/>
                                                            <Rectangle Height="2" Fill="#E5E5E5" Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Favoritenstern -->
                                                    <Path Data="{StaticResource Icon.Stern}" Fill="#EAB308"
                                                          Width="15" Height="15" Stretch="Uniform"
                                                          HorizontalAlignment="Right" VerticalAlignment="Top"
                                                          Margin="0,2,6,0" IsVisible="{Binding IsFavorite}"/>
                                                </Panel>

                                                <!-- Name + Chevron -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="3">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text}"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               MaxWidth="128" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <Button Classes="flach" Width="20" Height="20" Padding="0"
                                                            ToolTip.Tip="{loc:T Gallery.Options}"
                                                            Click="GalerieMenue_Click">
                                                        <Path Data="{StaticResource Icon.ChevronUnten}"
                                                              Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.5"
                                                              StrokeLineCap="Round" Width="9" Height="9" Stretch="Uniform"/>
                                                        <Button.Flyout>
                                                            <MenuFlyout>
                                                                <MenuItem Header="{loc:T Tree.Open}" Tag="öffnen" Click="GalerieEintrag_Click"/>
                                                                <MenuItem Header="{loc:T Tree.Rename}" Tag="umbenennen" Click="GalerieEintrag_Click"/>
                                                                <MenuItem Header="{loc:T Tree.Delete}" Tag="löschen" Click="GalerieEintrag_Click"/>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </StackPanel>

                                                <TextBlock Text="{Binding DateText}" FontSize="11" Margin="0,2,0,0"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <!-- Registerkarten. **Noch ohne Inhalt** — die Zeichenfläche ist der nächste
                     Brocken; ein geöffnetes Dokument zeigt hier vorerst nur einen Hinweis. -->
                <TabControl ItemsSource="{Binding OpenTabs}"
                            SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                            IsVisible="{Binding OpenTabs.Count, Converter={StaticResource IstDa}}">
                    <TabControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DocumentTabViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding TabHeader}" VerticalAlignment="Center"
                                           MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                <Button Classes="flach" Width="20" Height="20" Padding="0"
                                        ToolTip.Tip="{loc:T Window.CloseTab}"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseTabCommand}"
                                        CommandParameter="{Binding}">
                                    <Path Data="{StaticResource Icon.Schliessen}"
                                          Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.4"
                                          StrokeLineCap="Round" Width="9" Height="9" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:DocumentTabViewModel">
                            <Border Background="{DynamicResource Brush.CardBg}">
                                <TextBlock Text="{loc:T Tab.NoCanvasYet}" TextWrapping="Wrap" MaxWidth="420"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                            </Border>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
