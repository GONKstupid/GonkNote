<Window x:Class="GonkNote.Views.PageSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seite einrichten" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.WindowBg}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource Brush.Text}"
        ShowInTaskbar="False">
    <StackPanel Margin="18">

        <!-- Muster -->
        <TextBlock Text="Muster" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <UniformGrid Columns="4" Margin="0,0,0,14">
            <RadioButton x:Name="BgBlank" Content="Blanko" GroupName="bg" Margin="0,0,8,0"
                         Foreground="{DynamicResource Brush.Text}" VerticalContentAlignment="Center"/>
            <RadioButton x:Name="BgLines" Content="Liniert" GroupName="bg" Margin="0,0,8,0"
                         Foreground="{DynamicResource Brush.Text}" VerticalContentAlignment="Center"/>
            <RadioButton x:Name="BgGrid" Content="Kariert" GroupName="bg" Margin="0,0,8,0"
                         Foreground="{DynamicResource Brush.Text}" VerticalContentAlignment="Center"/>
            <RadioButton x:Name="BgDots" Content="Punktiert" GroupName="bg"
                         Foreground="{DynamicResource Brush.Text}" VerticalContentAlignment="Center"/>
        </UniformGrid>

        <!-- Farbton -->
        <TextBlock Text="Farbton" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <UniformGrid Columns="3" Margin="0,0,0,14">
            <RadioButton x:Name="ShadeAuto" Content="Wie App-Design" GroupName="shade" Margin="0,0,8,0"
                         Foreground="{DynamicResource Brush.Text}" VerticalContentAlignment="Center"/>
            <RadioButton x:Name="ShadeLight" Content="Hell" GroupName="shade" Margin="0,0,8,0"
                         Foreground="{DynamicResource Brush.Text}" VerticalContentAlignment="Center"/>
            <RadioButton x:Name="ShadeDark" Content="Dunkel" GroupName="shade"
                         Foreground="{DynamicResource Brush.Text}" VerticalContentAlignment="Center"/>
        </UniformGrid>

        <!-- Format (nur Notizbuch) -->
        <StackPanel x:Name="SizeSection">
            <TextBlock Text="Format" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <UniformGrid Columns="2" Margin="0,0,0,14">
                <RadioButton x:Name="SizeA4" Content="A4" GroupName="size" Margin="0,0,8,0"
                             Foreground="{DynamicResource Brush.Text}" VerticalContentAlignment="Center"/>
                <RadioButton x:Name="SizeA3" Content="A3" GroupName="size"
                             Foreground="{DynamicResource Brush.Text}" VerticalContentAlignment="Center"/>
            </UniformGrid>

            <TextBlock Text="Ausrichtung" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <UniformGrid Columns="2" Margin="0,0,0,14">
                <RadioButton x:Name="OrientPortrait" Content="Hochformat" GroupName="orient" Margin="0,0,8,0"
                             Foreground="{DynamicResource Brush.Text}" VerticalContentAlignment="Center"/>
                <RadioButton x:Name="OrientLandscape" Content="Querformat" GroupName="orient"
                             Foreground="{DynamicResource Brush.Text}" VerticalContentAlignment="Center"/>
            </UniformGrid>

            <CheckBox x:Name="AsDefault" Content="Als Standard für neue Seiten verwenden"
                      Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,4" IsChecked="True"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Abbrechen" Style="{StaticResource FlatButton}" MinWidth="90"
                    IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Übernehmen" Style="{StaticResource AccentButton}" MinWidth="110"
                    Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
