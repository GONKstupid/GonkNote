<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GonkNote.Views"
             xmlns:loc="clr-namespace:GonkNote.Services"
             xmlns:vm="clr-namespace:GonkNote.ViewModels;assembly=GonkNote.ViewModels"
             x:Class="GonkNote.Views.TextDocView"
             x:DataType="vm:TextTabViewModel">

    <!-- Die Anzeige eines Textdokuments im Linux-Kopf (HANDOFF §4.28, §4.35).

         Gezeichnet wird von `TdRenderer` aus Core, umbrochen von `TdLayout` — derselbe Weg,
         den der PDF-Export nimmt (§4.27), und deshalb steht auf dem Schirm buchstäblich das,
         was ins PDF ginge. **Seit Schritt 5 des Schreibens nimmt sie Eingaben entgegen**
         (TextDocView.Eingabe.cs); was weiterhin fehlt, sind die Formate, und das steht als
         Satz im Ribbon statt als halber Knopf darin (§7).

         Der Aufbau folgt dem WPF-Gegenstück (src/GonkNote.Wpf/Views/TextEditorView.xaml):
         Ribbon oben mit Reiterleiste, Blätterbereich in der Mitte, Seitenleiste unten. -->

    <DockPanel>

        <!-- ==================== Ribbon ==================== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.ToolbarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <StackPanel>

                <!-- Reiterleiste. **Nur die zwei Reiter, die Inhalt haben.** „Einfügen",
                     „Verweise" und „Tabelle" gibt es drüben, weil man dort schreiben kann;
                     hier wären es drei leere Flächen — ein halbes Feature ist schlechter als
                     ein fehlendes, weil niemand ihm ansieht, dass es halb ist (§4.12). -->
                <DockPanel>
                    <!-- **„Nur Ansicht" ist seit Schritt 5 falsch** (§4.35): getippt wird
                         hier. Was weiterhin fehlt, sind die Formate — und das steht als Satz
                         da und nicht als ausgegrauter Knopf. Die drei fehlenden Reiter kommen
                         mit Schritt 6, und erst dann stünden sie nicht leer da. -->
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                               Margin="0,0,14,0" FontSize="11.5"
                               Text="{loc:T Ed.TextOnly}"
                               ToolTip.Tip="{loc:T Ed.TextOnly.Tip}"
                               Foreground="{DynamicResource Brush.TextMuted}"/>

                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                        <RadioButton x:Name="ReiterStart" Classes="ribbonreiter" GroupName="ribbon"
                                     Content="{loc:T Ed.Tab.Home}" IsChecked="True"
                                     IsCheckedChanged="Reiter_Gewechselt" Tag="Start"/>
                        <RadioButton x:Name="ReiterEinfuegen" Classes="ribbonreiter" GroupName="ribbon"
                                     Content="{loc:T Ed.Tab.Insert}"
                                     IsCheckedChanged="Reiter_Gewechselt" Tag="Einfuegen"/>
                        <RadioButton x:Name="ReiterLayout" Classes="ribbonreiter" GroupName="ribbon"
                                     Content="{loc:T Ed.Tab.Layout}"
                                     IsCheckedChanged="Reiter_Gewechselt" Tag="Layout"/>
                        <RadioButton x:Name="ReiterVerweise" Classes="ribbonreiter" GroupName="ribbon"
                                     Content="{loc:T Ed.Tab.References}"
                                     IsCheckedChanged="Reiter_Gewechselt" Tag="Verweise"/>
                        <RadioButton x:Name="ReiterTabelle" Classes="ribbonreiter" GroupName="ribbon"
                                     Content="{loc:T Ed.Tab.Table}"
                                     IsCheckedChanged="Reiter_Gewechselt" Tag="Tabelle"/>
                    </StackPanel>
                </DockPanel>

                <!-- ============ Reiter „Start": Format, Ansicht und Ausgabe ============ -->
                <WrapPanel x:Name="LeisteStart" Margin="8,2,8,6">

                    <!-- Absatzvorlage (§4.39). **Die Tabelle steht in Core** (`TdStil`), damit
                         beide Köpfe dieselben Überschriften setzen — dieselbe Lage wie bei
                         Farben (§4.9), Schriften (§4.26) und Symbolen (§4.31), zum vierten Mal.
                         Die Einträge entstehen im Code, weil sie aus der Tabelle kommen. -->
                    <ComboBox x:Name="VorlageWahl" Width="150" VerticalAlignment="Center"
                              FontSize="12" SelectionChanged="Vorlage_Gewechselt"
                              ToolTip.Tip="{loc:T Ed.Styles}"/>

                    <Border Classes="trenner"/>

                    <!-- Zeichenformat (Schritt 6, HANDOFF §6).
                         **F, K, U, S als Buchstaben und nicht als Symbole** — dieselbe Wahl wie
                         im WPF-Ribbon, und sie ist keine Sparsamkeit: Ein „F" in Fett zeigt, was
                         der Knopf tut, ohne dass jemand ein Symbol dafür lernen müsste.

                         Sie sind **dreiwertig** (`IsThreeState`): Über einer Auswahl aus fettem
                         und magerem Text ist die Antwort weder ja noch nein, und ein Knopf, der
                         sich dann für eine der beiden entscheidet, behauptet etwas Falsches
                         (`TdFormatEdit.Gemeinsam`). Umgeschaltet wird trotzdem in zwei Stufen —
                         das besorgt `Schalter_Geklickt`, nicht der Schalter selbst. -->
                    <ToggleButton x:Name="SchalterFett" Classes="ribbonschalter" IsThreeState="True"
                                  Click="Fett_Click" ToolTip.Tip="{loc:T Ed.Bold}">
                        <TextBlock Text="F" FontWeight="Bold"/>
                    </ToggleButton>
                    <ToggleButton x:Name="SchalterKursiv" Classes="ribbonschalter" IsThreeState="True"
                                  Click="Kursiv_Click" ToolTip.Tip="{loc:T Ed.Italic}">
                        <TextBlock Text="K" FontStyle="Italic"/>
                    </ToggleButton>
                    <ToggleButton x:Name="SchalterUnterstrichen" Classes="ribbonschalter" IsThreeState="True"
                                  Click="Unterstrichen_Click" ToolTip.Tip="{loc:T Ed.Underline}">
                        <TextBlock Text="U" TextDecorations="Underline"/>
                    </ToggleButton>
                    <ToggleButton x:Name="SchalterDurchgestrichen" Classes="ribbonschalter" IsThreeState="True"
                                  Click="Durchgestrichen_Click" ToolTip.Tip="{loc:T Ed.Strike}">
                        <TextBlock Text="S" TextDecorations="Strikethrough"/>
                    </ToggleButton>
                    <ToggleButton x:Name="SchalterTief" Classes="ribbonschalter" IsThreeState="True"
                                  Click="Tief_Click" ToolTip.Tip="{loc:T Ed.Subscript}" Content="x₂"/>
                    <ToggleButton x:Name="SchalterHoch" Classes="ribbonschalter" IsThreeState="True"
                                  Click="Hoch_Click" ToolTip.Tip="{loc:T Ed.Superscript}" Content="x²"/>

                    <Border Classes="trenner"/>

                    <!-- Schriftart (§4.40). **Die Liste zeigt die mitgelieferten Familien und
                         nicht die des Systems**, und das ist genau der Punkt aus §4.26: Eine
                         Systemschrift gibt es auf dem nächsten Rechner nicht, und dasselbe
                         Dokument sähe dort anders aus. `Fonts.Mitgeliefert` ist deshalb der
                         richtige Bestand — die Naht, die §4.36 hier noch vermisst hat, war
                         bereits da. Die Einträge entstehen im Code, weil sie aus der Tabelle
                         kommen. -->
                    <ComboBox x:Name="SchriftWahl" Width="170" VerticalAlignment="Center"
                              FontSize="12" SelectionChanged="Schrift_Gewechselt"
                              ToolTip.Tip="{loc:T Ed.Font}"/>

                    <!-- Schriftgröße. -->
                    <Button Classes="flach symbol" Click="Kleiner_Click" ToolTip.Tip="{loc:T Ed.FontShrink}">
                        <views:Symbol Icon="FontShrink" Stroke="{DynamicResource Brush.Text}"/>
                    </Button>
                    <!-- **Eine Liste statt einer Anzeige** (§4.39): Bis dahin stand hier die
                         geltende Größe als toter Text, und wer 24 wollte, musste sich siebenmal
                         hochklicken. Die Stufenknöpfe bleiben trotzdem — sie sind der schnelle
                         Weg, wenn man nicht weiß, welche Zahl man will. -->
                    <ComboBox x:Name="GroesseWahl" Width="96" VerticalAlignment="Center"
                              FontSize="12" SelectionChanged="Groesse_Gewechselt"
                              ToolTip.Tip="{loc:T Ed.FontSize}"/>
                    <Button Classes="flach symbol" Click="Groesser_Click" ToolTip.Tip="{loc:T Ed.FontGrow}">
                        <views:Symbol Icon="FontGrow" Stroke="{DynamicResource Brush.Text}"/>
                    </Button>

                    <Border Classes="trenner"/>

                    <!-- Schriftfarbe und Hervorhebung (§4.40). **Kacheln statt Farbrad**, wie
                         auf der Zeichenfläche: Die Tabelle steht in Core (`TdTextfarben`), und
                         die Tintenfarben sind dieselben — wer auf dem Whiteboard rot schreibt,
                         sucht im Textdokument dasselbe Rot. Der erste Eintrag nimmt die Farbe
                         wieder **heraus**, statt Schwarz bzw. Weiß hineinzuschreiben. -->
                    <Button x:Name="KnopfSchriftfarbe" Classes="ribbonknopf"
                            ToolTip.Tip="{loc:T Ed.TextColor.Pick}">
                        <StackPanel Orientation="Vertical" Spacing="1">
                            <TextBlock Text="A" FontWeight="SemiBold" FontSize="13"
                                       HorizontalAlignment="Center"/>
                            <Border x:Name="SchriftfarbeBalken" Height="3" Width="16"
                                    CornerRadius="1" Background="{DynamicResource Brush.Text}"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <WrapPanel x:Name="SchriftfarbenFeld" Width="196"/>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="KnopfHervorhebung" Classes="ribbonknopf"
                            ToolTip.Tip="{loc:T Ed.Highlight.Pick}">
                        <StackPanel Orientation="Vertical" Spacing="1">
                            <views:Symbol Icon="Highlighter" Size="13"
                                          Stroke="{DynamicResource Brush.Text}"/>
                            <Border x:Name="HervorhebungBalken" Height="3" Width="16"
                                    CornerRadius="1" Background="#FDE047"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <WrapPanel x:Name="HervorhebungFeld" Width="196"/>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Border Classes="trenner"/>

                    <!-- Absatzformat.
                         Vier Ausrichtungen als Gruppe: **genau eine gilt**, und ein Ribbon, das
                         das als vier voneinander unabhängige Schalter zeigte, ließe sich in
                         einen Zustand bringen, den es im Dokument nicht gibt. -->
                    <ToggleButton x:Name="SchalterLinks" Classes="ribbonschalter"
                                  Click="Ausrichten_Click" Tag="Left" ToolTip.Tip="{loc:T Ed.Align.Left}">
                        <views:Symbol Icon="AlignLeft"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="SchalterMitte" Classes="ribbonschalter"
                                  Click="Ausrichten_Click" Tag="Center" ToolTip.Tip="{loc:T Ed.Align.Center}">
                        <views:Symbol Icon="AlignCenter"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="SchalterRechts" Classes="ribbonschalter"
                                  Click="Ausrichten_Click" Tag="Right" ToolTip.Tip="{loc:T Ed.Align.Right}">
                        <views:Symbol Icon="AlignRight"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="SchalterBlock" Classes="ribbonschalter"
                                  Click="Ausrichten_Click" Tag="Justify" ToolTip.Tip="{loc:T Ed.Align.Justify}">
                        <views:Symbol Icon="AlignJustify"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>

                    <!-- Aufzählung und Nummerierung (§4.39). Zwei Schalter, nicht einer mit zwei
                         Zuständen: Ein Absatz kann keins von beidem sein, und das ist der
                         häufigste Zustand. -->
                    <ToggleButton x:Name="SchalterPunkte" Classes="ribbonschalter"
                                  Click="Aufzaehlung_Click" ToolTip.Tip="{loc:T Ed.List.Bullet}">
                        <views:Symbol Icon="List"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="SchalterNummern" Classes="ribbonschalter"
                                  Click="Nummerierung_Click" ToolTip.Tip="{loc:T Ed.List.Number}"
                                  Content="№"/>

                    <Button Classes="flach symbol" Click="EinzugRaus_Click" ToolTip.Tip="{loc:T Ed.Indent.Less}">
                        <views:Symbol Icon="IndentDecrease" Stroke="{DynamicResource Brush.Text}"/>
                    </Button>
                    <Button Classes="flach symbol" Click="EinzugRein_Click" ToolTip.Tip="{loc:T Ed.Indent.More}">
                        <views:Symbol Icon="IndentIncrease" Stroke="{DynamicResource Brush.Text}"/>
                    </Button>

                    <Border Classes="trenner"/>

                    <!-- Suchen & Ersetzen, neu in Phase 5, Schritt ①c (§4.80). Es fehlte in
                         diesem Kopf **ganz** — anders als Tafel-Export (§4.77) und
                         Formen-Stift (§4.78) lag der Code aber zu Recht drüben: er steht auf
                         TextPointer/TextRange, und die gibt es nur unter Windows. Die Suche
                         ist deshalb in Core **neu gegen das Modell** geschrieben
                         (`TdSuche`), nicht umgezogen. -->
                    <ToggleButton x:Name="KnopfSuchen" Classes="ribbonknopf"
                                  ToolTip.Tip="{loc:T Ed.Find.Tip}"
                                  IsCheckedChanged="SuchleisteUmschalten">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <views:Symbol Icon="Search" Stroke="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="{loc:T Ed.Find}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <Button x:Name="KnopfExport" Classes="ribbonknopf"
                            ToolTip.Tip="{loc:T Ed.Export.Tip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <views:Symbol Icon="Export"
                                  Stroke="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="{loc:T Ed.Export}" VerticalAlignment="Center"/>
                            <views:Symbol Icon="ChevronDown" Size="10"
                                  Stroke="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="{loc:T Filter.Pdf}" Tag=".pdf" Click="Export_Click"/>
                                <MenuItem Header="{loc:T Filter.Word}" Tag=".docx" Click="Export_Click"/>
                                <MenuItem Header="{loc:T Filter.Markdown}" Tag=".md" Click="Export_Click"/>
                                <MenuItem Header="{loc:T Filter.Png}" Tag=".png" Click="Export_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                </WrapPanel>

                <!-- ============ Reiter „Einfügen" ============ -->
                <!-- Was hier steht, kann Core seit §4.37 wirklich: Blöcke einfügen
                     (`TdBlockEdit`) und Felder als Stücke (`TdEdit.Ersetzen`). **Bilder fehlen
                     und stehen deshalb nicht da** — sie brauchen den Blob-Speicher und einen
                     Dateidialog, das ist Phase 4.5 (§6). -->
                <WrapPanel x:Name="LeisteEinfuegen" Margin="8,2,8,6" IsVisible="False">

                    <Button Classes="ribbonknopf" Click="Seitenumbruch_Click"
                            ToolTip.Tip="{loc:T Ed.Break.Page.Tip}">
                        <TextBlock Text="{loc:T Ed.Break.Page}" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="ribbonknopf" Click="Zeilenumbruch_Click"
                            ToolTip.Tip="{loc:T Ed.Break.Line.Tip}">
                        <TextBlock Text="{loc:T Ed.Break.Line}" VerticalAlignment="Center"/>
                    </Button>
                    <!-- Trennlinie (§4.40) — ein leerer Absatz mit Unterstrich, kein eigener
                         Blocktyp; die Begründung steht bei `TdBlockEdit.Trennlinie`. -->
                    <Button Classes="ribbonknopf" Click="Trennlinie_Click">
                        <TextBlock Text="{loc:T Ed.Rule}" VerticalAlignment="Center"/>
                    </Button>

                    <Border Classes="trenner"/>

                    <!-- Tabelle. **Die Größe steht im Flyout und nicht in der Leiste** (§4.38):
                         Eine Werkzeugleiste trägt Werkzeuge, keine Einstellungen zu ihnen — zwei
                         Zahlenfelder, die dauerhaft danebenstehen, sind eine Einstellung, die
                         man neunundneunzig Mal sieht und einmal braucht. Drüben löst es ein
                         Raster zum Aufziehen; zwei Zahlen sagen dasselbe und hängen nicht an
                         einem Schwebe-Zustand. -->
                    <Button Classes="ribbonknopf" ToolTip.Tip="{loc:T Ed.Table.Insert}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <views:Symbol Icon="Table" Stroke="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="{loc:T Ed.Table.Insert}" VerticalAlignment="Center"/>
                            <views:Symbol Icon="ChevronDown" Size="10"
                                          Stroke="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Width="220" Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                                          ColumnSpacing="8" RowSpacing="6">
                                        <TextBlock Grid.Row="0" Grid.Column="0" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Text="{loc:T Ed.Table.Rows}"/>
                                        <NumericUpDown Grid.Row="0" Grid.Column="1"
                                                       x:Name="TabelleZeilen" Value="2" Minimum="1"
                                                       Maximum="50" Increment="1" FormatString="0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Text="{loc:T Ed.Table.Columns}"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="1"
                                                       x:Name="TabelleSpalten" Value="2" Minimum="1"
                                                       Maximum="20" Increment="1" FormatString="0"/>
                                    </Grid>
                                    <Button Classes="ribbonknopf" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Click="TabelleEinfuegen_Click"
                                            Content="{loc:T Ed.Table.Insert}"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Border Classes="trenner"/>

                    <Button Classes="ribbonknopf" ToolTip.Tip="{loc:T Ed.Field.Tip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{loc:T Ed.Field}" VerticalAlignment="Center"/>
                            <views:Symbol Icon="ChevronDown" Size="10"
                                          Stroke="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="{loc:T Ed.Field.PageNumber}" Tag="PageNumber"
                                          Click="Feld_Click"/>
                                <MenuItem Header="{loc:T Ed.Field.PageCount}" Tag="PageCount"
                                          Click="Feld_Click"/>
                                <MenuItem Header="{loc:T Ed.Field.Date}" Tag="Date"
                                          Click="Feld_Click"/>
                                <MenuItem Header="{loc:T Ed.Field.Title}" Tag="Title"
                                          Click="Feld_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </WrapPanel>

                <!-- ============ Reiter „Layout" ============ -->
                <!-- **Seit §4.38 wird hier gestellt und nicht mehr nur abgelesen.** Was oft
                     gebraucht wird, steht in der Leiste (Format, Ausrichtung); was selten
                     gebraucht wird und viele Zahlen hat, wandert in die **Seitenleiste rechts**
                     — genau die Aufteilung des WPF-Kopfs („Detaileinstellungen wandern in die
                     Seitenleiste rechts"). Damit steht in der Werkzeugleiste kein Zahlenfeld
                     mehr. -->
                <WrapPanel x:Name="LeisteLayout" Margin="8,2,8,6" IsVisible="False">
                    <TextBlock Text="{loc:T Ed.Layout.Format}" VerticalAlignment="Center"
                               FontSize="12" Margin="0,0,6,0"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                    <ComboBox x:Name="FormatWahl" Width="120" VerticalAlignment="Center"
                              FontSize="12" SelectionChanged="Papierformat_Gewechselt"
                              ToolTip.Tip="{loc:T Ed.Layout.PaperSize}">
                        <ComboBoxItem Content="A4" Tag="A4"/>
                        <ComboBoxItem Content="A5" Tag="A5"/>
                        <ComboBoxItem Content="A3" Tag="A3"/>
                        <ComboBoxItem Content="{loc:T Ed.Layout.Letter}" Tag="Letter"/>
                    </ComboBox>

                    <ToggleButton x:Name="SchalterHoch2" Classes="ribbonschalter" Margin="8,0,0,0"
                                  Click="Ausrichtung_Click" Tag="P"
                                  ToolTip.Tip="{loc:T Ed.Layout.Portrait}"
                                  Content="{loc:T Ed.Layout.Portrait.Short}"/>
                    <ToggleButton x:Name="SchalterQuer" Classes="ribbonschalter"
                                  Click="Ausrichtung_Click" Tag="L"
                                  ToolTip.Tip="{loc:T Ed.Layout.Landscape}"
                                  Content="{loc:T Ed.Layout.Landscape.Short}"/>

                    <Border Classes="trenner"/>

                    <Button Classes="ribbonknopf" Click="Raender_Click"
                            ToolTip.Tip="{loc:T Ed.Layout.Margins.Tip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <views:Symbol Icon="Margins" Stroke="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="{loc:T Ed.Layout.Margins}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="ribbonknopf" Click="Abstaende_Click"
                            ToolTip.Tip="{loc:T Ed.Layout.Spacing.Tip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <views:Symbol Icon="LineSpacing" Stroke="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="{loc:T Ed.Layout.Spacing}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Classes="trenner"/>

                    <!-- **Aus der Auskunft ist mit §4.40 ein Knopf geworden.** Was dasteht,
                         sagt weiterhin, was gilt — jetzt lässt es sich auch stellen. -->
                    <Button Classes="ribbonknopf" Click="KopfFuss_Click"
                            ToolTip.Tip="{loc:T Ed.HeaderFooter}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <views:Symbol Icon="TextDocument" Stroke="{DynamicResource Brush.Text}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Classes="feldname" Text="{loc:T Ed.HeaderFooter}"/>
                                <TextBlock x:Name="FeldKopfFuss" Classes="feldwert"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- ============ Reiter „Verweise" ============ -->
                <!-- **Das Ziel steht als Feld in der Leiste und nicht in einem Dialog.** Der
                     WPF-Kopf fragt es in einem Fenster ab; dafür fehlt der Naht ein Handgriff
                     („frag nach Text"), und einen in die Plattformschnittstelle zu ziehen wäre
                     für einen Verweis viel — ein Feld im Ribbon tut dasselbe, zeigt beim
                     Hineinklicken das vorhandene Ziel und macht aus „einfügen" und „bearbeiten"
                     denselben Handgriff. -->
                <WrapPanel x:Name="LeisteVerweise" Margin="8,2,8,6" IsVisible="False">

                    <TextBlock Text="{loc:T Ed.Link.Target}" VerticalAlignment="Center"
                               FontSize="12" Margin="0,0,6,0"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBox x:Name="VerweisZiel" Width="280" VerticalAlignment="Center"
                             FontSize="12" PlaceholderText="https://"
                             ToolTip.Tip="{loc:T Ed.Link.Target.Tip}"
                             KeyDown="VerweisZiel_Taste"/>
                    <Button x:Name="KnopfVerweisSetzen" Classes="ribbonknopf" Margin="4,0,0,0"
                            Click="VerweisSetzen_Click" ToolTip.Tip="{loc:T Ed.Link.Tip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <views:Symbol Icon="Link" Stroke="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="{loc:T Ed.Link.Set}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="KnopfVerweisWeg" Classes="ribbonknopf"
                            Click="VerweisEntfernen_Click">
                        <TextBlock Text="{loc:T Ed.Link.Remove}" VerticalAlignment="Center"/>
                    </Button>

                    <Border Classes="trenner"/>

                    <Button Classes="ribbonknopf" Click="Inhaltsverzeichnis_Click"
                            ToolTip.Tip="{loc:T Ed.Toc.Insert.Tip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <views:Symbol Icon="Outline" Stroke="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="{loc:T Ed.Toc.Insert}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- **Der Hinweis steht hinter einem „i" und nicht als Fließtext daneben**
                         (§4.38, wie im WPF-Kopf): Ein Satz, der immer dasteht, wird nach dem
                         dritten Mal nicht mehr gelesen und nimmt der Leiste die Hälfte ihrer
                         Breite. Er erscheint beim Schweben **und** beim Anklicken — Schweben
                         allein hilft dem nicht, der mit dem Stift arbeitet. -->
                    <Button Classes="flach symbol" ToolTip.Tip="{loc:T Ed.References.Note}"
                            ToolTip.ShowDelay="150"
                            ToolTip.Placement="BottomEdgeAlignedLeft">
                        <views:Symbol Icon="Info" Stroke="{DynamicResource Brush.TextMuted}"/>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <TextBlock Text="{loc:T Ed.References.Note}" TextWrapping="Wrap"
                                           MaxWidth="360" FontSize="12"/>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </WrapPanel>

                <!-- ============ Reiter „Tabelle" ============ -->
                <!-- **Die Knöpfe verschwinden, wenn die Marke in keiner Tabelle steht** — dann
                     steht dort ein Satz, der sagt, wie man hinkommt. Ausgraute Knöpfe wären die
                     Fläche aus §4.28; ein Satz beantwortet die Frage, die der Nutzer in dem
                     Moment wirklich hat.
                     **Zellen verbinden und teilen fehlen und stehen deshalb nicht da** — sie
                     verlangen eine Antwort darauf, was mit dem Inhalt der aufgehenden Zellen
                     geschieht (§4.37). -->
                <WrapPanel x:Name="LeisteTabelle" Margin="8,2,8,6" IsVisible="False">

                    <TextBlock x:Name="TabelleHinweis" Text="{loc:T Ed.Table.NotInTable}"
                               VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                               MaxWidth="520"
                               Foreground="{DynamicResource Brush.TextMuted}"/>

                    <StackPanel x:Name="TabelleWerkzeuge" Orientation="Horizontal"
                                IsVisible="False">
                        <Button Classes="ribbonknopf" Click="ZeileDarueber_Click">
                            <TextBlock Text="{loc:T Ed.Table.Row.Above}" VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="ribbonknopf" Click="ZeileDarunter_Click">
                            <TextBlock Text="{loc:T Ed.Table.Row.Below}" VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="ribbonknopf" Click="SpalteLinks_Click">
                            <TextBlock Text="{loc:T Ed.Table.Column.Left}" VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="ribbonknopf" Click="SpalteRechts_Click">
                            <TextBlock Text="{loc:T Ed.Table.Column.Right}" VerticalAlignment="Center"/>
                        </Button>

                        <Border Classes="trenner"/>

                        <Button x:Name="KnopfZeileWeg" Classes="ribbonknopf" Click="ZeileWeg_Click">
                            <TextBlock Text="{loc:T Ed.Table.Row.Delete}" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="KnopfSpalteWeg" Classes="ribbonknopf" Click="SpalteWeg_Click">
                            <TextBlock Text="{loc:T Ed.Table.Column.Delete}" VerticalAlignment="Center"/>
                        </Button>
                        <Button Classes="ribbonknopf" Click="TabelleWeg_Click">
                            <TextBlock Text="{loc:T Ed.Table.Delete}" VerticalAlignment="Center"/>
                        </Button>

                        <!-- <inheritdoc/> — dasselbe „i" wie im Reiter „Verweise". -->
                        <Button Classes="flach symbol" ToolTip.Tip="{loc:T Ed.Table.Note}"
                                ToolTip.ShowDelay="150"
                                ToolTip.Placement="BottomEdgeAlignedLeft">
                            <views:Symbol Icon="Info" Stroke="{DynamicResource Brush.TextMuted}"/>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <TextBlock Text="{loc:T Ed.Table.Note}" TextWrapping="Wrap"
                                               MaxWidth="360" FontSize="12"/>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </WrapPanel>

                <!-- ============ Die Warnung, wenn das Altformat noch führt ============ -->
            </StackPanel>
        </Border>

        <!-- ==================== Einstellungs-Seitenleiste (rechts) ==================== -->
        <!-- **Sie trägt, was nicht in eine Werkzeugleiste gehört** (§4.38): viele Zahlen, selten
             gebraucht, mit Beschriftung. Dasselbe Muster wie im WPF-Kopf (`SettingsPanel`) —
             und derselbe Grund: Eine Werkzeugleiste trägt Werkzeuge; Einstellungen zu ihnen
             machen sie unlesbar und stehen dann neunundneunzigmal da, wenn man sie einmal
             braucht.

             **Sichtbar ist immer nur der Abschnitt, den man geöffnet hat** — wer auf „Ränder"
             drückt, will Ränder sehen und nicht eine Liste aller Möglichkeiten. -->
        <!-- **280 und nicht 248 wie drüben:** Ein `NumericUpDown` trägt zwei Spinner-Knöpfe, und
             die fressen die Breite, bevor die Zahl drankommt (§4.38, derselbe Fund zweimal). Der
             WPF-Kopf kommt mit 248 aus, weil er dort schlichte Textfelder benutzt. -->
        <Border x:Name="Einstellungen" DockPanel.Dock="Right" Width="280" IsVisible="False"
                Background="{DynamicResource Brush.SidebarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="12,10,8,6">
                    <TextBlock x:Name="EinstellungenTitel" FontWeight="SemiBold" FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text}"/>
                    <Button Classes="flach symbol" HorizontalAlignment="Right"
                            Click="EinstellungenZu_Click" ToolTip.Tip="{loc:T Window.Close}">
                        <views:Symbol Icon="Close" Size="12"
                                      Stroke="{DynamicResource Brush.TextMuted}"/>
                    </Button>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0,12,12" Spacing="10">

                        <!-- Seitenränder. -->
                        <StackPanel x:Name="AbschnittRaender" IsVisible="False" Spacing="6">
                            <!-- **Untereinander und nicht zu zweit nebeneinander.** Vier Felder
                                 in zwei Spalten passen in 280 Pixel nicht: Was übrig bleibt,
                                 reicht für die Spinner-Knöpfe und nicht mehr für die Zahl. -->
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnSpacing="8" RowSpacing="6">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="feldname"
                                           VerticalAlignment="Center" Text="{loc:T Ed.Margins.Left}"/>
                                <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="RandLinks"
                                               Minimum="0" Maximum="10" Increment="0.5"
                                               FormatString="0.0#" ValueChanged="Rand_Geaendert"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="feldname"
                                           VerticalAlignment="Center" Text="{loc:T Ed.Margins.Top}"/>
                                <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="RandOben"
                                               Minimum="0" Maximum="10" Increment="0.5"
                                               FormatString="0.0#" ValueChanged="Rand_Geaendert"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="feldname"
                                           VerticalAlignment="Center" Text="{loc:T Ed.Margins.Right}"/>
                                <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="RandRechts"
                                               Minimum="0" Maximum="10" Increment="0.5"
                                               FormatString="0.0#" ValueChanged="Rand_Geaendert"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Classes="feldname"
                                           VerticalAlignment="Center" Text="{loc:T Ed.Margins.Bottom}"/>
                                <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="RandUnten"
                                               Minimum="0" Maximum="10" Increment="0.5"
                                               FormatString="0.0#" ValueChanged="Rand_Geaendert"/>
                            </Grid>
                            <TextBlock Classes="feldname" Text="{loc:T Ed.Margins.Unit}"/>
                            <TextBlock Classes="feldname" TextWrapping="Wrap"
                                       Text="{loc:T Ed.Page.NoUndo}"/>
                        </StackPanel>

                        <!-- Absatzabstände. -->
                        <StackPanel x:Name="AbschnittAbstaende" IsVisible="False" Spacing="6">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="6" RowSpacing="6">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="feldname"
                                           VerticalAlignment="Center" Text="{loc:T Ed.Spacing.Before}"/>
                                <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="AbstandDavor"
                                               Width="150" Minimum="0" Maximum="200" Increment="2"
                                               FormatString="0.#" ValueChanged="Abstand_Geaendert"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="feldname"
                                           VerticalAlignment="Center" Text="{loc:T Ed.Spacing.After}"/>
                                <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="AbstandDanach"
                                               Width="150" Minimum="0" Maximum="200" Increment="2"
                                               FormatString="0.#" ValueChanged="Abstand_Geaendert"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="feldname"
                                           VerticalAlignment="Center" Text="{loc:T Ed.Spacing.Line}"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="Zeilenabstand"
                                          Width="150" FontSize="12"
                                          SelectionChanged="Zeilenabstand_Gewechselt">
                                    <ComboBoxItem Content="1,0" Tag="1.0"/>
                                    <ComboBoxItem Content="1,15" Tag="1.15"/>
                                    <ComboBoxItem Content="1,5" Tag="1.5"/>
                                    <ComboBoxItem Content="2,0" Tag="2.0"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock Classes="feldname" Text="{loc:T Ed.Spacing.Unit}"/>
                            <TextBlock Classes="feldname" TextWrapping="Wrap"
                                       Text="{loc:T Ed.Spacing.Scope}"/>
                        </StackPanel>

                        <!-- Kopf- und Fußzeile (§4.40). Sie gehören zum Abschnitt wie die
                             Ränder und stehen deshalb ebenso wenig im Verlauf. -->
                        <StackPanel x:Name="AbschnittKopfFuss" IsVisible="False" Spacing="6">
                            <TextBlock Classes="feldname" Text="{loc:T Ed.HeaderFooter.Header}"/>
                            <TextBox x:Name="KopfzeileFeld" FontSize="12"
                                     LostFocus="KopfFuss_Geaendert" KeyDown="KopfFuss_Taste"/>
                            <TextBlock Classes="feldname" Text="{loc:T Ed.HeaderFooter.Footer}"/>
                            <TextBox x:Name="FusszeileFeld" FontSize="12"
                                     LostFocus="KopfFuss_Geaendert" KeyDown="KopfFuss_Taste"/>
                            <CheckBox x:Name="ErsteSeiteOhne" FontSize="12"
                                      Content="{loc:T Ed.HeaderFooter.SuppressFirst}"
                                      IsCheckedChanged="ErsteSeiteOhne_Geaendert"/>
                            <!-- Dieselben drei Zeilen wie im Kopf-/Fusszeilen-Dialog des
                                 WPF-Kopfs (§4.74). Bis dahin stand hier nur der kurze
                                 Hinweis zu {SEITE} und {SEITEN}, und die zwei anderen
                                 Platzhalter kannte nur, wer drueben nachsah. -->
                            <TextBlock Classes="feldname" TextWrapping="Wrap"
                                       Text="{loc:T Ed.HeaderFooter.Fields}"/>
                            <TextBlock Classes="feldname" TextWrapping="Wrap"
                                       Text="{loc:T Ed.HeaderFooter.Fields2}"/>
                            <TextBlock Classes="feldname" TextWrapping="Wrap"
                                       Text="{loc:T Ed.HeaderFooter.Example}"/>
                            <TextBlock Classes="feldname" TextWrapping="Wrap"
                                       Text="{loc:T Ed.Page.NoUndo}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ==================== Statusleiste unten ==================== -->
        <!-- **Alles, was die Ansicht betrifft und nicht das Dokument, steht hier** — Zählung,
             Seitenzahl, Zoom und die zwei Einpassungen. Bis §4.38 saßen Zoom, Seitenbreite,
             Ganze Seite und die Zählung im Reiter „Start" (§4.28); dort waren sie
             **Einstellungen zwischen Werkzeugen**, und der Reiter, der Text formatiert, trug
             drei Knöpfe, die den Text nicht anfassen. Der WPF-Kopf hält es seit jeher so:
             Zählung links, Zoom rechts (`TextEditorView.xaml`, „Statusleiste").

             Sie verschwindet mit den Seiten: „Zurück / Vor" über einem Dokument, das gar nicht
             angezeigt wird, sind zwei Knöpfe, die nichts tun können. -->
        <Border x:Name="Seitenleiste" DockPanel.Dock="Bottom" IsVisible="False"
                Background="{DynamicResource Brush.ToolbarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="10,3">
            <DockPanel>
                <!-- Wörter und Zeichen: dieselbe Angabe wie in der Statusleiste des
                     WPF-Editors, hier aus dem Modell gezählt statt aus dem FlowDocument. -->
                <TextBlock x:Name="Zaehlung" DockPanel.Dock="Left" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                    <Button Classes="flach symbol" Click="Seitenbreite_Click"
                            ToolTip.Tip="{loc:T Ed.FitWidth.Tip}">
                        <views:Symbol Icon="FitWidth" Stroke="{DynamicResource Brush.Text}"/>
                    </Button>
                    <Button Classes="flach symbol" Click="GanzeSeite_Click"
                            ToolTip.Tip="{loc:T Ed.FitPage.Tip}">
                        <views:Symbol Icon="FitPage" Stroke="{DynamicResource Brush.Text}"/>
                    </Button>

                    <Border Classes="trenner"/>

                    <Button Classes="flach symbol" Click="ZoomRaus_Click" ToolTip.Tip="{loc:T Zoom.Out}">
                        <views:Symbol Icon="ZoomOut" Stroke="{DynamicResource Brush.Text}"/>
                    </Button>
                    <Button x:Name="ZoomAnzeige" Classes="flach" MinWidth="52" Content="100 %"
                            FontSize="12" Click="ZoomZurueck_Click" ToolTip.Tip="{loc:T Zoom.Reset}"
                            Foreground="{DynamicResource Brush.TextMuted}"/>
                    <Button Classes="flach symbol" Click="ZoomRein_Click" ToolTip.Tip="{loc:T Zoom.In}">
                        <views:Symbol Icon="ZoomIn" Stroke="{DynamicResource Brush.Text}"/>
                    </Button>
                </StackPanel>

                <!-- Die Seitenzahl bleibt mittig, wie bisher — sie gehört zum Blättern und
                     nicht zu einer der beiden Seiten. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                    <Button Classes="flach symbol" Click="SeiteZurueck_Click" ToolTip.Tip="{loc:T Page.Previous}">
                        <views:Symbol Icon="ChevronLeft" Stroke="{DynamicResource Brush.Text}"/>
                    </Button>
                    <TextBlock x:Name="SeitenAnzeige" VerticalAlignment="Center" MinWidth="110"
                               TextAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                    <Button Classes="flach symbol" Click="SeiteVor_Click" ToolTip.Tip="{loc:T Page.Next}">
                        <views:Symbol Icon="ChevronRight" Stroke="{DynamicResource Brush.Text}"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== Suchen & Ersetzen ==================== -->
        <!-- **Über den Blättern und nicht darüber schwebend** — dieselbe Stelle wie drüben
             (`FindPanel`, DockPanel.Dock="Top"). Eine schwebende Leiste verdeckte genau den
             Treffer, den sie gerade gefunden hat.

             Die Beschriftungen lagen **längst in beiden Sprachtabellen** (`Ed.Find.*`), weil
             der WPF-Kopf sie benutzt. Neu sind nur die zwei **Meldungen** — sie standen
             drüben fest verdrahtet auf Deutsch (§4.80, Dauerregel 1). -->
        <Border x:Name="Suchleiste" DockPanel.Dock="Top" IsVisible="False"
                Background="{DynamicResource Brush.SidebarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox x:Name="SuchFeld" Width="180" PlaceholderText="{loc:T Ed.Find.Term}"
                         ToolTip.Tip="{loc:T Ed.Find.Term}" KeyDown="SuchFeld_Taste"/>
                <Button Classes="flach" Content="{loc:T Ed.Find.Next}" Click="Weitersuchen_Click"/>
                <TextBox x:Name="ErsatzFeld" Width="180" Margin="6,0,0,0"
                         PlaceholderText="{loc:T Ed.Find.ReplaceWith}"
                         ToolTip.Tip="{loc:T Ed.Find.ReplaceWith}" KeyDown="SuchFeld_Taste"/>
                <Button Classes="flach" Content="{loc:T Ed.Find.Replace}" Click="Ersetzen_Click"/>
                <Button Classes="flach" Content="{loc:T Ed.Find.ReplaceAll}" Click="AlleErsetzen_Click"/>
                <TextBlock x:Name="SuchStatus" VerticalAlignment="Center" Margin="4,0,0,0"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
                <Button Classes="flach symbol" Click="SuchleisteSchliessen_Click"
                        ToolTip.Tip="{loc:T Ed.Find.Close}">
                    <views:Symbol Icon="Close" Size="10" Stroke="{DynamicResource Brush.Text}"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ==================== Die Blätter ==================== -->
        <Panel>
            <!-- Der Bildlauf gehört dem ScrollViewer und nicht der Leinwand: die Leinwand
                 bekommt die volle Höhe aller Seiten und zeichnet nur, was gerade im
                 Sichtfenster steht (siehe TextDocView.axaml.cs, `Sichtbar`). -->
            <ScrollViewer x:Name="Blaetter" Background="{DynamicResource Brush.CanvasBg}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <!-- Das Menü der rechten Maustaste steht **im Code** (TextDocView.Reiter.cs,
                     `TabellenmenueZeigen`) und nicht hier: Avalonias `MenuFlyout` nimmt weder
                     einen Namen noch ein abbrechbares `Opening`, und „gar nicht öffnen, wenn die
                     Marke in keiner Tabelle steht" ist genau ein Abbruch. Dasselbe Muster wie
                     `MainWindow.ShowGalleryMenu` — und dieselbe Falle: die Beschriftungen müssen
                     über `Loc.T` gehen, sonst stehen sie für immer auf Deutsch (§7). -->
                <views:SkiaCanvas x:Name="Skia"/>
            </ScrollViewer>

            <!-- Ein Dokument, das die Übernahme noch vor sich hat. **Kein leeres Blatt** —
                 das sähe aus wie gelöschter Inhalt, und der Inhalt ist unversehrt da
                 (§4.22). -->
            <Border x:Name="HinweisUebernahme" IsVisible="False"
                    Background="{DynamicResource Brush.CardBg}">
                <TextBlock Text="{loc:T Td.NotMigrated}" TextWrapping="Wrap"
                           MaxWidth="460" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
            </Border>
        </Panel>
    </DockPanel>
</UserControl>
