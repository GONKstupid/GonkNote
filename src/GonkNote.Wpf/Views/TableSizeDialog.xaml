<Window x:Class="GonkNote.Views.TableSizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GonkNote.Services"
        Title="{loc:T Ed.Table.Insert}" Width="300" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.WindowBg}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource Brush.Text}"
        ShowInTaskbar="False">
    <StackPanel Margin="18">
        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="{loc:T TableSize.Rows}" Width="70" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
            <ComboBox x:Name="RowsCombo" SelectedIndex="2"/>
        </DockPanel>
        <DockPanel>
            <TextBlock Text="{loc:T TableSize.Columns}" Width="70" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
            <ComboBox x:Name="ColsCombo" SelectedIndex="2"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:T Dlg.Cancel}" Style="{StaticResource FlatButton}" MinWidth="90"
                    IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="{loc:T Ed.Tab.Insert}" Style="{StaticResource AccentButton}" MinWidth="100"
                    Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
