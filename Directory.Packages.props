<Project>

  <!-- Zentrale Paketversionen (Central Package Management). Ab mehreren Projekten Pflicht,
       sonst driften die Versionen auseinander: die .csproj nennen nur noch den Paketnamen,
       die Version steht ausschließlich hier.

       SkiaSharp 3.x (Roadmap §4): API-Bruchversion — die Textausgabe wandert von SKPaint
       nach SKFont, SKPaint.FilterQuality wird zu SKSamplingOptions. Dafuer ist der
       iOS-Build sauber, was fuer Phase 5 die Voraussetzung ist.
       Svg.Skia 5.1.1 ist die erste Fassung, die auf SkiaSharp >= 3.119.2 aufsetzt. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.Views.WPF" Version="3.119.4" />
    <PackageVersion Include="Svg.Skia" Version="5.1.1" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <!-- PDF-Rasterung (PDFium). Hat Linux-Builds, fehlt auf iOS → Phase 2: IPdfRasterizer -->
    <PackageVersion Include="Docnet.Core" Version="2.6.0" />
    <!-- OCR. Windows/Linux; auf iOS ersetzt durch Vision → Phase 2: IOcrEngine -->
    <PackageVersion Include="Tesseract" Version="5.2.0" />
    <!-- Fliegt in Phase 2 raus: stürzt unter iOS/NativeAOT ab (Reflection.Emit).
         Nachfolger: Microsoft.Data.Sqlite + JsonSerializerContext -->
    <PackageVersion Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

  <!-- Testprojekte (Phase 1). xunit 2.9.x, weil der WPF-Kopf über einen eigenen
       STA-Thread getestet wird und dort keine Runner-Eigenheiten dazukommen sollen.
       coverlet ist bewusst nicht dabei: Abdeckungszahlen sind hier kein Ziel, die
       Golden-Files sind es. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Nur fürs Testen unter Linux (CI-Job ubuntu-latest): das Paket `SkiaSharp` bringt die
         native Bibliothek für Windows und macOS mit, für Linux **nicht**. Zum Bauen genügt
         das (Meilenstein M0), zum Ausführen nicht — ohne dieses Paket wirft der erste
         Skia-Aufruf DllNotFoundException.
         Steht hier und nicht in GonkNote.Core: eine Linux-.so gehört nicht in ein Paket, das
         der Windows-Kopf mitschleppt. Für Phase 3 wird das derselbe Punkt beim
         Avalonia-Kopf sein. -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
  </ItemGroup>

</Project>
