<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
        x:Class="GonkNote.Avalonia.EditorPrototypeWindow"
        Width="1040" Height="760"
        Title="Gonk Note — Text-Editor-Prototyp (Markdown, cross-platform)">
    <DockPanel LastChildFill="True">

        <!-- Kopfzeile -->
        <Border DockPanel.Dock="Top" Background="#22808080" Padding="14,10">
            <StackPanel Spacing="2">
                <TextBlock Text="Text-Editor-Prototyp — Ansatz B (Markdown)" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Opacity="0.75" FontSize="12"
                           Text="Reiter „Bearbeiten“ (reiner Text/Markdown) und „Vorschau“ (Markdown.Avalonia). Schlank, offline, Windows + Linux — kein WPF, kein FlowDocument, keine WebView."/>
            </StackPanel>
        </Border>

        <!-- Werkzeugleiste -->
        <Border DockPanel.Dock="Top" Padding="10,6" BorderBrush="#33808080" BorderThickness="0,0,0,1">
            <WrapPanel>
                <WrapPanel.Styles>
                    <Style Selector="Button">
                        <Setter Property="Margin" Value="0,0,6,0"/>
                        <Setter Property="Padding" Value="10,4"/>
                        <Setter Property="MinWidth" Value="34"/>
                    </Style>
                </WrapPanel.Styles>
                <Button Name="BtnBold"   ToolTip.Tip="Fett (**Text**)"><TextBlock Text="B" FontWeight="Bold"/></Button>
                <Button Name="BtnItalic" ToolTip.Tip="Kursiv (*Text*)"><TextBlock Text="I" FontStyle="Italic"/></Button>
                <Button Name="BtnCode"   ToolTip.Tip="Code (`Text`)"><TextBlock Text="&lt;/&gt;" FontFamily="Consolas,monospace"/></Button>
                <Border Width="1" Background="#33808080" Margin="4,2"/>
                <Button Name="BtnH1" ToolTip.Tip="Überschrift 1">H1</Button>
                <Button Name="BtnH2" ToolTip.Tip="Überschrift 2">H2</Button>
                <Button Name="BtnH3" ToolTip.Tip="Überschrift 3">H3</Button>
                <Border Width="1" Background="#33808080" Margin="4,2"/>
                <Button Name="BtnBullet" ToolTip.Tip="Aufzählung">• Liste</Button>
                <Button Name="BtnNumber" ToolTip.Tip="Nummerierte Liste">1. Liste</Button>
                <Button Name="BtnQuote"  ToolTip.Tip="Zitat">❝ Zitat</Button>
                <Button Name="BtnTable"  ToolTip.Tip="Tabelle einfügen">Tabelle</Button>
                <Border Width="1" Background="#33808080" Margin="4,2"/>
                <Button Name="BtnSave" ToolTip.Tip="Als Markdown speichern und neu laden (Roundtrip)">Speichern ⟳</Button>
            </WrapPanel>
        </Border>

        <!-- Statuszeile -->
        <Border DockPanel.Dock="Bottom" Padding="12,5" Background="#18808080">
            <TextBlock Name="StatusText" FontSize="12" Opacity="0.8" Text="Bereit."/>
        </Border>

        <!-- Inhalt: Reiter Bearbeiten / Vorschau -->
        <TabControl>
            <TabItem Header="Bearbeiten">
                <TextBox Name="Source"
                         AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Code,Consolas,monospace" FontSize="13"
                         VerticalContentAlignment="Top"
                         Watermark="# Hier Markdown eingeben…"/>
            </TabItem>
            <TabItem Header="Vorschau">
                <md:MarkdownScrollViewer Name="Preview" MarkdownStyleName="Standard"/>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
