<UserControl x:Class="GonkNote.Views.WhiteboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             Focusable="True">
    <DockPanel>

        <!-- ===== Werkzeugleiste ===== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.ToolbarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="8,4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">

                    <!-- Stifte -->
                    <ToggleButton x:Name="BtnPen" Style="{StaticResource ToolButton}" Content="&#xE70F;"
                                  ToolTip="Stift (S)" Checked="Tool_Checked" Tag="Pen"/>
                    <ToggleButton x:Name="BtnSmoothPen" Style="{StaticResource ToolButton}"
                                  ToolTip="Formen-Stift (G) – erkennt Linien, Kreise, Rechtecke &amp; Co., glättet Kurven" Checked="Tool_Checked" Tag="SmoothPen">
                        <Path Data="{StaticResource Icon.SmoothPen}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="16" Height="16"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnPencil" Style="{StaticResource ToolButton}" Content="&#xE76D;"
                                  ToolTip="Bleistift (B)" Checked="Tool_Checked" Tag="Pencil"/>
                    <ToggleButton x:Name="BtnHighlighter" Style="{StaticResource ToolButton}" Content="&#xE7E6;"
                                  ToolTip="Textmarker (M)" Checked="Tool_Checked" Tag="Highlighter"/>
                    <ToggleButton x:Name="BtnEraser" Style="{StaticResource ToolButton}" Content="&#xE75C;"
                                  ToolTip="Radiergummi (E)" Checked="Tool_Checked" Tag="Eraser"/>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <ToggleButton x:Name="BtnMove" Style="{StaticResource ToolButton}"
                                  AutomationProperties.Name="Verschieben"
                                  ToolTip="Verschieben (V) – Objekt anklicken, dann verschieben, skalieren oder drehen"
                                  Checked="Tool_Checked" Tag="Move">
                        <Path Data="{StaticResource Icon.MoveSelect}" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="16" Height="16"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnLasso" Style="{StaticResource ToolButton}"
                                  ToolTip="Lasso-Auswahl (L) – Objekte umkreisen (nur was ~vollständig umschlossen ist)"
                                  Checked="Tool_Checked" Tag="Lasso">
                        <Path Data="{StaticResource Icon.Lasso}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="16" Height="16"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnText" Style="{StaticResource ToolButton}" Content="&#xE8D2;"
                                  ToolTip="Textfeld (T)" Checked="Tool_Checked" Tag="Text"/>
                    <ToggleButton x:Name="BtnShape" Style="{StaticResource ToolButton}" Content="&#xE739;"
                                  ToolTip="Formen (F)" Checked="Tool_Checked" Tag="Shape"/>
                    <ToggleButton x:Name="BtnSticky" Style="{StaticResource ToolButton}" Content="&#xE70B;"
                                  ToolTip="Notizzettel (N) – farbigen Klebezettel setzen" Checked="Tool_Checked" Tag="Sticky"/>
                    <ToggleButton x:Name="BtnPan" Style="{StaticResource ToolButton}"
                                  AutomationProperties.Name="Hand"
                                  ToolTip="Hand (H) – Leinwand verschieben (oder mittlere Maustaste)"
                                  Checked="Tool_Checked" Tag="Pan">
                        <Path Data="{StaticResource Icon.Hand}" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="16" Height="16"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnRuler" Style="{StaticResource ToolButton}"
                                  AutomationProperties.Name="Lineal"
                                  ToolTip="Lineal (R) – gerade Linien entlang der Kante; Körper ziehen = bewegen, Griff ziehen = drehen"
                                  Click="Ruler_Click">
                        <Path Data="{StaticResource Icon.Ruler}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="16" Height="16"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnSetSquare" Style="{StaticResource ToolButton}"
                                  AutomationProperties.Name="Geodreieck"
                                  ToolTip="Geodreieck (D) – gerade Linien an drei Kanten, mit Winkelskala; Körper ziehen = bewegen, Griff ziehen = drehen"
                                  Click="SetSquare_Click">
                        <Path Data="{StaticResource Icon.SetSquare}" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="16" Height="16"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <!-- Farben -->
                    <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="ink" IsChecked="True"
                                     Background="#000000" Tag="auto"
                                     ToolTip="Standard (Schwarz)" Checked="Color_Checked"/>
                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="ink"
                                     Background="#2563EB" Tag="#FF2563EB" ToolTip="Blau" Checked="Color_Checked"/>
                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="ink"
                                     Background="#14B8A6" Tag="#FF14B8A6" ToolTip="Türkis" Checked="Color_Checked"/>
                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="ink"
                                     Background="#EC4899" Tag="#FFEC4899" ToolTip="Pink" Checked="Color_Checked"/>
                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="ink"
                                     Background="#8B5CF6" Tag="#FF8B5CF6" ToolTip="Lila" Checked="Color_Checked"/>
                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="ink"
                                     Background="#EF4444" Tag="#FFEF4444" ToolTip="Rot" Checked="Color_Checked"/>
                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="ink"
                                     Background="#EAB308" Tag="#FFEAB308" ToolTip="Gelb" Checked="Color_Checked"/>
                        <RadioButton Style="{StaticResource ColorSwatch}" GroupName="ink"
                                     Background="#22C55E" Tag="#FF22C55E" ToolTip="Grün" Checked="Color_Checked"/>
                        <RadioButton x:Name="CustomSwatch" Style="{StaticResource ColorSwatch}" GroupName="ink"
                                     Tag="#FF000000" ToolTip="Eigene Farbe" Checked="Color_Checked"
                                     Visibility="Collapsed"/>
                        <Button Style="{StaticResource IconButton}" ToolTip="Farbe wählen (Farbrad / Hex)"
                                Click="PickColor_Click">
                            <Ellipse Width="16" Height="16">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#EF4444" Offset="0"/>
                                        <GradientStop Color="#EAB308" Offset="0.25"/>
                                        <GradientStop Color="#22C55E" Offset="0.5"/>
                                        <GradientStop Color="#2563EB" Offset="0.75"/>
                                        <GradientStop Color="#8B5CF6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Button>
                    </StackPanel>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <!-- Strichstärke -->
                    <TextBlock Text="&#xE76D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="2,0"/>
                    <Slider x:Name="WidthSlider" Width="90" Minimum="1" Maximum="20" Value="2.5"
                            VerticalAlignment="Center" ValueChanged="WidthSlider_ValueChanged"/>
                    <TextBlock x:Name="WidthLabel" Text="2,5" Width="26" VerticalAlignment="Center" Margin="4,0,0,0"
                               Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <!-- Undo / Redo -->
                    <Button x:Name="BtnUndo" Style="{StaticResource IconButton}" Content="&#xE7A7;"
                            ToolTip="Rückgängig (Strg+Z)" Click="Undo_Click" IsEnabled="False"/>
                    <Button x:Name="BtnRedo" Style="{StaticResource IconButton}" Content="&#xE7A6;"
                            ToolTip="Wiederholen (Strg+Y)" Click="Redo_Click" IsEnabled="False"/>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <!-- Zoom -->
                    <Button Style="{StaticResource IconButton}" Content="&#xE71F;" ToolTip="Verkleinern"
                            Click="ZoomOut_Click"/>
                    <Button x:Name="ZoomLabel" Style="{StaticResource FlatButton}" Content="100 %"
                            ToolTip="Zoom zurücksetzen" Click="ZoomReset_Click" MinWidth="52"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" ToolTip="Vergrößern"
                            Click="ZoomIn_Click"/>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <Button Style="{StaticResource IconButton}" Content="&#xE8B9;"
                            AutomationProperties.Name="Datei einfügen"
                            ToolTip="Datei einfügen – Bild, PDF oder Word (bei PDF/Word Seiten auswählbar; im Notizbuch als neue Seiten, im Whiteboard als Bild-Seiten); auch per Strg+V oder Drag &amp; Drop"
                            Click="InsertFile_Click"/>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <Button Style="{StaticResource IconButton}" Content="&#xE713;"
                            AutomationProperties.Name="Einstellungen"
                            ToolTip="Einstellungen (Seite, Formen, Text, Cover)" Click="PageSetup_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===== Seitenleiste unten (nur Notizbücher) ===== -->
        <Border x:Name="PageBar" DockPanel.Dock="Bottom" Background="{DynamicResource Brush.ToolbarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="8,3" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Vorherige Seite"
                        AutomationProperties.Name="Vorherige Seite" Click="PrevPage_Click"/>
                <TextBlock x:Name="PageLabel" Text="Seite 1 / 1" VerticalAlignment="Center" Margin="10,0"
                           Foreground="{DynamicResource Brush.Text}"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="Nächste Seite"
                        AutomationProperties.Name="Nächste Seite" Click="NextPage_Click"/>
                <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="8,4"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="Neue Seite"
                        AutomationProperties.Name="Neue Seite" Click="AddPage_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Seite löschen"
                        AutomationProperties.Name="Seite löschen" Click="DeletePage_Click"/>
            </StackPanel>
        </Border>

        <!-- ===== Einstellungen (rechte Seitenleiste, wie Word-Formatbereich) ===== -->
        <Border x:Name="SettingsPanel" DockPanel.Dock="Right" Width="270" Visibility="Collapsed"
                Background="{DynamicResource Brush.ToolbarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1" Padding="14,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;"
                                ToolTip="Einstellungen schließen" Click="PageSetup_Click"/>
                        <TextBlock Text="Einstellungen" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12">

                        <!-- Seite -->
                        <Expander Header="Seite" IsExpanded="True">
                        <StackPanel>
                        <TextBlock Text="Muster" FontWeight="SemiBold" Margin="0,0,0,4"
                                   Foreground="{DynamicResource Brush.Text}"/>
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <RadioButton x:Name="SetBgBlank" Content="Blanko" GroupName="setBg" Margin="0,2"
                                         Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                            <RadioButton x:Name="SetBgLines" Content="Liniert" GroupName="setBg" Margin="0,2"
                                         Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                            <RadioButton x:Name="SetBgGrid" Content="Kariert" GroupName="setBg" Margin="0,2"
                                         Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                            <RadioButton x:Name="SetBgDots" Content="Punktiert" GroupName="setBg" Margin="0,2"
                                         Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                        </UniformGrid>

                        <TextBlock Text="Farbton" FontWeight="SemiBold" Margin="0,0,0,4"
                                   Foreground="{DynamicResource Brush.Text}"/>
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <RadioButton x:Name="SetShadeAuto" Content="Wie App-Design" GroupName="setShade" Margin="0,2"
                                         Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                            <RadioButton x:Name="SetShadeLight" Content="Hell" GroupName="setShade" Margin="0,2"
                                         Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                            <RadioButton x:Name="SetShadeDark" Content="Dunkel" GroupName="setShade" Margin="0,2"
                                         Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                        </UniformGrid>

                        <StackPanel x:Name="SetSizeSection">
                            <TextBlock Text="Format" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <RadioButton x:Name="SetSizeA4" Content="A4" GroupName="setSize" Margin="0,2"
                                             Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                                <RadioButton x:Name="SetSizeA3" Content="A3" GroupName="setSize" Margin="0,2"
                                             Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                            </UniformGrid>

                            <TextBlock Text="Ausrichtung" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <RadioButton x:Name="SetOrientPortrait" Content="Hochformat" GroupName="setOrient" Margin="0,2"
                                             Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                                <RadioButton x:Name="SetOrientLandscape" Content="Querformat" GroupName="setOrient" Margin="0,2"
                                             Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                            </UniformGrid>

                            <CheckBox x:Name="SetAsDefault" Content="Als Standard für neue Seiten"
                                      Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,12"
                                      Checked="PageSetting_Changed" Unchecked="PageSetting_Changed"/>
                        </StackPanel>
                        </StackPanel>
                        </Expander>

                        <!-- Formen (nur bei aktivem Formen-Werkzeug sichtbar) -->
                        <Expander x:Name="ShapeSection" Header="Formen" IsExpanded="True">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ToggleButton x:Name="BtnShapeLine" Style="{StaticResource ToolButton}" FontFamily="Segoe UI"
                                              Content="╱" ToolTip="Linie" Checked="Shape_Checked" Tag="Line"/>
                                <ToggleButton x:Name="BtnShapeArrow" Style="{StaticResource ToolButton}" FontFamily="Segoe UI"
                                              Content="→" ToolTip="Pfeil" Checked="Shape_Checked" Tag="Arrow"/>
                                <ToggleButton x:Name="BtnShapeRect" Style="{StaticResource ToolButton}" FontFamily="Segoe UI"
                                              Content="▭" ToolTip="Rechteck" Checked="Shape_Checked" Tag="Rectangle"/>
                                <ToggleButton x:Name="BtnShapeEllipse" Style="{StaticResource ToolButton}" FontFamily="Segoe UI"
                                              Content="◯" ToolTip="Ellipse" Checked="Shape_Checked" Tag="Ellipse"/>
                                <ToggleButton x:Name="BtnShapeTriangle" Style="{StaticResource ToolButton}" FontFamily="Segoe UI"
                                              Content="△" ToolTip="Dreieck" Checked="Shape_Checked" Tag="Triangle"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ToggleButton x:Name="BtnShapeFill" Style="{StaticResource ToolButton}"
                                              ToolTip="Füllung ein/aus"
                                              Checked="ShapeFill_Changed" Unchecked="ShapeFill_Changed">
                                    <Border Width="14" Height="14" CornerRadius="3"
                                            Background="{StaticResource CheckerBrush}" ClipToBounds="True">
                                        <Rectangle x:Name="FillPreviewRect" Fill="#6614B8A6"/>
                                    </Border>
                                </ToggleButton>
                                <Button Style="{StaticResource IconButton}" ToolTip="Füllfarbe wählen"
                                        Click="PickFillColor_Click" Content="&#xE790;"/>
                                <TextBlock Text="Füllung" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{DynamicResource Brush.Text}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Deckkraft" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                                <Slider x:Name="FillOpacitySlider" Width="110" Minimum="0" Maximum="100" Value="40"
                                        VerticalAlignment="Center" ValueChanged="FillOpacity_ValueChanged"/>
                                <TextBlock x:Name="FillOpacityLabel" Text="40 %" Width="34" VerticalAlignment="Center"
                                           Margin="4,0,0,0" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                        </Expander>

                        <!-- Text-Werkzeug -->
                        <Expander x:Name="TextSection" Header="Text" IsExpanded="False">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Style="{StaticResource FlatButton}" Click="TextColor_Click" ToolTip="Textfarbe wählen (gilt auch als Tintenfarbe)">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="TextColorSwatch" Width="14" Height="14" CornerRadius="3"
                                                Background="#000000" Margin="0,0,6,0"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"/>
                                        <TextBlock Text="Textfarbe" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Style="{StaticResource FlatButton}" Click="TextBg_Click" ToolTip="Hintergrundfarbe des Textfelds">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,6,0"
                                                Background="{StaticResource CheckerBrush}" ClipToBounds="True"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                            <Border x:Name="TextBgSwatch" Background="Transparent"/>
                                        </Border>
                                        <TextBlock Text="Hintergrund" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource FlatButton}" Content="Transparent"
                                        Click="TextBgClear_Click" Margin="8,0,0,0"/>
                            </StackPanel>

                            <TextBlock Text="Schriftart" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <ComboBox x:Name="TextFontBox" Margin="0,0,0,4"
                                      SelectionChanged="TextFont_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Wirkt auf neue Textfelder sowie das gerade bearbeitete bzw. ausgewählte."
                                       Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>
                        </StackPanel>
                        </Expander>

                        <!-- Notizzettel (nur bei aktivem Notizzettel-Werkzeug sichtbar) -->
                        <Expander x:Name="StickySection" Header="Notizzettel" IsExpanded="True">
                        <StackPanel>
                            <TextBlock Text="Zettelfarbe" FontWeight="SemiBold" Margin="0,0,0,6"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <StackPanel x:Name="StickyColorPanel" Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton Style="{StaticResource ColorSwatch}" GroupName="sticky" IsChecked="True"
                                             Background="#FEF08A" Tag="#FFFEF08A" ToolTip="Gelb" Checked="StickyColor_Checked"/>
                                <RadioButton Style="{StaticResource ColorSwatch}" GroupName="sticky"
                                             Background="#BBF7D0" Tag="#FFBBF7D0" ToolTip="Grün" Checked="StickyColor_Checked"/>
                                <RadioButton Style="{StaticResource ColorSwatch}" GroupName="sticky"
                                             Background="#BFDBFE" Tag="#FFBFDBFE" ToolTip="Blau" Checked="StickyColor_Checked"/>
                                <RadioButton Style="{StaticResource ColorSwatch}" GroupName="sticky"
                                             Background="#FBCFE8" Tag="#FFFBCFE8" ToolTip="Pink" Checked="StickyColor_Checked"/>
                                <RadioButton Style="{StaticResource ColorSwatch}" GroupName="sticky"
                                             Background="#FED7AA" Tag="#FFFED7AA" ToolTip="Orange" Checked="StickyColor_Checked"/>
                                <RadioButton x:Name="StickyCustomSwatch" Style="{StaticResource ColorSwatch}" GroupName="sticky"
                                             Tag="#FFFEF08A" ToolTip="Eigene Farbe" Checked="StickyColor_Checked"
                                             Visibility="Collapsed"/>
                                <Button Style="{StaticResource IconButton}" ToolTip="Eigene Zettelfarbe wählen"
                                        Click="StickyColorPick_Click" Content="&#xE790;"/>
                            </StackPanel>
                            <TextBlock Text="Zum Setzen aufs Blatt tippen, dann tippen zum Beschriften. Verschieben/Skalieren mit dem Lasso."
                                       Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>
                        </StackPanel>
                        </Expander>

                        <!-- Cover (nur Notizbücher) -->
                        <Expander x:Name="CoverSection" Header="Cover" IsExpanded="False" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Farbverlauf" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Style="{StaticResource FlatButton}" Click="CoverStart_Click" ToolTip="Startfarbe wählen">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="CoverStartSwatch" Width="14" Height="14" CornerRadius="3"
                                                Background="#1E3A8A" Margin="0,0,6,0"/>
                                        <TextBlock Text="Start" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource FlatButton}" Click="CoverEnd_Click" Margin="8,0,0,0"
                                        ToolTip="Endfarbe wählen">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="CoverEndSwatch" Width="14" Height="14" CornerRadius="3"
                                                Background="#7C3AED" Margin="0,0,6,0"/>
                                        <TextBlock Text="Ende" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock Text="Schrift" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <ComboBox x:Name="CoverFontBox" Margin="0,0,0,12"
                                      SelectionChanged="CoverFont_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="Bild als Cover" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="Bild wählen…" Style="{StaticResource FlatButton}" Click="CoverImage_Click"/>
                                <Button x:Name="BtnCoverImageRemove" Content="Entfernen" Style="{StaticResource FlatButton}"
                                        Click="CoverImageRemove_Click" Margin="8,0,0,0" IsEnabled="False"/>
                            </StackPanel>
                            <TextBlock Text="Das Bild ersetzt Verlauf und Titel auf dem Cover."
                                       Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>
                        </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Zeichenfläche ===== -->
        <Grid x:Name="CanvasHost" Background="Transparent" ClipToBounds="True"
              AllowDrop="True" DragOver="CanvasHost_DragOver" Drop="CanvasHost_Drop">
            <skia:SKElement x:Name="Skia" PaintSurface="Skia_PaintSurface"/>
            <Canvas x:Name="Overlay" Background="{x:Null}">
                <TextBox x:Name="EditBox" Visibility="Collapsed" AcceptsReturn="True"
                         MinWidth="60" FontFamily="Segoe UI" BorderThickness="1"
                         LostKeyboardFocus="EditBox_LostFocus" PreviewKeyDown="EditBox_KeyDown"/>
            </Canvas>

            <!-- Fortschritts-Overlay während des Imports (blockiert Eingaben) -->
            <Border x:Name="BusyOverlay" Visibility="Collapsed" Background="#66000000">
                <Border Background="{DynamicResource Brush.CardBg}" CornerRadius="10" Padding="26,20"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <StackPanel>
                        <ProgressBar x:Name="BusyBar" Width="240" Height="6" Minimum="0" Maximum="100"
                                     IsIndeterminate="True"/>
                        <TextBlock x:Name="BusyText" Text="Wird importiert…" Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text}"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

    </DockPanel>
</UserControl>
