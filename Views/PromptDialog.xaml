<Window x:Class="GonkNote.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.WindowBg}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource Brush.Text}"
        ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock x:Name="PromptLabel" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,6"/>
        <TextBox x:Name="InputBox"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Abbrechen" Style="{StaticResource FlatButton}" MinWidth="90"
                    IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="OK" Style="{StaticResource AccentButton}" MinWidth="90"
                    Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
