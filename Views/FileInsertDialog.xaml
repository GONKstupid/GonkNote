<Window x:Class="GonkNote.Views.FileInsertDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GonkNote.Services"
        Width="760" Height="560" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.WindowBg}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource Brush.Text}"
        ShowInTaskbar="False">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource FlatButton}" Content="{loc:T Dlg.All}" Click="SelectAll_Click"/>
                <Button Style="{StaticResource FlatButton}" Content="{loc:T Dlg.None}" Click="SelectNone_Click" Margin="4,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="InfoText" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:T Dlg.Cancel}" Style="{StaticResource FlatButton}" MinWidth="90"
                    IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="OkButton" Style="{StaticResource AccentButton}" MinWidth="130"
                    Click="Ok_Click" IsDefault="True"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="ThumbPanel"/>
        </ScrollViewer>
    </DockPanel>
</Window>
