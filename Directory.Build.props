<Project>

  <!-- Gemeinsame Eigenschaften aller Projekte. Was hier steht, muss nicht in jeder
       .csproj wiederholt werden. Das Ziel-Framework bleibt bewusst in den Projekten:
       GonkNote.Core ist net10.0 (plattformneutral), der WPF-Kopf net10.0-windows.

       net10.0 statt des in der Roadmap genannten net9.0: .NET 9 ist eine STS-Version und
       laeuft im Mai 2026 aus, .NET 10 ist LTS (Support bis Nov 2028). Fuer den iOS-Kopf
       kommt dazu, dass net10.0-ios das SDK mitbringt, das hier ohnehin installiert ist. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <!-- 1.0.1 seit dem 2026-09-09 (V2-129): die erste Fehlerbehebungs-Ausgabe. Sie hebt
         nur die letzte Stelle — es sind Fehlerbehebungen und ein Bedienwunsch, kein neues
         Dateiformat und keine neue Fähigkeit.

         1.0.0 kam mit Phase 5, Schritt ⑤ (HANDOFF §5 Nr. 23, Nutzer-Entscheidung
         2026-08-28): die Zahl gehört an die **Auslieferung** und nicht an ihren Anfang. Bis
         dahin stand hier 0.3.0 — seit Phase 2, Schritt 3, wo der Umbau von LiteDB auf
         SQLite das **Dateiformat** änderte.

         ⛔ WER SIE ANHEBT, ZIEHT SECHS WEITERE STELLEN NACH, und keine davon fällt beim
         Bauen auf (HANDOFF §4.5, Dauerregel 1):
           * About.Version in **beiden** Loc-Tabellen (LocGerman, LocEnglish) — dort steht
             **nicht** die Zahl (die kommt als {0} herein), wohl aber der Satz dahinter,
           * ein NEUER <release>-Eintrag in packaging/flatpak/…metainfo.xml — der alte
             bleibt stehen, eine Ausgabe, die es gab, wird nicht nachträglich weggelassen,
           * die vier mitgelieferten Dokumente, wo sie eine Version nennen,
           * die Projektseite site/index.html UND site/en/index.html (Versionszeile und
             die Dateinamen in der Download-Tabelle),
           * der Platzhalter in .github/ISSUE_TEMPLATE/fehler.yml,
           * Tag und Release auf GitHub.

         ⛔ **Die Liste stand bis zum 2026-09-09 auf „vier", und sie war falsch.** Die
         Projektseite ist in §4.101 entstanden, im selben Zug wie die 1.0.0 — und ist
         dieser Aufzählung nie hinzugefügt worden. Beim ersten Anheben danach (V2-129)
         stand sie prompt noch auf 1.0.0 und bot Dateien zum Download an, die es unter
         diesem Namen nicht mehr gab. *Eine Liste, die eine andere Stelle vollständig
         nennen soll, veraltet genau dann, wenn jemand eine sechste anlegt.*

         Danach beide Über-Dialoge in beiden Sprachen gegenprüfen. *(„Und in beiden Köpfen"
         stand hier bis zum 2026-09-09 — den WPF-Kopf kann seit dem Wegfall des zweiten
         Rechners niemand mehr starten, siehe HANDOFF §0.)* -->
    <Version>1.0.1</Version>
    <Company>GonkNote</Company>
    <Product>Gonk Note</Product>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Symbole einbetten, damit im Single-File-Publish keine lose .pdb neben der Exe liegt. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
