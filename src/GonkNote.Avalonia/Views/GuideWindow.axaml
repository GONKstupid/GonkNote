<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GonkNote.Services"
        x:Class="GonkNote.Views.GuideWindow"
        Title="{loc:T Guide.Title}" Width="760" Height="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="avares://GonkNote.Avalonia/Assets/gonk-note-Icon.png"
        Background="{DynamicResource Brush.WindowBg}"
        Foreground="{DynamicResource Brush.Text}"
        FontSize="13">

    <!-- „Hilfe → Erste Schritte" — das Gegenstück zu GuideDialog.xaml im WPF-Kopf, bis auf
         eine Zeile gleich aufgebaut: dort steht ein FlowDocumentScrollViewer, hier ein
         gewöhnlicher ScrollViewer, den `MarkdownView` füllt (HANDOFF §4.1, §4.12). -->

    <DockPanel Margin="18">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12" Spacing="4">
            <TextBlock Text="{loc:T Guide.Heading}" FontSize="19" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text}"/>
            <TextBlock Text="{loc:T Guide.Subtitle}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
        </StackPanel>

        <Button DockPanel.Dock="Bottom" Classes="akzent" Content="{loc:T Window.Close}"
                MinWidth="110" HorizontalAlignment="Right" Margin="0,12,0,0"
                IsCancel="True" IsDefault="True" Click="Schliessen_Click"/>

        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource Brush.CardBg}">
            <ScrollViewer x:Name="Anleitung" Padding="16,12"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"/>
        </Border>

    </DockPanel>
</Window>
