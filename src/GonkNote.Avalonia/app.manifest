<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">

  <!-- Wird nur unter Windows ausgewertet und ist dort nötig: ohne ihn bekommt Avalonia
       Ärger mit Fenstertransparenz und eingebetteten Steuerelementen. Unter Linux wird
       er schlicht nicht gelesen. -->
  <assemblyIdentity version="1.0.0.0" name="GonkNote.Avalonia"/>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10/11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!-- Der Testrechner läuft auf 200 % (HANDOFF §7 „DPI-Falle"). Ohne diese Angabe
       skaliert Windows das Fenster als Bitmap hoch und alles wirkt unscharf. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>

</assembly>
