<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GonkNote.Services"
        x:Class="GonkNote.Views.AboutWindow"
        Title="{loc:T About.Title}"
        Width="620" Height="640"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="avares://GonkNote.Avalonia/Assets/gonk-note-Icon.png"
        Background="{DynamicResource Brush.WindowBg}"
        Foreground="{DynamicResource Brush.Text}"
        FontSize="13">

    <!-- Aufbau wie AboutDialog.xaml im WPF-Kopf: Kopf, Untertitel, gerendertes README,
         Schließen. Seit dem siebten Brocken auch hier mit README — es kommt über
         `EmbeddedDocs` und `MarkdownView` statt über ein FlowDocument (HANDOFF §4.12).

         Eine Zeile mehr als drüben: der **Datenordner**. Er unterscheidet sich zwischen den
         Plattformen (~/.config/GonkNote gegen %APPDATA%\GonkNote), und der Untertitel kann
         ihn deshalb nicht nennen. -->

    <DockPanel Margin="18">

        <!-- ⛔ Ein DockPanel und kein waagerechtes StackPanel — dieselbe Begründung wie im
             WPF-Kopf, dort ausgeschrieben: ein waagerechtes StackPanel misst mit
             unendlicher Breite, und die Versionszeile wird dann abgeschnitten statt
             umgebrochen. Hier vorsorglich mitgeändert, damit die zwei Dialoge nicht
             auseinanderlaufen (§4.9, §4.77: was in einem Kopf steht, steht im anderen). -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Image DockPanel.Dock="Left" Margin="0,0,12,0"
                   Source="avares://GonkNote.Avalonia/Assets/gonk-note-Icon.png"
                   Width="40" Height="40" VerticalAlignment="Center"/>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Gonk Note" FontSize="19" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}"/>
                <!-- Der Text steht in Loc (About.Version, beide Tabellen) und nicht im
                     Code — bis 0.2.0 war er fest verdrahtet und erschien deshalb auch im
                     englischen Dialog deutsch (HANDOFF §4.5). -->
                <TextBlock x:Name="VersionsZeile" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{loc:T About.Subtitle}" TextWrapping="Wrap"
                   Margin="0,0,0,8" Foreground="{DynamicResource Brush.TextMuted}"/>

        <TextBlock DockPanel.Dock="Top" x:Name="Datenordner" TextWrapping="Wrap" FontSize="11"
                   Margin="0,0,0,12" Foreground="{DynamicResource Brush.TextMuted}"/>

        <Button DockPanel.Dock="Bottom" Classes="akzent" Content="{loc:T Window.Close}"
                MinWidth="110" HorizontalAlignment="Right" Margin="0,12,0,0"
                IsDefault="True" IsCancel="True" Click="Schliessen_Click"/>

        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource Brush.CardBg}">
            <ScrollViewer x:Name="Liesmich" Padding="14,10"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"/>
        </Border>

    </DockPanel>
</Window>
