<UserControl x:Class="GonkNote.Views.TextEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Die Dokumentseite bleibt in beiden Themes weiß (Nutzer-Wunsch: Papier ist
             Papier); nur die Umgebung (Canvas) folgt dem Theme. Deshalb sind Seite,
             Tinte und Markierung feste helle Werte. -->
        <SolidColorBrush x:Key="PageBgBrush"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InkBrush"          Color="#1B2B4B"/>
        <SolidColorBrush x:Key="PageSelectionBrush" Color="#C7DBFF"/>
        <SolidColorBrush x:Key="PageMutedBrush"    Color="#6B7A99"/>
        <SolidColorBrush x:Key="CanvasBgBrush" Color="{DynamicResource Color.CanvasBg}"/>

        <!-- Ausrichtungs-Icons (Icon.Justify liegt in Styles.xaml) -->
        <Geometry x:Key="Icon.AlignL">M2,3.5 H14 M2,6.66 H10 M2,9.83 H14 M2,13 H10</Geometry>
        <Geometry x:Key="Icon.AlignC">M2,3.5 H14 M4,6.66 H12 M2,9.83 H14 M4,13 H12</Geometry>
        <Geometry x:Key="Icon.AlignR">M2,3.5 H14 M6,6.66 H14 M2,9.83 H14 M6,13 H14</Geometry>

        <Style x:Key="PathIcon" TargetType="Path">
            <Setter Property="StrokeThickness" Value="1.3"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>

        <!-- Ribbon-Tab: Aktivierung über 2-px-Unterstrich in Akzentfarbe (Design-Konzept 7.2) -->
        <Style x:Key="RibbonTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <ContentPresenter x:Name="content" Margin="12,5,12,7"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Rectangle x:Name="underline" Height="2" VerticalAlignment="Bottom"
                                       Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed"
                                       Margin="10,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="underline" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button mit Icon + Beschriftung (für Einfügen/Layout/Verweise) -->
        <Style x:Key="LabelButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <!-- Formatvorlagen-Karte: Vorschau auf Seitenhintergrund (WYSIWYG, Design-Konzept 7.4) -->
        <Style x:Key="StyleCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource PageBgBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Margin="2,0" Width="96" Height="44">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Schmale Zahlenfelder (cm-/pt-Eingaben im Ribbon) -->
        <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GroupSep" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Margin" Value="7,4"/>
        </Style>

        <!-- Dropdown-Sammelbutton (Icon + Chevron, öffnet sein ContextMenu) -->
        <Style x:Key="DropButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <Style x:Key="RibbonLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,4,0"/>
        </Style>

        <!-- Icon-Leisten-Button links (Design-Konzept 7.5) -->
        <Style x:Key="SideIconButton" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent" Height="40">
                            <Rectangle x:Name="marker" Width="3" HorizontalAlignment="Left"
                                       Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed"/>
                            <Border x:Name="bd" Background="Transparent" CornerRadius="6" Margin="6,4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="marker" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- ===================== Ribbon (Tab-Leiste + Werkzeugleiste) ===================== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.ToolbarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <StackPanel>

                <!-- Tab-Leiste mit Schnellzugriff (Undo/Redo) links -->
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" Width="28" Height="26"
                                ToolTip="Rückgängig (Strg+Z)" Click="Undo_Click" Margin="6,2,0,0"
                                AutomationProperties.Name="Rückgängig"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE7A6;" Width="28" Height="26"
                                ToolTip="Wiederholen (Strg+Y)" Click="Redo_Click" Margin="0,2,4,0"
                                AutomationProperties.Name="Wiederholen"/>
                        <Border Style="{StaticResource GroupSep}"/>
                        <RadioButton x:Name="TabStart" Style="{StaticResource RibbonTab}" Content="Start"
                                     IsChecked="True" Checked="RibbonTab_Checked" Tag="Start"/>
                        <RadioButton Style="{StaticResource RibbonTab}" Content="Einfügen"
                                     Checked="RibbonTab_Checked" Tag="Einfügen"/>
                        <RadioButton Style="{StaticResource RibbonTab}" Content="Layout"
                                     Checked="RibbonTab_Checked" Tag="Layout"/>
                        <RadioButton Style="{StaticResource RibbonTab}" Content="Verweise"
                                     Checked="RibbonTab_Checked" Tag="Verweise"/>
                    </StackPanel>
                </Grid>

                <!-- ============ Werkzeugleiste: Start ============ -->
                <WrapPanel x:Name="PanelStart" Margin="8,2,8,6">
                    <ToggleButton x:Name="BtnFormatPainter" Style="{StaticResource ToolButton}" Width="32" Height="30"
                                  Click="FormatPainter_Click" ToolTip="Format übertragen: Klicken, dann Ziel markieren"
                                  AutomationProperties.Name="Format übertragen" Content="&#xE790;"/>
                    <Button Style="{StaticResource IconButton}" Height="30" ToolTip="Formatierung löschen" Click="ClearFormat_Click">
                        <TextBlock FontFamily="Segoe UI" FontSize="12">
                            <Run Text="A"/><Run Text="a" FontSize="9"/><Run Text="✕" FontSize="8"/>
                        </TextBlock>
                    </Button>

                    <Border Style="{StaticResource GroupSep}"/>

                    <ComboBox x:Name="FontCombo" Width="136" SelectionChanged="FontCombo_Changed" ToolTip="Schriftart">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Vorschau: jeder Eintrag in seiner eigenen Schrift -->
                                <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox x:Name="SizeCombo" Width="54" Margin="4,0,0,0" SelectionChanged="SizeCombo_Changed"
                              ToolTip="Schriftgröße"/>
                    <Button Style="{StaticResource IconButton}" Height="30" Content="&#xE8E8;" ToolTip="Schrift vergrößern"
                            Command="EditingCommands.IncreaseFontSize" CommandTarget="{Binding ElementName=Editor}"/>
                    <Button Style="{StaticResource IconButton}" Height="30" Content="&#xE8E7;" ToolTip="Schrift verkleinern"
                            Command="EditingCommands.DecreaseFontSize" CommandTarget="{Binding ElementName=Editor}"/>

                    <Border Style="{StaticResource GroupSep}"/>

                    <ToggleButton x:Name="BtnBold" Style="{StaticResource ToolButton}" Width="30" Height="30"
                                  Click="Bold_Click" ToolTip="Fett (Strg+B)">
                        <TextBlock Text="F" FontWeight="Bold" FontFamily="Segoe UI"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnItalic" Style="{StaticResource ToolButton}" Width="30" Height="30"
                                  Click="Italic_Click" ToolTip="Kursiv (Strg+I)">
                        <TextBlock Text="K" FontStyle="Italic" FontFamily="Segoe UI"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnUnderline" Style="{StaticResource ToolButton}" Width="30" Height="30"
                                  Click="Underline_Click" ToolTip="Unterstrichen (Strg+U)">
                        <TextBlock Text="U" TextDecorations="Underline" FontFamily="Segoe UI"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnStrike" Style="{StaticResource ToolButton}" Width="30" Height="30"
                                  Click="Strike_Click" ToolTip="Durchgestrichen">
                        <TextBlock Text="S" TextDecorations="Strikethrough" FontFamily="Segoe UI"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnSub" Style="{StaticResource ToolButton}" Width="30" Height="30" FontFamily="Segoe UI"
                                  Content="x₂" Click="Sub_Click" ToolTip="Tiefgestellt"/>
                    <ToggleButton x:Name="BtnSuper" Style="{StaticResource ToolButton}" Width="30" Height="30" FontFamily="Segoe UI"
                                  Content="x²" Click="Super_Click" ToolTip="Hochgestellt"/>

                    <Border Style="{StaticResource GroupSep}"/>

                    <Button Style="{StaticResource IconButton}" Height="30" Click="ApplyTextColor_Click" ToolTip="Textfarbe anwenden">
                        <StackPanel>
                            <TextBlock Text="A" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13"
                                       HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                            <Rectangle x:Name="TextColorBar" Height="3" Width="14" Fill="#EC4899" RadiusX="1" RadiusY="1"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="8" Height="30"
                            ToolTip="Textfarbe wählen" Width="16" Click="PickTextColor_Click"/>
                    <Button Style="{StaticResource IconButton}" Height="30" Click="ApplyHighlight_Click" ToolTip="Textmarker anwenden">
                        <StackPanel>
                            <TextBlock Text="&#xE7E6;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       HorizontalAlignment="Center"/>
                            <Rectangle x:Name="HighlightBar" Height="3" Width="14" Fill="#FDE047" RadiusX="1" RadiusY="1"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="8" Height="30"
                            ToolTip="Markerfarbe wählen (inkl. „keine“)" Width="16" Click="PickHighlight_Click"/>

                    <Border Style="{StaticResource GroupSep}"/>

                    <!-- Ein Sammel-Button für alle Textausrichtungen -->
                    <Button x:Name="BtnAlign" Style="{StaticResource DropButton}" Click="OpenDropdown_Click"
                            ToolTip="Textausrichtung" AutomationProperties.Name="Textausrichtung">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="AlignGlyph" Style="{StaticResource PathIcon}"
                                  Data="{StaticResource Icon.AlignL}" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="8"
                                       Margin="5,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="AlignItemLeft" Header="Linksbündig" Tag="Left" Click="AlignMenu_Click"/>
                                <MenuItem x:Name="AlignItemCenter" Header="Zentriert" Tag="Center" Click="AlignMenu_Click"/>
                                <MenuItem x:Name="AlignItemRight" Header="Rechtsbündig" Tag="Right" Click="AlignMenu_Click"/>
                                <MenuItem x:Name="AlignItemJustify" Header="Blocksatz" Tag="Justify" Click="AlignMenu_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Aufzählung: Split-Button (Klick = umschalten, Pfeil = Stil-Bibliothek) -->
                    <Button x:Name="BtnBullets" Style="{StaticResource IconButton}" Height="30" Content="&#xE8FD;"
                            ToolTip="Aufzählung" Click="ToggleBullets_Click"
                            AutomationProperties.Name="Aufzählung"/>
                    <Button Style="{StaticResource IconButton}" Height="30" Width="16" Content="&#xE70D;" FontSize="8"
                            ToolTip="Aufzählungszeichen wählen" Click="OpenBulletLibrary_Click"/>

                    <!-- Nummerierung: Split-Button -->
                    <Button x:Name="BtnNumbering" Style="{StaticResource IconButton}" Height="30" FontFamily="Segoe UI"
                            Content="№" ToolTip="Nummerierte Liste" Click="ToggleNumbering_Click"
                            AutomationProperties.Name="Nummerierte Liste"/>
                    <Button Style="{StaticResource IconButton}" Height="30" Width="16" Content="&#xE70D;" FontSize="8"
                            ToolTip="Nummerierungsart wählen" Click="OpenNumberLibrary_Click"/>

                    <Button Style="{StaticResource IconButton}" Height="30" ToolTip="Einzug vergrößern"
                            Click="IndentInc_Click">
                        <Path Style="{StaticResource PathIcon}" Data="{StaticResource Icon.IndentInc}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Height="30" ToolTip="Einzug verkleinern"
                            Click="IndentDec_Click">
                        <Path Style="{StaticResource PathIcon}" Data="{StaticResource Icon.IndentDec}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>

                    <Border Style="{StaticResource GroupSep}"/>

                    <!-- Formatvorlagen: 3 Kacheln inline + Aufklapp-Pfeil (Rest im Flyout) -->
                    <StackPanel x:Name="StyleGallery" Orientation="Horizontal"/>
                    <Button x:Name="BtnStyleMore" Style="{StaticResource IconButton}" Height="44" Width="20"
                            Content="&#xE70D;" FontSize="9" ToolTip="Alle Formatvorlagen"
                            Click="OpenStyleGallery_Click" AutomationProperties.Name="Alle Formatvorlagen"/>
                </WrapPanel>

                <!-- ============ Werkzeugleiste: Einfügen ============ -->
                <WrapPanel x:Name="PanelInsert" Margin="8,2,8,6" Visibility="Collapsed">
                    <Button Style="{StaticResource LabelButton}" Click="InsertTable_Click"
                            AutomationProperties.Name="Tabelle einfügen">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource PathIcon}" Data="{StaticResource Icon.Table}"
                                  Stroke="{DynamicResource Brush.TextMuted}"/>
                            <TextBlock Text="Tabelle" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LabelButton}" Click="InsertImage_Click"
                            AutomationProperties.Name="Bild einfügen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="Bild" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LabelButton}" Click="InsertInfoBox_Click"
                            ToolTip="Farbige Infobox (1×1-Tabelle mit Füllung und Rahmen)"
                            AutomationProperties.Name="Infobox einfügen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="Infobox" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LabelButton}" Content="— Trennlinie" Click="InsertRule_Click"/>

                    <Border Style="{StaticResource GroupSep}"/>

                    <ToggleButton x:Name="BtnSymbols" Style="{StaticResource ToolButton}" Width="Auto" Height="30"
                                  Click="ToggleSymbols_Click" ToolTip="Sonderzeichen einfügen"
                                  AutomationProperties.Name="Sonderzeichen">
                        <TextBlock Text=" Ω Symbol " FontFamily="Segoe UI"/>
                    </ToggleButton>
                    <Button Style="{StaticResource LabelButton}" Click="OpenShapes_Click"
                            ToolTip="Form einfügen (Vektorform in Akzentfarbe)"
                            AutomationProperties.Name="Formen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE739;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="Formen" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LabelButton}" Click="OpenChart_Click"
                            ToolTip="Diagramm aus eigenen Werten einfügen (Balken, Linie, Kuchen)"
                            AutomationProperties.Name="Diagramm">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="Diagramm" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource GroupSep}"/>

                    <Button Style="{StaticResource LabelButton}" Content="Kopf-/Fußzeile…" Click="EditHeaderFooter_Click"
                            AutomationProperties.Name="Kopf- und Fußzeile"/>
                    <Button Style="{StaticResource LabelButton}" Content="Seitenzahlen" Click="InsertPageNumbers_Click"
                            ToolTip="Fügt „Seite {SEITE} von {SEITEN}“ in die Fußzeile ein"
                            AutomationProperties.Name="Seitenzahlen"/>
                </WrapPanel>

                <!-- ============ Werkzeugleiste: Layout ============ -->
                <WrapPanel x:Name="PanelLayout" Margin="8,2,8,6" Visibility="Collapsed">
                    <TextBlock Text="Format" Style="{StaticResource RibbonLabel}"/>
                    <ComboBox x:Name="FormatCombo" Width="72" SelectionChanged="PageFormat_Changed" ToolTip="Papierformat">
                        <ComboBoxItem Content="A4" IsSelected="True"/>
                        <ComboBoxItem Content="A5"/>
                        <ComboBoxItem Content="A3"/>
                        <ComboBoxItem Content="Letter"/>
                    </ComboBox>
                    <ToggleButton x:Name="BtnPortrait" Style="{StaticResource ToolButton}" Width="Auto" Height="28"
                                  Margin="6,0,0,0" Click="Orientation_Click" Tag="P" ToolTip="Hochformat">
                        <TextBlock Text=" Hoch " FontFamily="Segoe UI" FontSize="12"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnLandscape" Style="{StaticResource ToolButton}" Width="Auto" Height="28"
                                  Click="Orientation_Click" Tag="L" ToolTip="Querformat">
                        <TextBlock Text=" Quer " FontFamily="Segoe UI" FontSize="12"/>
                    </ToggleButton>

                    <Border Style="{StaticResource GroupSep}"/>

                    <!-- Detaileinstellungen wandern in die Seitenleiste rechts -->
                    <Button Style="{StaticResource LabelButton}" Click="OpenMargins_Click"
                            ToolTip="Seitenränder einstellen" AutomationProperties.Name="Ränder">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE799;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="Ränder" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LabelButton}" Click="OpenSpacing_Click"
                            ToolTip="Absatz- und Zeilenabstände" AutomationProperties.Name="Abstände">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE799;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="Abstände" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LabelButton}" Click="OpenWatermark_Click"
                            ToolTip="Hintergrundbild / Wasserzeichen" AutomationProperties.Name="Hintergrundbild">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="Hintergrundbild" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource GroupSep}"/>

                    <CheckBox x:Name="BreaksCheck" Content="Seitenumbrüche anzeigen" VerticalAlignment="Center"
                              Foreground="{DynamicResource Brush.Text}" Margin="4,0"
                              Checked="PageBreaks_Toggled" Unchecked="PageBreaks_Toggled"
                              ToolTip="Zeigt als Näherung, wo beim PDF-Export die Seiten umbrechen"
                              AutomationProperties.Name="Seitenumbrüche anzeigen"/>
                </WrapPanel>

                <!-- ============ Werkzeugleiste: Verweise ============ -->
                <WrapPanel x:Name="PanelRefs" Margin="8,2,8,6" Visibility="Collapsed">
                    <Button Style="{StaticResource LabelButton}" Click="InsertToc_Click"
                            ToolTip="Erstellt ein Inhaltsverzeichnis aus den Überschriften 1–4"
                            AutomationProperties.Name="Inhaltsverzeichnis einfügen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="Inhaltsverzeichnis einfügen" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LabelButton}" Content="Aktualisieren" Click="UpdateToc_Click"
                            ToolTip="Inhaltsverzeichnis neu aus den Überschriften aufbauen"
                            AutomationProperties.Name="Inhaltsverzeichnis aktualisieren"/>

                    <Border Style="{StaticResource GroupSep}"/>

                    <Button Style="{StaticResource LabelButton}" Click="InsertLink_Click"
                            ToolTip="Hyperlink einfügen/bearbeiten" AutomationProperties.Name="Link einfügen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="Link" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LabelButton}" Click="InsertCaption_Click"
                            ToolTip="Bildunterschrift „Abbildung N: …“ unter dem Bild/Absatz einfügen"
                            AutomationProperties.Name="Beschriftung einfügen">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="Beschriftung" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Hinweis hinter Info-i (nur bei Hover/Klick) -->
                    <Button Style="{StaticResource IconButton}" Height="30" Width="26" Content="&#xE946;"
                            Foreground="{DynamicResource Brush.TextMuted}" ToolTipService.InitialShowDelay="150"
                            ToolTipService.ShowDuration="20000" AutomationProperties.Name="Hinweis Verweise">
                        <Button.ToolTip>
                            <ToolTip MaxWidth="320">
                                <TextBlock TextWrapping="Wrap"
                                           Text="Beim DOCX-Export wird das Inhaltsverzeichnis zu einem echten Word-Feld (mit Seitenzahlen, aktualisiert sich beim Öffnen). Überschriften 1–4 erscheinen automatisch im Verzeichnis."/>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ===== Suchen &amp; Ersetzen ===== -->
        <Border x:Name="FindPanel" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="{DynamicResource Brush.SidebarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="FindBox" Width="180" KeyDown="FindBox_KeyDown" ToolTip="Suchbegriff"/>
                <Button Style="{StaticResource FlatButton}" Content="Weiter" Margin="6,0,0,0" Click="FindNext_Click"/>
                <TextBox x:Name="ReplaceBox" Width="180" Margin="12,0,0,0" ToolTip="Ersetzen durch"/>
                <Button Style="{StaticResource FlatButton}" Content="Ersetzen" Margin="6,0,0,0" Click="ReplaceOne_Click"/>
                <Button Style="{StaticResource FlatButton}" Content="Alle ersetzen" Margin="2,0,0,0" Click="ReplaceAll_Click"/>
                <TextBlock x:Name="FindStatus" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Margin="6,0,0,0"
                        ToolTip="Schließen (Esc)" Click="CloseFind_Click"/>
            </StackPanel>
        </Border>

        <!-- ===================== Statusleiste ===================== -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.SidebarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="10,2">
            <DockPanel>
                <TextBlock x:Name="WordCountText" DockPanel.Dock="Left" Text="Wörter: 0 · Zeichen: 0"
                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" VerticalAlignment="Center"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox x:Name="LanguageCombo" Width="86" Height="24" FontSize="12"
                              SelectionChanged="Language_Changed" ToolTip="Sprache für die Rechtschreibprüfung">
                        <ComboBoxItem Content="Deutsch" Tag="de-DE" IsSelected="True"/>
                        <ComboBoxItem Content="Englisch" Tag="en-US"/>
                    </ComboBox>
                    <ToggleButton x:Name="BtnSpell" Style="{StaticResource ToolButton}" Width="Auto" Height="24"
                                  Margin="6,0" IsChecked="True" Click="Spell_Click"
                                  ToolTip="Rechtschreibprüfung ein/aus" AutomationProperties.Name="Rechtschreibprüfung">
                        <TextBlock Text=" ABC✓ " FontFamily="Segoe UI" FontSize="11"/>
                    </ToggleButton>

                    <Border Style="{StaticResource GroupSep}"/>

                    <Button Style="{StaticResource IconButton}" Content="&#xE949;" Width="24" Height="24" FontSize="11"
                            Click="ZoomOut_Click" ToolTip="Verkleinern" AutomationProperties.Name="Zoom verkleinern"/>
                    <Slider x:Name="ZoomSlider" Width="90" Minimum="50" Maximum="200" Value="100"
                            ValueChanged="Zoom_Changed" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE948;" Width="24" Height="24" FontSize="11"
                            Click="ZoomIn_Click" ToolTip="Vergrößern" AutomationProperties.Name="Zoom vergrößern"/>
                    <TextBlock x:Name="ZoomText" Text="100 %" Width="42" TextAlignment="Right"
                               Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <Border/>
            </DockPanel>
        </Border>

        <!-- ===================== Linke Icon-Leiste ===================== -->
        <Border DockPanel.Dock="Left" Width="42" Background="{DynamicResource Brush.SidebarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <StackPanel>
                <ToggleButton x:Name="BtnSideFind" Style="{StaticResource SideIconButton}" Content="&#xE721;"
                              Click="ToggleFind_Click" ToolTip="Suchen &amp; Ersetzen (Strg+F)"
                              AutomationProperties.Name="Suchen"/>
                <ToggleButton x:Name="BtnSideNav" Style="{StaticResource SideIconButton}" Content="&#xE8A4;"
                              Click="ToggleNavigator_Click" ToolTip="Überschriften-Navigator"
                              AutomationProperties.Name="Überschriften"/>
            </StackPanel>
        </Border>

        <!-- Überschriften-Navigator -->
        <Border x:Name="NavPanel" DockPanel.Dock="Left" Width="210" Visibility="Collapsed"
                Background="{DynamicResource Brush.SidebarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,8">
                <TextBlock DockPanel.Dock="Top" Text="Überschriften" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,6"/>
                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="NavList_Selected"
                         Foreground="{DynamicResource Brush.Text}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <!-- Theme-taugliche Einträge (Standard-Template wäre schwarz auf dunkel) -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="5"
                                                Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background"
                                                        Value="{DynamicResource Brush.Hover}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource Brush.TextMuted}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===================== Einstellungs-Seitenleiste (rechts, ausklappbar) ===================== -->
        <Border x:Name="SettingsPanel" DockPanel.Dock="Right" Width="248" Visibility="Collapsed"
                Background="{DynamicResource Brush.SidebarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="12,10,8,6">
                    <TextBlock Text="Seiteneinstellungen" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="26" Height="26"
                            HorizontalAlignment="Right" ToolTip="Schließen" Click="CloseSettings_Click"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0,12,12">

                        <Expander x:Name="SecMargins" Header="Ränder" IsExpanded="True">
                            <StackPanel>
                                <TextBlock Text="Vorlage" Style="{StaticResource RibbonLabel}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="MarginPresetCombo" SelectionChanged="MarginPreset_Changed">
                                    <ComboBoxItem Content="Normal (2 cm)"/>
                                    <ComboBoxItem Content="Schmal (1,27 cm)"/>
                                    <ComboBoxItem Content="Breit (3 cm)"/>
                                    <ComboBoxItem Content="Lernblatt (4 cm links)"/>
                                    <ComboBoxItem Content="Benutzerdefiniert"/>
                                </ComboBox>
                                <UniformGrid Columns="2" Margin="0,8,0,0">
                                    <DockPanel Margin="0,0,4,6">
                                        <TextBlock Text="Links" Width="42" Style="{StaticResource RibbonLabel}"/>
                                        <TextBox x:Name="MarginL" Style="{StaticResource NumBox}" Width="Auto"
                                                 LostFocus="Margin_Changed" KeyDown="NumBox_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="Oben" Width="42" Style="{StaticResource RibbonLabel}"/>
                                        <TextBox x:Name="MarginT" Style="{StaticResource NumBox}" Width="Auto"
                                                 LostFocus="Margin_Changed" KeyDown="NumBox_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,4,0">
                                        <TextBlock Text="Rechts" Width="42" Style="{StaticResource RibbonLabel}"/>
                                        <TextBox x:Name="MarginR" Style="{StaticResource NumBox}" Width="Auto"
                                                 LostFocus="Margin_Changed" KeyDown="NumBox_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Unten" Width="42" Style="{StaticResource RibbonLabel}"/>
                                        <TextBox x:Name="MarginB" Style="{StaticResource NumBox}" Width="Auto"
                                                 LostFocus="Margin_Changed" KeyDown="NumBox_KeyDown"/>
                                    </DockPanel>
                                </UniformGrid>
                                <TextBlock Text="Werte in cm" Style="{StaticResource RibbonLabel}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Expander>

                        <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,4"/>

                        <Expander x:Name="SecSpacing" Header="Absätze">
                            <StackPanel>
                                <DockPanel Margin="0,2,0,6">
                                    <TextBlock Text="Abstand vor" Width="110" Style="{StaticResource RibbonLabel}"/>
                                    <TextBox x:Name="SpaceBefore" Style="{StaticResource NumBox}" Width="Auto"
                                             LostFocus="ParaSpacing_Changed" KeyDown="NumBox_KeyDown"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Abstand nach" Width="110" Style="{StaticResource RibbonLabel}"/>
                                    <TextBox x:Name="SpaceAfter" Style="{StaticResource NumBox}" Width="Auto"
                                             LostFocus="ParaSpacing_Changed" KeyDown="NumBox_KeyDown"/>
                                </DockPanel>
                                <TextBlock Text="Abstände in pt" Style="{StaticResource RibbonLabel}"/>
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock Text="Zeilenabstand" Width="110" Style="{StaticResource RibbonLabel}"/>
                                    <ComboBox x:Name="SpacingCombo" SelectionChanged="Spacing_Changed">
                                        <ComboBoxItem Content="1,0" Tag="1.0" IsSelected="True"/>
                                        <ComboBoxItem Content="1,15" Tag="1.15"/>
                                        <ComboBoxItem Content="1,5" Tag="1.5"/>
                                        <ComboBoxItem Content="2,0" Tag="2.0"/>
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                        </Expander>

                        <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,4"/>

                        <Expander x:Name="SecWatermark" Header="Hintergrundbild">
                            <StackPanel>
                                <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                                        Content="Bild wählen…" Click="PickWatermark_Click"
                                        ToolTip="Seitenfüllendes Bild hinter dem Text (Wasserzeichen)"
                                        AutomationProperties.Name="Hintergrundbild wählen"/>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="Deckkraft" Width="80" Style="{StaticResource RibbonLabel}"/>
                                    <ComboBox x:Name="WatermarkOpacityCombo" SelectionChanged="WatermarkOpacity_Changed">
                                        <ComboBoxItem Content="100 %" Tag="1.0" IsSelected="True"/>
                                        <ComboBoxItem Content="60 %" Tag="0.6"/>
                                        <ComboBoxItem Content="30 %" Tag="0.3"/>
                                        <ComboBoxItem Content="15 %" Tag="0.15"/>
                                    </ComboBox>
                                </DockPanel>
                                <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                        Content="Entfernen" Click="RemoveWatermark_Click"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================== Arbeitsbereich ===================== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Lineal -->
            <Border Grid.Row="0" Height="22" Background="{DynamicResource Brush.ToolbarBg}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                <ScrollViewer x:Name="RulerScroll" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled" Focusable="False" IsHitTestVisible="False">
                    <Grid x:Name="RulerHost">
                        <Canvas x:Name="RulerCanvas" Height="22" HorizontalAlignment="Center"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Canvas-Umgebung + Seite -->
            <ScrollViewer x:Name="MainScroll" Grid.Row="1" Background="{StaticResource CanvasBgBrush}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          ScrollChanged="MainScroll_ScrollChanged" PreviewMouseWheel="MainScroll_PreviewMouseWheel">
                <Grid x:Name="PageHost" HorizontalAlignment="Center" Margin="40,24">
                    <Grid x:Name="PageWrap">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="PageScale" ScaleX="1" ScaleY="1"/>
                        </Grid.LayoutTransform>

                        <!-- Schattenebene getrennt vom Inhalt (Effekt rastert sonst den Text) -->
                        <Border Background="{StaticResource PageBgBrush}" CornerRadius="2">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22"/>
                            </Border.Effect>
                        </Border>

                        <Border x:Name="Page" Background="{StaticResource PageBgBrush}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="2"
                                ClipToBounds="True">
                            <Grid>
                                <Image x:Name="WatermarkView" Stretch="UniformToFill" IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                                <TextBlock x:Name="HeaderPreview" VerticalAlignment="Top" HorizontalAlignment="Center"
                                           Foreground="{StaticResource PageMutedBrush}" FontSize="12"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                                <TextBlock x:Name="FooterPreview" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                           Foreground="{StaticResource PageMutedBrush}" FontSize="12"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>

                                <RichTextBox x:Name="Editor"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource InkBrush}"
                                             CaretBrush="#2563EB"
                                             SelectionBrush="{StaticResource PageSelectionBrush}"
                                             FontFamily="Segoe UI" FontSize="15"
                                             VerticalScrollBarVisibility="Disabled"
                                             AcceptsTab="True"
                                             IsDocumentEnabled="True"
                                             Language="de-DE"
                                             SpellCheck.IsEnabled="True"
                                             TextChanged="Editor_TextChanged"
                                             SelectionChanged="Editor_SelectionChanged"
                                             PreviewKeyDown="Editor_PreviewKeyDown"
                                             ContextMenuOpening="Editor_ContextMenuOpening">
                                    <RichTextBox.ContextMenu>
                                        <ContextMenu x:Name="EditorMenu">
                                            <MenuItem Header="Ausschneiden" Command="ApplicationCommands.Cut" InputGestureText="Strg+X"/>
                                            <MenuItem Header="Kopieren" Command="ApplicationCommands.Copy" InputGestureText="Strg+C"/>
                                            <MenuItem Header="Einfügen" Command="ApplicationCommands.Paste" InputGestureText="Strg+V"/>
                                            <Separator/>
                                            <MenuItem x:Name="MenuLink" Header="Link bearbeiten…" Click="InsertLink_Click"/>
                                            <MenuItem x:Name="MenuUnlink" Header="Link entfernen" Click="RemoveLink_Click"/>
                                            <MenuItem Header="Beschriftung einfügen" Click="InsertCaption_Click"/>
                                            <Separator x:Name="MenuTableSep"/>
                                            <MenuItem x:Name="MenuTable" Header="Tabelle">
                                                <MenuItem Header="Zeile darüber einfügen" Click="TableRowAbove_Click"/>
                                                <MenuItem Header="Zeile darunter einfügen" Click="TableRowBelow_Click"/>
                                                <MenuItem Header="Spalte links einfügen" Click="TableColLeft_Click"/>
                                                <MenuItem Header="Spalte rechts einfügen" Click="TableColRight_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Zeile löschen" Click="TableDeleteRow_Click"/>
                                                <MenuItem Header="Spalte löschen" Click="TableDeleteCol_Click"/>
                                                <MenuItem Header="Tabelle löschen" Click="TableDelete_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Zellen verbinden (Auswahl)" Click="TableMergeCells_Click"/>
                                                <MenuItem Header="Zellverbund aufheben" Click="TableUnmergeCell_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Zellenfarbe…" Click="TableCellColor_Click"/>
                                                <MenuItem Header="Zellenfarbe entfernen" Click="TableCellColorClear_Click"/>
                                                <MenuItem Header="Rahmenfarbe…" Click="TableBorderColor_Click"/>
                                                <MenuItem Header="Rahmen ein/aus" Click="TableToggleBorders_Click"/>
                                                <MenuItem Header="Spaltenbreite…" Click="TableColumnWidth_Click"/>
                                            </MenuItem>
                                        </ContextMenu>
                                    </RichTextBox.ContextMenu>
                                </RichTextBox>

                                <!-- Seitenumbruch-Markierungen (Näherung, Layout-Tab) -->
                                <Canvas x:Name="PageBreakLayer" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- Sonderzeichen-Popup -->
            <Popup x:Name="SymbolPopup" PlacementTarget="{Binding ElementName=BtnSymbols}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="SymbolPopup_Closed">
                <Border Background="{DynamicResource Brush.CardBg}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="8" Padding="8" Margin="6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <WrapPanel x:Name="SymbolGrid" Width="308"/>
                </Border>
            </Popup>

            <!-- Formatvorlagen-Flyout (volle Bibliothek) -->
            <Popup x:Name="StylePopup" PlacementTarget="{Binding ElementName=BtnStyleMore}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource Brush.CardBg}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Formatvorlagen" FontWeight="SemiBold" Margin="2,0,0,8"
                                   Foreground="{DynamicResource Brush.Text}"/>
                        <WrapPanel x:Name="StyleGridFull" Width="320"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Formen-Palette -->
            <Popup x:Name="ShapesPopup" Placement="Bottom" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource Brush.CardBg}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Formen" FontWeight="SemiBold" Margin="2,0,0,8"
                                   Foreground="{DynamicResource Brush.Text}"/>
                        <WrapPanel x:Name="ShapesGrid" Width="272"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Aufzählungszeichen-Bibliothek -->
            <Popup x:Name="BulletPopup" Placement="Bottom" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource Brush.CardBg}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Aufzählungszeichen" FontWeight="SemiBold" Margin="2,0,0,8"
                                   Foreground="{DynamicResource Brush.Text}"/>
                        <WrapPanel x:Name="BulletGrid" Width="228"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Nummerierungs-Bibliothek -->
            <Popup x:Name="NumberPopup" Placement="Bottom" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource Brush.CardBg}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Nummerierung" FontWeight="SemiBold" Margin="2,0,0,8"
                                   Foreground="{DynamicResource Brush.Text}"/>
                        <WrapPanel x:Name="NumberGrid" Width="228"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </DockPanel>
</UserControl>
