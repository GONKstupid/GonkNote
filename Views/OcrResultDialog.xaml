<Window x:Class="GonkNote.Views.OcrResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GonkNote.Services"
        Title="{loc:T Ocr.Title}" Width="500" Height="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.WindowBg}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource Brush.Text}"
        ShowInTaskbar="False">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
                   Foreground="{DynamicResource Brush.TextMuted}"
                   TextWrapping="Wrap"
                   Text="{loc:T Ocr.Hint}"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{loc:T Quick.Copy}" Style="{StaticResource FlatButton}" MinWidth="90"
                    Click="Copy_Click" Margin="0,0,8,0"/>
            <Button Content="{loc:T Ocr.AsSticky}" Style="{StaticResource FlatButton}" MinWidth="120"
                    Click="Insert_Click" Margin="0,0,8,0"/>
            <Button Content="{loc:T Window.Close}" Style="{StaticResource AccentButton}" MinWidth="90"
                    IsCancel="True"/>
        </StackPanel>
        <TextBox x:Name="ResultBox" AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="13"
                 VerticalContentAlignment="Top"/>
    </DockPanel>
</Window>
