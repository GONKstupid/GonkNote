<Window x:Class="GonkNote.Views.ChartDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GonkNote.Services"
        Title="{loc:T Chart.Title}" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.WindowBg}"
        FontFamily="{DynamicResource Font.Ui}" FontSize="13"
        Foreground="{DynamicResource Brush.Text}"
        ShowInTaskbar="False">
    <StackPanel Margin="18">
        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="{loc:T Chart.Type}" Width="120" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
            <ComboBox x:Name="TypeCombo" SelectionChanged="Input_Changed">
                <ComboBoxItem Content="{loc:T Chart.Type.Column}" Tag="column" IsSelected="True"/>
                <ComboBoxItem Content="{loc:T Chart.Type.Bar}" Tag="bar"/>
                <ComboBoxItem Content="{loc:T Chart.Type.Line}" Tag="line"/>
                <ComboBoxItem Content="{loc:T Chart.Type.Scatter}" Tag="scatter"/>
                <ComboBoxItem Content="{loc:T Chart.Type.ScatterLine}" Tag="scatterline"/>
                <ComboBoxItem Content="{loc:T Chart.Type.Pie}" Tag="pie"/>
                <ComboBoxItem Content="{loc:T Chart.Type.Radar}" Tag="radar"/>
            </ComboBox>
        </DockPanel>
        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="{loc:T Chart.TitleField}" Width="120" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
            <TextBox x:Name="TitleBox" Text="{loc:T Ed.Chart}" TextChanged="Input_Changed"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="{loc:T Chart.Categories}" Width="120" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
            <TextBox x:Name="LabelsBox" Text="{loc:T Chart.Categories.Example}" TextChanged="Input_Changed"
                     ToolTip="{loc:T Chart.Categories.Hint}"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="{loc:T Chart.SeriesNames}" Width="120" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
            <TextBox x:Name="SeriesBox" Text="{loc:T Chart.Series.Example}" TextChanged="Input_Changed"
                     ToolTip="{loc:T Chart.SeriesNames.Hint}"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,4" VerticalAlignment="Top">
            <TextBlock Text="{loc:T Chart.Values}" Width="120" VerticalAlignment="Top" Margin="0,4,0,0"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
            <TextBox x:Name="ValuesBox" Text="4, 7, 3, 9" TextChanged="Input_Changed"
                     AcceptsReturn="True" Height="58" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     ToolTip="{loc:T Chart.Values.Hint}"/>
        </DockPanel>
        <TextBlock Margin="120,2,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                   Text="{loc:T Chart.Values.Note}"/>
        <DockPanel Margin="0,6,0,0">
            <TextBlock Text="{loc:T Chart.Colors}" Width="120" VerticalAlignment="Top" Margin="0,4,0,0"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
            <!-- WrapPanel: mit dem „+"-Button können beliebig viele Farben dazukommen -->
            <WrapPanel x:Name="ColorRow"/>
        </DockPanel>
        <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="12" Margin="120,4,0,0" TextWrapping="Wrap"/>

        <Border Background="{DynamicResource Brush.CardBg}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="8" Margin="0,12,0,0" Height="240">
            <Image x:Name="Preview" Margin="8"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:T Dlg.Cancel}" Style="{StaticResource FlatButton}" MinWidth="90"
                    IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="{loc:T Ed.Tab.Insert}" Style="{StaticResource AccentButton}" MinWidth="110"
                    Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
