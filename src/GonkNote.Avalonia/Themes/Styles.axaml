<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GonkNote.ViewModels;assembly=GonkNote.ViewModels">

    <!-- Aussehen des Linux-Kopfs. **Die Farben stehen hier nicht** — die kommen aus der
         Farbtabelle in Core und werden von AvaloniaThemeHost als „Brush.X"/„Color.X" in
         die Anwendungsressourcen gelegt. Was hier steht, ist Form: Abstände, Ecken,
         Symbole, das Verhalten unter dem Zeiger.

         Deutlich kürzer als das Gegenstück im WPF-Kopf (Themes/Styles.xaml, 609 Zeilen),
         weil Avalonias Fluent-Theme schon Knöpfe, Menüs, Rollbalken und Baumknoten
         mitbringt; überschrieben wird nur, was anders aussehen soll. -->

    <Styles.Resources>

        <!-- ==== Symbole ==================================================== =====
             Vektorformen im 16×16-Raster, dieselbe Machart wie die Icon.*-Geometrien im
             WPF-Kopf.

             **Warum keine Icon-Schrift:** der WPF-Kopf zeichnet die meisten Symbole mit
             Zeichen aus „Segoe Fluent Icons". Die Schrift gehört zu Windows, lässt sich
             nicht mitliefern und existiert unter Linux nicht — jedes Symbol wäre dort ein
             leeres Kästchen. Vektorformen sind der Weg, den derselbe WPF-Kopf schon geht,
             wo die Schrift nichts Passendes hat.

             Sie werden **gestrichen** gezeichnet (Stroke), nicht gefüllt — Ausnahme
             Icon.Stern. Wer eine hinzufügt, hält sich an 16×16 und an Linien statt
             Flächen, sonst passt sie neben den anderen nicht. -->

        <StreamGeometry x:Key="Icon.Folder">M1.5,4.5 A1,1 0 0 1 2.5,3.5 H6 L7.5,5.5 H13.5 A1,1 0 0 1 14.5,6.5 V12 A1,1 0 0 1 13.5,13 H2.5 A1,1 0 0 1 1.5,12 Z</StreamGeometry>
        <StreamGeometry x:Key="Icon.Notebook">M3.5,2.5 H13 A1,1 0 0 1 14,3.5 V12.5 A1,1 0 0 1 13,13.5 H3.5 Z M6,2.5 V13.5 M8,5.5 H12 M8,8 H12 M8,10.5 H11</StreamGeometry>
        <!-- 1:1 aus src/GonkNote.Wpf/Themes/Styles.xaml — dort hatte die Icon-Schrift für
             das Whiteboard schon nichts Passendes. -->
        <StreamGeometry x:Key="Icon.Whiteboard">M1.5,2.5 H14.5 V11 H1.5 Z M4,7.5 Q6,5 8,7 Q10,9 12,6 M5,11 L3.5,14.5 M11,11 L12.5,14.5</StreamGeometry>
        <StreamGeometry x:Key="Icon.Text">M3.5,1.5 H10 L12.5,4 V14.5 H3.5 Z M10,1.5 V4 H12.5 M5.5,7 H10.5 M5.5,9.5 H10.5 M5.5,12 H8.5</StreamGeometry>

        <!-- Gefüllt: ein gestrichener Stern ist bei 10 px nicht mehr als Stern zu erkennen. -->
        <StreamGeometry x:Key="Icon.Stern">M8,1.8 L9.9,5.9 L14.3,6.4 L11,9.4 L11.9,13.8 L8,11.6 L4.1,13.8 L5,9.4 L1.7,6.4 L6.1,5.9 Z</StreamGeometry>

        <StreamGeometry x:Key="Icon.Pin">M6,1.5 H10 L9.5,6 L12,8.5 H4 L6.5,6 Z M8,8.5 V14.5</StreamGeometry>
        <StreamGeometry x:Key="Icon.Plus">M8,3 V13 M3,8 H13</StreamGeometry>
        <StreamGeometry x:Key="Icon.Schliessen">M4.5,4.5 L11.5,11.5 M11.5,4.5 L4.5,11.5</StreamGeometry>
        <StreamGeometry x:Key="Icon.ChevronUnten">M4,6 L8,10 L12,6</StreamGeometry>
        <StreamGeometry x:Key="Icon.Zurueck">M10,3 L5,8 L10,13</StreamGeometry>
        <StreamGeometry x:Key="Icon.Seitenleiste">M2,3 H14 V13 H2 Z M6.5,3 V13</StreamGeometry>
        <StreamGeometry x:Key="Icon.Design">M13,10.5 A6,6 0 1 1 6,2.2 A5,5 0 0 0 13,10.5 Z</StreamGeometry>

    </Styles.Resources>

    <!-- ==== Knöpfe ==================================================================== -->

    <!-- Flach: kein Rahmen, kein Hintergrund — bis der Zeiger darüber steht. -->
    <Style Selector="Button.flach">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.flach:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
    </Style>
    <Style Selector="Button.flach:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Pressed}"/>
    </Style>

    <!-- Symbolknopf: quadratisch, nur die Form darin. -->
    <Style Selector="Button.symbol">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Der Akzentknopf („Neu" in der Galerie). -->
    <Style Selector="Button.akzent">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.akzent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Opacity" Value="0.88"/>
    </Style>

    <!-- Galerie-Kachel: die Fläche darf nur andeuten, dass sie anklickbar ist. -->
    <Style Selector="Button.kachel">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Width" Value="168"/>
        <Setter Property="Margin" Value="8,8,8,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.kachel:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
    </Style>

    <!-- Angepinnter Ordner: die Icon-Kachel im Schnellzugriff (angelehnt an Zen-Browser). -->
    <Style Selector="Button.pinkachel">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Background" Value="{DynamicResource Brush.CardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.pinkachel:pointerover /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.CardBg}"/>
    </Style>

    <!-- Pfadleiste über dem Galerietitel: wie Text, nicht wie ein Knopf. -->
    <Style Selector="Button.pfad">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="3,0"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.pfad:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
    </Style>

    <!-- ==== Symbolformen ============================================================= -->

    <!-- Gestrichene Symbole. Die Farbe setzt jede Fundstelle selbst (Ordnerfarbe,
         zurückgenommener Text, Weiß auf dem Akzentknopf) — hier steht nur die Machart. -->
    <Style Selector="Path.symbol">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="StrokeThickness" Value="1.3"/>
        <Setter Property="StrokeLineCap" Value="Round"/>
        <Setter Property="StrokeJoin" Value="Round"/>
        <Setter Property="Stretch" Value="None"/>
    </Style>

    <!-- ==== Baum ===================================================================== -->

    <Style Selector="TreeView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <!-- Aufklappzustand und Auswahl gehören dem ViewModel, nicht dem Knoten: MainViewModel
         klappt beim Springen zu einem Eintrag dessen Vorfahren auf (RevealItem). Ohne die
         beiden Zeilen bliebe der Baum stehen und nur die Galerie wechselte.
         Dieselben zwei Setter stehen im WPF-Kopf (Themes/Styles.xaml, TreeViewItem). -->
    <Style Selector="TreeViewItem" x:DataType="vm:TreeItemViewModel">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
    </Style>

    <!-- ==== Registerkarten ============================================================ -->

    <Style Selector="TabControl">
        <Setter Property="Background" Value="{DynamicResource Brush.WindowBg}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <!-- ==== Menüleiste ================================================================ -->

    <Style Selector="Menu">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Menu > MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Padding" Value="10,5"/>
    </Style>

</Styles>
