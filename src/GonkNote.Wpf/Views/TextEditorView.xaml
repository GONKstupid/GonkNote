<UserControl x:Class="GonkNote.Views.TextEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GonkNote.Views"
             xmlns:loc="clr-namespace:GonkNote.Services">
    <UserControl.Resources>
        <!-- Die Dokumentseite bleibt in beiden Themes weiß (Nutzer-Wunsch: Papier ist
             Papier); nur die Umgebung (Canvas) folgt dem Theme. Deshalb sind Seite,
             Tinte und Markierung feste helle Werte. -->
        <SolidColorBrush x:Key="PageBgBrush"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InkBrush"          Color="#1B2B4B"/>
        <SolidColorBrush x:Key="PageSelectionBrush" Color="#C7DBFF"/>
        <SolidColorBrush x:Key="PageMutedBrush"    Color="#6B7A99"/>
        <SolidColorBrush x:Key="CanvasBgBrush" Color="{DynamicResource Color.CanvasBg}"/>

        <!-- Hier stand bis zum 2026-08-12 der Stil "PathIcon" (TargetType="Path") für die
             Symbole dieser Leiste. Mit §4.31 sind aus den <Path> <views:Symbol> geworden,
             und ein Path-Stil an einem Symbol wirft: "TargetType Path entspricht nicht dem
             Typ des Elements Symbol". Der Texteditor ließ sich damit gar nicht mehr öffnen.
             Ersatzlos weg, denn views:Symbol bringt alles davon selbst mit: Strichstärke aus
             der Tabelle (AppIcons.StrokeFor), runde Kappen fest, Größe über Size. -->

        <!-- Ribbon-Tab: Aktivierung über 2-px-Unterstrich in Akzentfarbe (Design-Konzept 7.2) -->
        <Style x:Key="RibbonTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <ContentPresenter x:Name="content" Margin="12,5,12,7"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Rectangle x:Name="underline" Height="2" VerticalAlignment="Bottom"
                                       Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed"
                                       Margin="10,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="underline" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button mit Icon + Beschriftung (für Einfügen/Layout/Verweise) -->
        <Style x:Key="LabelButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <!-- Formatvorlagen-Karte: Vorschau auf Seitenhintergrund (WYSIWYG, Design-Konzept 7.4) -->
        <Style x:Key="StyleCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource PageBgBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Margin="2,0" Width="96" Height="44">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Schmale Zahlenfelder (cm-/pt-Eingaben im Ribbon) -->
        <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GroupSep" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Margin" Value="7,4"/>
        </Style>

        <!-- Dropdown-Sammelbutton (Icon + Chevron, öffnet sein ContextMenu) -->
        <Style x:Key="DropButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <Style x:Key="RibbonLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,4,0"/>
        </Style>

        <!-- Icon-Leisten-Button links (Design-Konzept 7.5) -->
        <Style x:Key="SideIconButton" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent" Height="40">
                            <Rectangle x:Name="marker" Width="3" HorizontalAlignment="Left"
                                       Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed"/>
                            <Border x:Name="bd" Background="Transparent" CornerRadius="6" Margin="6,4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="marker" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>

        <!-- ===================== Ribbon (Tab-Leiste + Werkzeugleiste) ===================== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.ToolbarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <StackPanel>

                <!-- Tab-Leiste mit Schnellzugriff (Undo/Redo) links -->
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="{views:Icon Undo}" Width="28" Height="26"
                                ToolTip="{loc:T Action.Undo}" Click="Undo_Click" Margin="6,2,0,0"
                                AutomationProperties.Name="{loc:T Action.Undo.Short}"/>
                        <Button Style="{StaticResource IconButton}" Content="{views:Icon Redo}" Width="28" Height="26"
                                ToolTip="{loc:T Action.Redo}" Click="Redo_Click" Margin="0,2,4,0"
                                AutomationProperties.Name="{loc:T Action.Redo.Short}"/>
                        <Border Style="{StaticResource GroupSep}"/>
                        <RadioButton x:Name="TabStart" Style="{StaticResource RibbonTab}" Content="{loc:T Ed.Tab.Home}"
                                     IsChecked="True" Checked="RibbonTab_Checked" Tag="Start"/>
                        <RadioButton Style="{StaticResource RibbonTab}" Content="{loc:T Ed.Tab.Insert}"
                                     Checked="RibbonTab_Checked" Tag="Einfügen"/>
                        <RadioButton Style="{StaticResource RibbonTab}" Content="{loc:T Ed.Tab.Layout}"
                                     Checked="RibbonTab_Checked" Tag="Layout"/>
                        <RadioButton Style="{StaticResource RibbonTab}" Content="{loc:T Ed.Tab.References}"
                                     Checked="RibbonTab_Checked" Tag="Verweise"/>
                        <!-- Kontext-Tab wie Words „Tabellentools": nur sichtbar, wenn der
                             Cursor in einer Tabelle steht (UpdateTableRibbon) -->
                        <RadioButton x:Name="TabTable" Style="{StaticResource RibbonTab}" Content="{loc:T Ed.Tab.Table}"
                                     Checked="RibbonTab_Checked" Tag="Tabelle" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <!-- ============ Werkzeugleiste: Start ============ -->
                <WrapPanel x:Name="PanelStart" Margin="8,2,8,6">
                    <ToggleButton x:Name="BtnFormatPainter" Style="{StaticResource ToolButton}" Width="32" Height="30"
                                  Click="FormatPainter_Click" ToolTip="{loc:T Ed.FormatPainter.Tip}"
                                  AutomationProperties.Name="{loc:T Ed.FormatPainter}" Content="{views:Icon FormatPainter}"/>
                    <Button Style="{StaticResource IconButton}" Height="30" ToolTip="{loc:T Ed.ClearFormat}" Click="ClearFormat_Click">
                        <TextBlock FontFamily="Segoe UI" FontSize="12">
                            <Run Text="A"/><Run Text="a" FontSize="9"/><Run Text="✕" FontSize="8"/>
                        </TextBlock>
                    </Button>

                    <Border Style="{StaticResource GroupSep}"/>

                    <ComboBox x:Name="FontCombo" Width="136" SelectionChanged="FontCombo_Changed" ToolTip="{loc:T Ed.Font}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Vorschau: jeder Eintrag in seiner eigenen Schrift -->
                                <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox x:Name="SizeCombo" Width="54" Margin="4,0,0,0" SelectionChanged="SizeCombo_Changed"
                              ToolTip="{loc:T Ed.FontSize}"/>
                    <Button Style="{StaticResource IconButton}" Height="30" Content="{views:Icon FontGrow}" ToolTip="{loc:T Ed.FontGrow}"
                            Command="EditingCommands.IncreaseFontSize" CommandTarget="{Binding ElementName=Editor}"/>
                    <Button Style="{StaticResource IconButton}" Height="30" Content="{views:Icon FontShrink}" ToolTip="{loc:T Ed.FontShrink}"
                            Command="EditingCommands.DecreaseFontSize" CommandTarget="{Binding ElementName=Editor}"/>

                    <Border Style="{StaticResource GroupSep}"/>

                    <ToggleButton x:Name="BtnBold" Style="{StaticResource ToolButton}" Width="30" Height="30"
                                  Click="Bold_Click" ToolTip="{loc:T Ed.Bold}">
                        <TextBlock Text="F" FontWeight="Bold" FontFamily="Segoe UI"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnItalic" Style="{StaticResource ToolButton}" Width="30" Height="30"
                                  Click="Italic_Click" ToolTip="{loc:T Ed.Italic}">
                        <TextBlock Text="K" FontStyle="Italic" FontFamily="Segoe UI"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnUnderline" Style="{StaticResource ToolButton}" Width="30" Height="30"
                                  Click="Underline_Click" ToolTip="{loc:T Ed.Underline}">
                        <TextBlock Text="U" TextDecorations="Underline" FontFamily="Segoe UI"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnStrike" Style="{StaticResource ToolButton}" Width="30" Height="30"
                                  Click="Strike_Click" ToolTip="{loc:T Ed.Strike}">
                        <TextBlock Text="S" TextDecorations="Strikethrough" FontFamily="Segoe UI"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnSub" Style="{StaticResource ToolButton}" Width="30" Height="30" FontFamily="Segoe UI"
                                  Content="x₂" Click="Sub_Click" ToolTip="{loc:T Ed.Subscript}"/>
                    <ToggleButton x:Name="BtnSuper" Style="{StaticResource ToolButton}" Width="30" Height="30" FontFamily="Segoe UI"
                                  Content="x²" Click="Super_Click" ToolTip="{loc:T Ed.Superscript}"/>

                    <Border Style="{StaticResource GroupSep}"/>

                    <Button Style="{StaticResource IconButton}" Height="30" Click="ApplyTextColor_Click" ToolTip="{loc:T Ed.TextColor.Apply}">
                        <StackPanel>
                            <TextBlock Text="A" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="13"
                                       HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                            <Rectangle x:Name="TextColorBar" Height="3" Width="14" Fill="#EC4899" RadiusX="1" RadiusY="1"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="{views:Icon ChevronDown, Size=8}" FontSize="8" Height="30"
                            ToolTip="{loc:T Ed.TextColor.Pick}" Width="16" Click="PickTextColor_Click"/>
                    <Button Style="{StaticResource IconButton}" Height="30" Click="ApplyHighlight_Click" ToolTip="{loc:T Ed.Highlight.Apply}">
                        <StackPanel>
                            <views:Symbol Icon="Highlighter" Size="11"
                                       HorizontalAlignment="Center"/>
                            <Rectangle x:Name="HighlightBar" Height="3" Width="14" Fill="#FDE047" RadiusX="1" RadiusY="1"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="{views:Icon ChevronDown, Size=8}" FontSize="8" Height="30"
                            ToolTip="{loc:T Ed.Highlight.Pick}" Width="16" Click="PickHighlight_Click"/>

                    <Border Style="{StaticResource GroupSep}"/>

                    <!-- Ein Sammel-Button für alle Textausrichtungen -->
                    <Button x:Name="BtnAlign" Style="{StaticResource DropButton}" Click="OpenDropdown_Click"
                            ToolTip="{loc:T Ed.Align}" AutomationProperties.Name="{loc:T Ed.Align}">
                        <StackPanel Orientation="Horizontal">
                            <views:Symbol x:Name="AlignGlyph"
                                  Icon="AlignLeft" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <views:Symbol Icon="ChevronDown" Size="8"
                                       Margin="5,0,0,0" VerticalAlignment="Center"
                                       Stroke="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="AlignItemLeft" Header="{loc:T Ed.Align.Left}" Tag="Left" Click="AlignMenu_Click"/>
                                <MenuItem x:Name="AlignItemCenter" Header="{loc:T Ed.Align.Center}" Tag="Center" Click="AlignMenu_Click"/>
                                <MenuItem x:Name="AlignItemRight" Header="{loc:T Ed.Align.Right}" Tag="Right" Click="AlignMenu_Click"/>
                                <MenuItem x:Name="AlignItemJustify" Header="{loc:T Ed.Align.Justify}" Tag="Justify" Click="AlignMenu_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Aufzählung: Split-Button (Klick = umschalten, Pfeil = Stil-Bibliothek) -->
                    <Button x:Name="BtnBullets" Style="{StaticResource IconButton}" Height="30" Content="{views:Icon List}"
                            ToolTip="{loc:T Ed.List.Bullet}" Click="ToggleBullets_Click"
                            AutomationProperties.Name="{loc:T Ed.List.Bullet}"/>
                    <Button Style="{StaticResource IconButton}" Height="30" Width="16" Content="{views:Icon ChevronDown, Size=8}" FontSize="8"
                            ToolTip="{loc:T Ed.List.BulletPick}" Click="OpenBulletLibrary_Click"/>

                    <!-- Nummerierung: Split-Button -->
                    <Button x:Name="BtnNumbering" Style="{StaticResource IconButton}" Height="30" FontFamily="Segoe UI"
                            Content="№" ToolTip="{loc:T Ed.List.Number}" Click="ToggleNumbering_Click"
                            AutomationProperties.Name="{loc:T Ed.List.Number}"/>
                    <Button Style="{StaticResource IconButton}" Height="30" Width="16" Content="{views:Icon ChevronDown, Size=8}" FontSize="8"
                            ToolTip="{loc:T Ed.List.NumberPick}" Click="OpenNumberLibrary_Click"/>

                    <Button Style="{StaticResource IconButton}" Height="30" ToolTip="{loc:T Ed.Indent.More}"
                            Click="IndentInc_Click">
                        <views:Symbol Icon="IndentIncrease"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Height="30" ToolTip="{loc:T Ed.Indent.Less}"
                            Click="IndentDec_Click">
                        <views:Symbol Icon="IndentDecrease"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>

                    <Border Style="{StaticResource GroupSep}"/>

                    <!-- Formatvorlagen: 3 Kacheln inline + Aufklapp-Pfeil (Rest im Flyout) -->
                    <StackPanel x:Name="StyleGallery" Orientation="Horizontal"/>
                    <Button x:Name="BtnStyleMore" Style="{StaticResource IconButton}" Height="44" Width="20"
                            Content="{views:Icon ChevronDown, Size=9}" FontSize="9" ToolTip="{loc:T Ed.Styles.All}"
                            Click="OpenStyleGallery_Click" AutomationProperties.Name="{loc:T Ed.Styles.All}"/>
                </WrapPanel>

                <!-- ============ Werkzeugleiste: Einfügen ============ -->
                <WrapPanel x:Name="PanelInsert" Margin="8,2,8,6" Visibility="Collapsed">
                    <!-- Tabelle: Raster-Auswahl (wie Word) + Dialog/Umwandeln/Schnelltabellen -->
                    <Button x:Name="BtnInsertTable" Style="{StaticResource LabelButton}" Click="TableMenu_Click"
                            AutomationProperties.Name="{loc:T Ed.Table.Insert}">
                        <StackPanel Orientation="Horizontal">
                            <views:Symbol Icon="Table"
                                  Stroke="{DynamicResource Brush.TextMuted}"/>
                            <TextBlock Text="{loc:T Ed.Tab.Table}" Margin="6,0,0,0"/>
                            <views:Symbol Icon="ChevronDown" Size="9"
                                       Margin="5,2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Popup x:Name="TableGridPopup" PlacementTarget="{Binding ElementName=BtnInsertTable}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{DynamicResource Brush.CardBg}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="8" Padding="10" Margin="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock x:Name="TableGridLabel" Text="{loc:T Ed.Table.Insert}"
                                           Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,6"/>
                                <!-- 8×10-Raster; Kacheln entstehen im Code (BuildTableGrid) -->
                                <UniformGrid x:Name="TableGrid" Columns="10" Rows="8"/>
                                <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,8,0,4"/>
                                <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left" Content="{loc:T Ed.Table.InsertDialog}"
                                        Click="InsertTableDialog_Click"/>
                                <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left" Content="{loc:T Ed.Table.FromText}"
                                        ToolTip="{loc:T Ed.Table.FromText.Tip}"
                                        Click="TextToTable_Click"/>
                                <TextBlock Text="{loc:T Ed.Table.Quick}" Style="{StaticResource RibbonLabel}" Margin="2,6,0,2"/>
                                <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left" Content="{loc:T Ed.Table.Quick.Calendar}"
                                        Click="QuickTableCalendar_Click"/>
                                <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left" Content="{loc:T Ed.Table.Quick.List}"
                                        Click="QuickTableList_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button Style="{StaticResource LabelButton}" Click="InsertImage_Click"
                            AutomationProperties.Name="{loc:T Ed.Image.Insert}">
                        <StackPanel Orientation="Horizontal">
                            <views:Symbol Icon="Image" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:T Ed.Image}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LabelButton}" Click="InsertInfoBox_Click"
                            ToolTip="{loc:T Ed.InfoBox.Tip}"
                            AutomationProperties.Name="{loc:T Ed.InfoBox.Insert}">
                        <StackPanel Orientation="Horizontal">
                            <views:Symbol Icon="TextDocument" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:T Ed.InfoBox}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LabelButton}" Content="{loc:T Ed.Rule}" Click="InsertRule_Click"/>

                    <Border Style="{StaticResource GroupSep}"/>

                    <ToggleButton x:Name="BtnSymbols" Style="{StaticResource ToolButton}" Width="Auto" Height="30"
                                  Click="ToggleSymbols_Click" ToolTip="{loc:T Ed.Symbol.Insert}"
                                  AutomationProperties.Name="{loc:T Ed.Symbol}">
                        <TextBlock Text="{loc:T Ed.Symbol.Button}" FontFamily="Segoe UI"/>
                    </ToggleButton>
                    <Button Style="{StaticResource LabelButton}" Click="OpenChart_Click"
                            ToolTip="{loc:T Ed.Chart.Tip}"
                            AutomationProperties.Name="{loc:T Ed.Chart}">
                        <StackPanel Orientation="Horizontal">
                            <views:Symbol Icon="Chart" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:T Ed.Chart}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource GroupSep}"/>

                    <Button Style="{StaticResource LabelButton}" Content="{loc:T Ed.HeaderFooter.Dialog}" Click="EditHeaderFooter_Click"
                            AutomationProperties.Name="{loc:T Ed.HeaderFooter}"/>
                    <Button Style="{StaticResource LabelButton}" Content="{loc:T Ed.PageNumbers}" Click="InsertPageNumbers_Click"
                            ToolTip="{loc:T Ed.PageNumbers.Tip}"
                            AutomationProperties.Name="{loc:T Ed.PageNumbers}"/>
                </WrapPanel>

                <!-- ============ Werkzeugleiste: Layout ============ -->
                <WrapPanel x:Name="PanelLayout" Margin="8,2,8,6" Visibility="Collapsed">
                    <TextBlock Text="{loc:T Ed.Layout.Format}" Style="{StaticResource RibbonLabel}"/>
                    <ComboBox x:Name="FormatCombo" Width="72" SelectionChanged="PageFormat_Changed" ToolTip="{loc:T Ed.Layout.PaperSize}">
                        <ComboBoxItem Content="A4" IsSelected="True"/>
                        <ComboBoxItem Content="A5"/>
                        <ComboBoxItem Content="A3"/>
                        <ComboBoxItem Content="{loc:T Ed.Layout.Letter}"/>
                    </ComboBox>
                    <ToggleButton x:Name="BtnPortrait" Style="{StaticResource ToolButton}" Width="Auto" Height="28"
                                  Margin="6,0,0,0" Click="Orientation_Click" Tag="P" ToolTip="{loc:T Ed.Layout.Portrait}">
                        <TextBlock Text="{loc:T Ed.Layout.Portrait.Short}" FontFamily="Segoe UI" FontSize="12"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnLandscape" Style="{StaticResource ToolButton}" Width="Auto" Height="28"
                                  Click="Orientation_Click" Tag="L" ToolTip="{loc:T Ed.Layout.Landscape}">
                        <TextBlock Text="{loc:T Ed.Layout.Landscape.Short}" FontFamily="Segoe UI" FontSize="12"/>
                    </ToggleButton>

                    <Border Style="{StaticResource GroupSep}"/>

                    <!-- Detaileinstellungen wandern in die Seitenleiste rechts -->
                    <Button Style="{StaticResource LabelButton}" Click="OpenMargins_Click"
                            ToolTip="{loc:T Ed.Layout.Margins.Tip}" AutomationProperties.Name="{loc:T Ed.Layout.Margins}">
                        <StackPanel Orientation="Horizontal">
                            <views:Symbol Icon="Margins" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:T Ed.Layout.Margins}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LabelButton}" Click="OpenSpacing_Click"
                            ToolTip="{loc:T Ed.Layout.Spacing.Tip}" AutomationProperties.Name="{loc:T Ed.Layout.Spacing}">
                        <StackPanel Orientation="Horizontal">
                            <views:Symbol Icon="LineSpacing" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:T Ed.Layout.Spacing}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LabelButton}" Click="OpenWatermark_Click"
                            ToolTip="{loc:T Ed.Layout.Background.Tip}" AutomationProperties.Name="{loc:T Ed.Layout.Background}">
                        <StackPanel Orientation="Horizontal">
                            <views:Symbol Icon="Background" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:T Ed.Layout.Background}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource GroupSep}"/>

                    <CheckBox x:Name="BreaksCheck" Content="{loc:T Ed.Layout.PageBreaks}" VerticalAlignment="Center"
                              Foreground="{DynamicResource Brush.Text}" Margin="4,0"
                              Checked="PageBreaks_Toggled" Unchecked="PageBreaks_Toggled"
                              ToolTip="{loc:T Ed.Layout.PageBreaks.Tip}"
                              AutomationProperties.Name="{loc:T Ed.Layout.PageBreaks}"/>
                </WrapPanel>

                <!-- ============ Werkzeugleiste: Verweise ============ -->
                <WrapPanel x:Name="PanelRefs" Margin="8,2,8,6" Visibility="Collapsed">
                    <Button Style="{StaticResource LabelButton}" Click="InsertToc_Click"
                            ToolTip="{loc:T Ed.Toc.Insert.Tip}"
                            AutomationProperties.Name="{loc:T Ed.Toc.Insert}">
                        <StackPanel Orientation="Horizontal">
                            <!-- **Outline und nicht List** (§4.38): `List` steht im Reiter
                                 „Start" für die Aufzählung. Dieselbe Form für zwei Bedeutungen
                                 ist genau der Fehler, den §4.31 beim Symbolsatz aufgeräumt hat —
                                 er war hier stehengeblieben. Der Linux-Kopf hatte es von Anfang
                                 an richtig; angeglichen wird deshalb hier. -->
                            <views:Symbol Icon="Outline" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:T Ed.Toc.Insert}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LabelButton}" Content="{loc:T Ed.Toc.Update.Short}" Click="UpdateToc_Click"
                            ToolTip="{loc:T Ed.Toc.Update.Tip}"
                            AutomationProperties.Name="{loc:T Ed.Toc.Update}"/>

                    <Border Style="{StaticResource GroupSep}"/>

                    <Button Style="{StaticResource LabelButton}" Click="InsertLink_Click"
                            ToolTip="{loc:T Ed.Link.Tip}" AutomationProperties.Name="{loc:T Ed.Link.Insert}">
                        <StackPanel Orientation="Horizontal">
                            <views:Symbol Icon="Link" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:T Ed.Link}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LabelButton}" Click="InsertCaption_Click"
                            ToolTip="{loc:T Ed.Caption.Tip}"
                            AutomationProperties.Name="{loc:T Ed.Caption.Insert}">
                        <StackPanel Orientation="Horizontal">
                            <views:Symbol Icon="Caption" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:T Ed.Caption}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Hinweis hinter Info-i (nur bei Hover/Klick) -->
                    <Button Style="{StaticResource IconButton}" Height="30" Width="26" Content="{views:Icon Info}"
                            Foreground="{DynamicResource Brush.TextMuted}" ToolTipService.InitialShowDelay="150"
                            ToolTipService.ShowDuration="20000" AutomationProperties.Name="{loc:T Ed.References.NoteName}">
                        <Button.ToolTip>
                            <ToolTip MaxWidth="320">
                                <TextBlock TextWrapping="Wrap"
                                           Text="{loc:T Ed.References.Note}"/>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                </WrapPanel>

                <!-- ============ Werkzeugleiste: Tabelle (Kontext-Tab) ============ -->
                <!-- Schlank gehalten: nur die häufigen Struktur-/Daten-Aktionen; Design,
                     Rahmen, Füllung und Größe liegen in der Seitenleiste („Design & Rahmen…"). -->
                <WrapPanel x:Name="PanelTable" Margin="8,2,8,6" Visibility="Collapsed">

                    <!-- Zeilen (Sammel-Dropdown) -->
                    <Button Style="{StaticResource DropButton}" Click="RowMenu_Click">
                        <StackPanel Orientation="Horizontal">
                            <views:Symbol Size="15"
                                  Icon="Table" Stroke="{DynamicResource Brush.TextMuted}"/>
                            <TextBlock Text="{loc:T Ed.Table.Row}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <views:Symbol Icon="ChevronDown" Size="9"
                                       Margin="5,2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:T Ed.Table.Row.Above}" Click="TableRowAbove_Click"/>
                                <MenuItem Header="{loc:T Ed.Table.Row.Below}" Click="TableRowBelow_Click"/>
                                <Separator/>
                                <MenuItem Header="{loc:T Ed.Table.Row.Delete}" Click="TableDeleteRow_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <!-- Spalten (Sammel-Dropdown) -->
                    <Button Style="{StaticResource DropButton}" Click="ColMenu_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T Ed.Table.Column}" VerticalAlignment="Center"/>
                            <views:Symbol Icon="ChevronDown" Size="9"
                                       Margin="5,2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:T Ed.Table.Column.Left}" Click="TableColLeft_Click"/>
                                <MenuItem Header="{loc:T Ed.Table.Column.Right}" Click="TableColRight_Click"/>
                                <Separator/>
                                <MenuItem Header="{loc:T Ed.Table.Column.Delete}" Click="TableDeleteCol_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Border Style="{StaticResource GroupSep}"/>

                    <!-- Verbinden & Teilen -->
                    <Button Style="{StaticResource LabelButton}" Content="{loc:T Ed.Table.Merge}" Click="TableMergeCells_Click"
                            ToolTip="{loc:T Ed.Table.Merge.Tip}"/>
                    <Button Style="{StaticResource DropButton}" Click="SplitMenu_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T Ed.Table.Split}" VerticalAlignment="Center"/>
                            <views:Symbol Icon="ChevronDown" Size="9"
                                       Margin="5,2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:T Ed.Table.Unmerge}" Click="TableUnmergeCell_Click"/>
                                <MenuItem Header="{loc:T Ed.Table.SplitCell}" Click="TableSplitCell_Click"/>
                                <Separator/>
                                <MenuItem Header="{loc:T Ed.Table.SplitTable}" Click="TableSplitTable_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Border Style="{StaticResource GroupSep}"/>

                    <!-- Daten -->
                    <Button Style="{StaticResource LabelButton}" Content="{loc:T Ed.Table.Sort}" Click="TableSort_Click"
                            ToolTip="{loc:T Ed.Table.Sort.Tip}"/>
                    <Button Style="{StaticResource LabelButton}" Content="{loc:T Ed.Table.Formula}" Click="TableFormula_Click"
                            ToolTip="{loc:T Ed.Table.Formula.Tip}"/>
                    <Button Style="{StaticResource LabelButton}" Content="{loc:T Ed.Table.ToText}" Click="TableToText_Click"
                            ToolTip="{loc:T Ed.Table.ToText.Tip}"/>

                    <Border Style="{StaticResource GroupSep}"/>

                    <!-- Design/Rahmen/Größe → Seitenleiste -->
                    <Button Style="{StaticResource LabelButton}" Click="OpenTableDesign_Click"
                            ToolTip="{loc:T Ed.Table.Design.Tip}">
                        <StackPanel Orientation="Horizontal">
                            <views:Symbol Icon="Palette" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:T Ed.Table.Design}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource GroupSep}"/>

                    <Button Style="{StaticResource LabelButton}" Content="{loc:T Ed.Table.Delete}" Click="TableDelete_Click"/>

                    <!-- Hinweis: was WPF nicht kann (ehrliches Scoping) -->
                    <Button Style="{StaticResource IconButton}" Height="30" Width="26" Content="{views:Icon Info}"
                            Foreground="{DynamicResource Brush.TextMuted}" ToolTipService.InitialShowDelay="150"
                            ToolTipService.ShowDuration="20000" AutomationProperties.Name="{loc:T Ed.Table.NoteName}">
                        <Button.ToolTip>
                            <ToolTip MaxWidth="340">
                                <TextBlock TextWrapping="Wrap"
                                           Text="{loc:T Ed.Table.Note}"/>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ===== Suchen &amp; Ersetzen ===== -->
        <Border x:Name="FindPanel" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="{DynamicResource Brush.SidebarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="FindBox" Width="180" KeyDown="FindBox_KeyDown" ToolTip="{loc:T Ed.Find.Term}"/>
                <Button Style="{StaticResource FlatButton}" Content="{loc:T Ed.Find.Next}" Margin="6,0,0,0" Click="FindNext_Click"/>
                <TextBox x:Name="ReplaceBox" Width="180" Margin="12,0,0,0" ToolTip="{loc:T Ed.Find.ReplaceWith}"/>
                <Button Style="{StaticResource FlatButton}" Content="{loc:T Ed.Find.Replace}" Margin="6,0,0,0" Click="ReplaceOne_Click"/>
                <Button Style="{StaticResource FlatButton}" Content="{loc:T Ed.Find.ReplaceAll}" Margin="2,0,0,0" Click="ReplaceAll_Click"/>
                <TextBlock x:Name="FindStatus" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
                <Button Style="{StaticResource IconButton}" Content="{views:Icon Close, Size=10}" FontSize="10" Margin="6,0,0,0"
                        ToolTip="{loc:T Ed.Find.Close}" Click="CloseFind_Click"/>
            </StackPanel>
        </Border>

        <!-- ===================== Statusleiste ===================== -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.SidebarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="10,2">
            <DockPanel>
                <TextBlock x:Name="WordCountText" DockPanel.Dock="Left" Text="{loc:T Ed.Status.Counts}"
                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" VerticalAlignment="Center"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <views:Symbol x:Name="SpellLangWarn" Icon="Warning" Stroke="#F59E0B" VerticalAlignment="Center" Margin="0,0,6,0"
                               Visibility="Collapsed" Cursor="Help"
                               ToolTipService.ShowDuration="20000"/>
                    <ComboBox x:Name="LanguageCombo" Width="86" Height="24" FontSize="12"
                              SelectionChanged="Language_Changed" ToolTip="{loc:T Ed.Spell.Language}">
                        <ComboBoxItem Content="{loc:T Lang.German}" Tag="de-DE" IsSelected="True"/>
                        <ComboBoxItem Content="{loc:T Lang.English}" Tag="en-US"/>
                    </ComboBox>
                    <ToggleButton x:Name="BtnSpell" Style="{StaticResource ToolButton}" Width="Auto" Height="24"
                                  Margin="6,0" IsChecked="True" Click="Spell_Click"
                                  ToolTip="{loc:T Ed.Spell.Toggle}" AutomationProperties.Name="{loc:T Ed.Spell}">
                        <TextBlock Text="{loc:T Ed.Spell.Button}" FontFamily="Segoe UI" FontSize="11"/>
                    </ToggleButton>

                    <Border Style="{StaticResource GroupSep}"/>

                    <Button Style="{StaticResource IconButton}" Content="{views:Icon ZoomOut, Size=11}" Width="24" Height="24" FontSize="11"
                            Click="ZoomOut_Click" ToolTip="{loc:T Zoom.Out}" AutomationProperties.Name="{loc:T Zoom.Out.Long}"/>
                    <Slider x:Name="ZoomSlider" Width="90" Minimum="50" Maximum="200" Value="100"
                            ValueChanged="Zoom_Changed" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" Content="{views:Icon ZoomIn, Size=11}" Width="24" Height="24" FontSize="11"
                            Click="ZoomIn_Click" ToolTip="{loc:T Zoom.In}" AutomationProperties.Name="{loc:T Zoom.In.Long}"/>
                    <TextBlock x:Name="ZoomText" Text="100 %" Width="42" TextAlignment="Right"
                               Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <Border/>
            </DockPanel>
        </Border>

        <!-- ===================== Linke Icon-Leiste ===================== -->
        <Border DockPanel.Dock="Left" Width="42" Background="{DynamicResource Brush.SidebarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <StackPanel>
                <ToggleButton x:Name="BtnSideFind" Style="{StaticResource SideIconButton}" Content="{views:Icon Search}"
                              Click="ToggleFind_Click" ToolTip="{loc:T Ed.Find.Tip}"
                              AutomationProperties.Name="{loc:T Ed.Find}"/>
                <ToggleButton x:Name="BtnSideNav" Style="{StaticResource SideIconButton}" Content="{views:Icon Outline}"
                              Click="ToggleNavigator_Click" ToolTip="{loc:T Ed.Navigator.Tip}"
                              AutomationProperties.Name="{loc:T Ed.Navigator}"/>
            </StackPanel>
        </Border>

        <!-- Überschriften-Navigator -->
        <Border x:Name="NavPanel" DockPanel.Dock="Left" Width="210" Visibility="Collapsed"
                Background="{DynamicResource Brush.SidebarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,8">
                <TextBlock DockPanel.Dock="Top" Text="{loc:T Ed.Navigator}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,6"/>
                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="NavList_Selected"
                         Foreground="{DynamicResource Brush.Text}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <!-- Theme-taugliche Einträge (Standard-Template wäre schwarz auf dunkel) -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="5"
                                                Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background"
                                                        Value="{DynamicResource Brush.Hover}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource Brush.TextMuted}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===================== Einstellungs-Seitenleiste (rechts, ausklappbar) ===================== -->
        <Border x:Name="SettingsPanel" DockPanel.Dock="Right" Width="248" Visibility="Collapsed"
                Background="{DynamicResource Brush.SidebarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="12,10,8,6">
                    <TextBlock Text="{loc:T Ed.Advanced}" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" Content="{views:Icon Close, Size=10}" FontSize="10" Width="26" Height="26"
                            HorizontalAlignment="Right" ToolTip="{loc:T Window.Close}" Click="CloseSettings_Click"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0,12,12">

                        <!-- Es ist immer nur die über den jeweiligen Button geöffnete
                             Sektion sichtbar (OpenSettings steuert die Visibility). -->
                        <Expander x:Name="SecMargins" Header="{loc:T Ed.Layout.Margins}" IsExpanded="True" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="{loc:T Ed.Margins.Preset}" Style="{StaticResource RibbonLabel}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="MarginPresetCombo" SelectionChanged="MarginPreset_Changed">
                                    <ComboBoxItem Content="{loc:T Ed.Margins.Normal}"/>
                                    <ComboBoxItem Content="{loc:T Ed.Margins.Narrow}"/>
                                    <ComboBoxItem Content="{loc:T Ed.Margins.Wide}"/>
                                    <ComboBoxItem Content="{loc:T Ed.Margins.Study}"/>
                                    <ComboBoxItem Content="{loc:T Ed.Margins.Custom}"/>
                                </ComboBox>
                                <UniformGrid Columns="2" Margin="0,8,0,0">
                                    <DockPanel Margin="0,0,4,6">
                                        <TextBlock Text="{loc:T Ed.Margins.Left}" Width="42" Style="{StaticResource RibbonLabel}"/>
                                        <TextBox x:Name="MarginL" Style="{StaticResource NumBox}" Width="Auto"
                                                 LostFocus="Margin_Changed" KeyDown="NumBox_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="{loc:T Ed.Margins.Top}" Width="42" Style="{StaticResource RibbonLabel}"/>
                                        <TextBox x:Name="MarginT" Style="{StaticResource NumBox}" Width="Auto"
                                                 LostFocus="Margin_Changed" KeyDown="NumBox_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,4,0">
                                        <TextBlock Text="{loc:T Ed.Margins.Right}" Width="42" Style="{StaticResource RibbonLabel}"/>
                                        <TextBox x:Name="MarginR" Style="{StaticResource NumBox}" Width="Auto"
                                                 LostFocus="Margin_Changed" KeyDown="NumBox_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="{loc:T Ed.Margins.Bottom}" Width="42" Style="{StaticResource RibbonLabel}"/>
                                        <TextBox x:Name="MarginB" Style="{StaticResource NumBox}" Width="Auto"
                                                 LostFocus="Margin_Changed" KeyDown="NumBox_KeyDown"/>
                                    </DockPanel>
                                </UniformGrid>
                                <TextBlock Text="{loc:T Ed.Margins.Unit}" Style="{StaticResource RibbonLabel}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="SecSpacing" Header="{loc:T Ed.Paragraphs}" Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,2,0,6">
                                    <TextBlock Text="{loc:T Ed.Spacing.Before}" Width="110" Style="{StaticResource RibbonLabel}"/>
                                    <TextBox x:Name="SpaceBefore" Style="{StaticResource NumBox}" Width="Auto"
                                             LostFocus="ParaSpacing_Changed" KeyDown="NumBox_KeyDown"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{loc:T Ed.Spacing.After}" Width="110" Style="{StaticResource RibbonLabel}"/>
                                    <TextBox x:Name="SpaceAfter" Style="{StaticResource NumBox}" Width="Auto"
                                             LostFocus="ParaSpacing_Changed" KeyDown="NumBox_KeyDown"/>
                                </DockPanel>
                                <TextBlock Text="{loc:T Ed.Spacing.Unit}" Style="{StaticResource RibbonLabel}"/>
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock Text="{loc:T Ed.Spacing.Line}" Width="110" Style="{StaticResource RibbonLabel}"/>
                                    <ComboBox x:Name="SpacingCombo" SelectionChanged="Spacing_Changed">
                                        <ComboBoxItem Content="1,0" Tag="1.0" IsSelected="True"/>
                                        <ComboBoxItem Content="1,15" Tag="1.15"/>
                                        <ComboBoxItem Content="1,5" Tag="1.5"/>
                                        <ComboBoxItem Content="2,0" Tag="2.0"/>
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="SecWatermark" Header="{loc:T Ed.Layout.Background}" Visibility="Collapsed">
                            <StackPanel>
                                <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                                        Content="{loc:T Ed.Background.Choose}" Click="PickWatermark_Click"
                                        ToolTip="{loc:T Ed.Background.Tip}"
                                        AutomationProperties.Name="{loc:T Ed.Background.Pick}"/>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="{loc:T Ed.Opacity}" Width="80" Style="{StaticResource RibbonLabel}"/>
                                    <ComboBox x:Name="WatermarkOpacityCombo" SelectionChanged="WatermarkOpacity_Changed">
                                        <ComboBoxItem Content="100 %" Tag="1.0" IsSelected="True"/>
                                        <ComboBoxItem Content="60 %" Tag="0.6"/>
                                        <ComboBoxItem Content="30 %" Tag="0.3"/>
                                        <ComboBoxItem Content="15 %" Tag="0.15"/>
                                    </ComboBox>
                                </DockPanel>
                                <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                        Content="{loc:T Ed.Remove}" Click="RemoveWatermark_Click"/>
                            </StackPanel>
                        </Expander>

                        <!-- Tabelle: Design, Rahmen, Füllung, Größe (aus dem Tabelle-Tab
                             ausgelagert; über „Design & Rahmen…" geöffnet). Wirkt auf die
                             ausgewählten Zellen; Design auf die ganze Tabelle. -->
                        <Expander x:Name="SecTable" Header="{loc:T Ed.Tab.Table}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="{loc:T Ed.Table.Style}" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="TableStyleCombo" SelectionChanged="TableStyle_Changed"/>
                                <UniformGrid Columns="2" Margin="0,6,0,0">
                                    <CheckBox x:Name="BtnHeaderRow" Content="{loc:T Ed.Table.HeaderRow}" Margin="0,2"
                                              Click="TableBanding_Click" Foreground="{DynamicResource Brush.Text}"/>
                                    <CheckBox x:Name="BtnTotalRow" Content="{loc:T Ed.Table.TotalRow}" Margin="0,2"
                                              Click="TableBanding_Click" Foreground="{DynamicResource Brush.Text}"/>
                                    <CheckBox x:Name="BtnBandRows" Content="{loc:T Ed.Table.BandedRows}" Margin="0,2"
                                              Click="TableBanding_Click" Foreground="{DynamicResource Brush.Text}"/>
                                    <CheckBox x:Name="BtnBandCols" Content="{loc:T Ed.Table.BandedColumns}" Margin="0,2"
                                              Click="TableBanding_Click" Foreground="{DynamicResource Brush.Text}"/>
                                </UniformGrid>

                                <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,10"/>

                                <TextBlock Text="{loc:T Ed.Table.Borders}" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,6"/>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{loc:T Ed.Table.Border.Width}" Width="52" Style="{StaticResource RibbonLabel}"/>
                                    <ComboBox x:Name="TableBorderWidth">
                                        <ComboBoxItem Content="{loc:T Ed.Table.Border.Thin}" Tag="0.5"/>
                                        <ComboBoxItem Content="{loc:T Ed.Table.Border.Normal}" Tag="1" IsSelected="True"/>
                                        <ComboBoxItem Content="{loc:T Ed.Table.Border.Strong}" Tag="2"/>
                                        <ComboBoxItem Content="{loc:T Ed.Table.Border.Thick}" Tag="3.5"/>
                                    </ComboBox>
                                </DockPanel>
                                <UniformGrid Columns="2" Rows="2">
                                    <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Stretch"
                                            Content="{loc:T Ed.Table.Border.All}" Tag="all" Click="TableBorders_Click"/>
                                    <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Stretch"
                                            Content="{loc:T Ed.Table.Border.Outside}" Tag="outer" Click="TableBorders_Click"/>
                                    <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Stretch"
                                            Content="{loc:T Ed.Table.Border.Inside}" Tag="inner" Click="TableBorders_Click"/>
                                    <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Stretch"
                                            Content="{loc:T Ed.Table.Border.None}" Tag="none" Click="TableBorders_Click"/>
                                </UniformGrid>
                                <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Content="{loc:T Ed.Table.Border.Color}" Click="TableBorderColor_Click"/>

                                <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,10"/>

                                <TextBlock Text="{loc:T Ed.Table.Fill}" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource FlatButton}" Content="{loc:T Ed.Table.Fill.Color}" Click="TableCellColor_Click"/>
                                    <Button Style="{StaticResource FlatButton}" Content="{loc:T Action.Delete}" Click="TableCellColorClear_Click"/>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,10"/>

                                <TextBlock Text="{loc:T Ed.Table.Size}" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,6"/>
                                <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                                        Content="{loc:T Ed.Table.ColumnWidth}" Click="TableColumnWidth_Click"/>
                                <TextBlock Text="{loc:T Ed.Table.AutoFit}" Style="{StaticResource RibbonLabel}" Margin="0,6,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource FlatButton}" Content="{loc:T Ed.Table.AutoFit.Content}" Click="AutoFitContent_Click"
                                            ToolTip="{loc:T Ed.Table.AutoFit.Content.Tip}"/>
                                    <Button Style="{StaticResource FlatButton}" Content="{loc:T Ed.Table.AutoFit.Page}" Click="AutoFitWindow_Click"
                                            ToolTip="{loc:T Ed.Table.AutoFit.Page.Tip}"/>
                                    <Button Style="{StaticResource FlatButton}" Content="{loc:T Ed.Table.AutoFit.Fixed}" Click="AutoFitFixed_Click"
                                            ToolTip="{loc:T Ed.Table.AutoFit.Fixed.Tip}"/>
                                </StackPanel>
                                <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Content="{loc:T Ed.Table.CellPadding}" Click="TableCellPadding_Click"
                                        ToolTip="{loc:T Ed.Table.CellPadding.Tip}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================== Arbeitsbereich ===================== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Lineal -->
            <Border Grid.Row="0" Height="22" Background="{DynamicResource Brush.ToolbarBg}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                <ScrollViewer x:Name="RulerScroll" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled" Focusable="False" IsHitTestVisible="False">
                    <Grid x:Name="RulerHost">
                        <Canvas x:Name="RulerCanvas" Height="22" HorizontalAlignment="Center"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Canvas-Umgebung + Seite -->
            <ScrollViewer x:Name="MainScroll" Grid.Row="1" Background="{StaticResource CanvasBgBrush}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          ScrollChanged="MainScroll_ScrollChanged" PreviewMouseWheel="MainScroll_PreviewMouseWheel">
                <Grid x:Name="PageHost" HorizontalAlignment="Center" Margin="40,24">
                    <Grid x:Name="PageWrap">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="PageScale" ScaleX="1" ScaleY="1"/>
                        </Grid.LayoutTransform>

                        <!-- Schattenebene getrennt vom Inhalt (Effekt rastert sonst den Text) -->
                        <Border Background="{StaticResource PageBgBrush}" CornerRadius="2">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22"/>
                            </Border.Effect>
                        </Border>

                        <Border x:Name="Page" Background="{StaticResource PageBgBrush}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="2"
                                ClipToBounds="True">
                            <Grid>
                                <Image x:Name="WatermarkView" Stretch="UniformToFill" IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                                <TextBlock x:Name="HeaderPreview" VerticalAlignment="Top" HorizontalAlignment="Center"
                                           Foreground="{StaticResource PageMutedBrush}" FontSize="12"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                                <TextBlock x:Name="FooterPreview" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                           Foreground="{StaticResource PageMutedBrush}" FontSize="12"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>

                                <RichTextBox x:Name="Editor"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource InkBrush}"
                                             CaretBrush="#2563EB"
                                             SelectionBrush="{StaticResource PageSelectionBrush}"
                                             FontFamily="Segoe UI" FontSize="15"
                                             VerticalScrollBarVisibility="Disabled"
                                             AcceptsTab="True"
                                             IsDocumentEnabled="True"
                                             Language="de-DE"
                                             SpellCheck.IsEnabled="True"
                                             TextChanged="Editor_TextChanged"
                                             SelectionChanged="Editor_SelectionChanged"
                                             PreviewKeyDown="Editor_PreviewKeyDown"
                                             ContextMenuOpening="Editor_ContextMenuOpening"
                                             PreviewMouseDoubleClick="Editor_DoubleClick">
                                    <RichTextBox.ContextMenu>
                                        <ContextMenu x:Name="EditorMenu">
                                            <MenuItem Header="{loc:T Quick.Cut}" Command="ApplicationCommands.Cut"
                                                      InputGestureText="{loc:T Shortcut.Cut}"/>
                                            <MenuItem Header="{loc:T Quick.Copy}" Command="ApplicationCommands.Copy"
                                                      InputGestureText="{loc:T Shortcut.Copy}"/>
                                            <MenuItem Header="{loc:T Ed.Tab.Insert}" Command="ApplicationCommands.Paste"
                                                      InputGestureText="{loc:T Shortcut.Paste}"/>
                                            <Separator/>
                                            <MenuItem x:Name="MenuLink" Header="{loc:T Ed.Link.Edit}" Click="InsertLink_Click"/>
                                            <MenuItem x:Name="MenuUnlink" Header="{loc:T Ed.Link.Remove}" Click="RemoveLink_Click"/>
                                            <MenuItem Header="{loc:T Ed.Caption.Insert}" Click="InsertCaption_Click"/>
                                            <Separator x:Name="MenuObjSep" Visibility="Collapsed"/>
                                            <MenuItem x:Name="MenuSize" Header="{loc:T Ed.Table.Size}" Visibility="Collapsed">
                                                <MenuItem Header="{loc:T Ed.Object.Bigger}" Click="ObjBigger_Click"/>
                                                <MenuItem Header="{loc:T Ed.Object.Smaller}" Click="ObjSmaller_Click"/>
                                                <Separator/>
                                                <MenuItem Header="{loc:T Ed.Object.Wider}" Click="ObjWider_Click"/>
                                                <MenuItem Header="{loc:T Ed.Object.Narrower}" Click="ObjNarrower_Click"/>
                                                <MenuItem Header="{loc:T Ed.Object.Taller}" Click="ObjTaller_Click"/>
                                                <MenuItem Header="{loc:T Ed.Object.Shorter}" Click="ObjShorter_Click"/>
                                                <Separator/>
                                                <MenuItem Header="{loc:T Ed.Object.ExactSize}" Click="ObjExactSize_Click"/>
                                            </MenuItem>
                                            <MenuItem x:Name="MenuToBack" Header="{loc:T Ed.Object.Behind}"
                                                      Visibility="Collapsed" Click="ShapeToBack_Click"/>
                                            <MenuItem x:Name="MenuToFront" Header="{loc:T Ed.Object.Front}"
                                                      Visibility="Collapsed" Click="ShapeToFront_Click"/>
                                            <Separator x:Name="MenuTableSep"/>
                                            <MenuItem x:Name="MenuTable" Header="{loc:T Ed.Tab.Table}">
                                                <MenuItem Header="{loc:T Ed.Table.Row.Above}" Click="TableRowAbove_Click"/>
                                                <MenuItem Header="{loc:T Ed.Table.Row.Below}" Click="TableRowBelow_Click"/>
                                                <MenuItem Header="{loc:T Ed.Table.Column.Left}" Click="TableColLeft_Click"/>
                                                <MenuItem Header="{loc:T Ed.Table.Column.Right}" Click="TableColRight_Click"/>
                                                <Separator/>
                                                <MenuItem Header="{loc:T Ed.Table.Row.Delete}" Click="TableDeleteRow_Click"/>
                                                <MenuItem Header="{loc:T Ed.Table.Column.Delete}" Click="TableDeleteCol_Click"/>
                                                <Separator/>
                                                <MenuItem Header="{loc:T Ed.Table.MergeSelection}" Click="TableMergeCells_Click"/>
                                                <MenuItem Header="{loc:T Ed.Table.Unmerge}" Click="TableUnmergeCell_Click"/>
                                                <MenuItem Header="{loc:T Ed.Table.SplitCell}" Click="TableSplitCell_Click"/>
                                                <Separator/>
                                                <MenuItem Header="{loc:T Ed.Table.AllTools}" Click="OpenTableTab_Click"/>
                                                <MenuItem Header="{loc:T Ed.Table.Delete}" Click="TableDelete_Click"/>
                                            </MenuItem>
                                        </ContextMenu>
                                    </RichTextBox.ContextMenu>
                                </RichTextBox>

                                <!-- Seitenumbruch-Markierungen (Näherung, Layout-Tab) -->
                                <Canvas x:Name="PageBreakLayer" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- Sonderzeichen-Popup -->
            <Popup x:Name="SymbolPopup" PlacementTarget="{Binding ElementName=BtnSymbols}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="SymbolPopup_Closed">
                <Border Background="{DynamicResource Brush.CardBg}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="8" Padding="8" Margin="6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <WrapPanel x:Name="SymbolGrid" Width="308"/>
                </Border>
            </Popup>

            <!-- Formatvorlagen-Flyout (volle Bibliothek) -->
            <Popup x:Name="StylePopup" PlacementTarget="{Binding ElementName=BtnStyleMore}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource Brush.CardBg}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{loc:T Ed.Styles}" FontWeight="SemiBold" Margin="2,0,0,8"
                                   Foreground="{DynamicResource Brush.Text}"/>
                        <WrapPanel x:Name="StyleGridFull" Width="320"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Aufzählungszeichen-Bibliothek -->
            <Popup x:Name="BulletPopup" Placement="Bottom" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource Brush.CardBg}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{loc:T Ed.List.Bullets}" FontWeight="SemiBold" Margin="2,0,0,8"
                                   Foreground="{DynamicResource Brush.Text}"/>
                        <WrapPanel x:Name="BulletGrid" Width="228"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Nummerierungs-Bibliothek -->
            <Popup x:Name="NumberPopup" Placement="Bottom" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource Brush.CardBg}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{loc:T Ed.List.Numbering}" FontWeight="SemiBold" Margin="2,0,0,8"
                                   Foreground="{DynamicResource Brush.Text}"/>
                        <WrapPanel x:Name="NumberGrid" Width="228"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </DockPanel>
</UserControl>
