<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GonkNote.Views"
             xmlns:loc="clr-namespace:GonkNote.Services"
             xmlns:vm="clr-namespace:GonkNote.ViewModels;assembly=GonkNote.ViewModels"
             x:Class="GonkNote.Views.WhiteboardView"
             x:DataType="vm:WhiteboardTabViewModel"
             Focusable="True">

    <!-- Die Zeichenfläche des Linux-Kopfs. Aufbau wie beim WPF-Gegenstück
         (src/GonkNote.Wpf/Views/WhiteboardView.xaml), aber **bewusst kürzer**: für
         Meilenstein M1 zählen Seiten anzeigen, zeichnen, radieren, speichern. Sticker,
         OCR, Zahlenblock, Schnellaktionen und Geodreieck sind nicht M1 (HANDOFF §6).

         Die Farben kommen durchgehend aus der Farbtabelle in Core, über die von
         AvaloniaThemeHost gelegten „Brush.X"-Ressourcen — hier steht keine einzige. -->

    <DockPanel>

        <!-- ==================== Werkzeugleiste ==================== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.ToolbarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Margin="8,5" Spacing="1">

                    <Button x:Name="BtnUndo" Classes="flach symbol" Click="Undo_Click"
                            ToolTip.Tip="{loc:T Action.Undo}">
                        <views:Symbol Icon="Undo"
                              Stroke="{DynamicResource Brush.Text}"/>
                    </Button>
                    <Button x:Name="BtnRedo" Classes="flach symbol" Click="Redo_Click"
                            ToolTip.Tip="{loc:T Action.Redo}">
                        <views:Symbol Icon="Redo"
                              Stroke="{DynamicResource Brush.Text}"/>
                    </Button>

                    <Border Classes="trenner"/>

                    <!-- Stifte. Tag = der ToolType-Name; der Code-Behind liest ihn, statt je
                         Knopf ein eigenes Ereignis zu haben (wie im WPF-Kopf). -->
                    <ToggleButton x:Name="BtnPen" Classes="werkzeug" Tag="Pen"
                                  IsCheckedChanged="Tool_Changed" ToolTip.Tip="{loc:T Tool.Pen}">
                        <views:Symbol Icon="Pen"
                              Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnPencil" Classes="werkzeug" Tag="Pencil"
                                  IsCheckedChanged="Tool_Changed" ToolTip.Tip="{loc:T Tool.Pencil}">
                        <views:Symbol Icon="Pencil"
                              Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnHighlighter" Classes="werkzeug" Tag="Highlighter"
                                  IsCheckedChanged="Tool_Changed" ToolTip.Tip="{loc:T Tool.Highlighter}">
                        <views:Symbol Icon="Highlighter"
                              Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnEraser" Classes="werkzeug" Tag="Eraser"
                                  IsCheckedChanged="Tool_Changed" ToolTip.Tip="{loc:T Tool.Eraser}">
                        <views:Symbol Icon="Eraser"
                              Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>

                    <Border Classes="trenner"/>

                    <!-- Textfeld und Notizzettel (Phase 4.5). Beide gehören zu den
                         Werkzeugen mit „genau einer ist gedrückt" und stehen deshalb in
                         ToolButtons — anders als die fünf Formen, die sich eines teilen. -->
                    <ToggleButton x:Name="BtnText" Classes="werkzeug" Tag="Text"
                                  IsCheckedChanged="Tool_Changed" ToolTip.Tip="{loc:T Tool.Text}">
                        <views:Symbol Icon="TextTool" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnZettel" Classes="werkzeug" Tag="Sticky"
                                  IsCheckedChanged="Tool_Changed" ToolTip.Tip="{loc:T Tool.Sticky}">
                        <views:Symbol Icon="StickyNote" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>

                    <Border Classes="trenner"/>

                    <!-- Die fünf Formen (Phase 4.5). Tag = der ShapeKind-Name; sie teilen
                         sich ein eigenes Ereignis, weil alle fünf dasselbe Werkzeug
                         einschalten und sich nur in der Art unterscheiden. -->
                    <ToggleButton x:Name="BtnFormRechteck" Classes="werkzeug" Tag="Rectangle"
                                  IsCheckedChanged="Form_Gewaehlt" ToolTip.Tip="{loc:T Tool.Shape.Rect}">
                        <views:Symbol Icon="ShapeRect" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnFormLinie" Classes="werkzeug" Tag="Line"
                                  IsCheckedChanged="Form_Gewaehlt" ToolTip.Tip="{loc:T Tool.Shape.Line}">
                        <views:Symbol Icon="ShapeLine" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnFormPfeil" Classes="werkzeug" Tag="Arrow"
                                  IsCheckedChanged="Form_Gewaehlt" ToolTip.Tip="{loc:T Tool.Shape.Arrow}">
                        <views:Symbol Icon="ShapeArrow" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnFormEllipse" Classes="werkzeug" Tag="Ellipse"
                                  IsCheckedChanged="Form_Gewaehlt" ToolTip.Tip="{loc:T Tool.Shape.Ellipse}">
                        <views:Symbol Icon="ShapeEllipse" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnFormDreieck" Classes="werkzeug" Tag="Triangle"
                                  IsCheckedChanged="Form_Gewaehlt" ToolTip.Tip="{loc:T Tool.Shape.Triangle}">
                        <views:Symbol Icon="ShapeTriangle" Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>

                    <Border Classes="trenner"/>

                    <ToggleButton x:Name="BtnLasso" Classes="werkzeug" Tag="Lasso"
                                  IsCheckedChanged="Tool_Changed" ToolTip.Tip="{loc:T Tool.Lasso}">
                        <views:Symbol Icon="Lasso"
                              Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnMove" Classes="werkzeug" Tag="Move"
                                  IsCheckedChanged="Tool_Changed" ToolTip.Tip="{loc:T Tool.Move.Tip}">
                        <views:Symbol Icon="Move"
                              Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnPan" Classes="werkzeug" Tag="Pan"
                                  IsCheckedChanged="Tool_Changed" ToolTip.Tip="{loc:T Tool.Hand.Tip}">
                        <views:Symbol Icon="Hand"
                              Stroke="{DynamicResource Brush.Text}"/>
                    </ToggleButton>

                    <Border Classes="trenner"/>

                    <!-- Farben. Die erste Kachel ist „auto": schwarz auf hellen, weiß auf
                         dunklen Seiten — sie wird im Zeichenpfad nachgeführt. -->
                    <RadioButton x:Name="AutoSwatch" Classes="farbe" GroupName="Tinte" Tag="auto"
                                 IsChecked="True" IsCheckedChanged="Color_Changed"/>
                    <RadioButton Classes="farbe" GroupName="Tinte" Tag="#FFE11D48" Background="#E11D48"
                                 IsCheckedChanged="Color_Changed"/>
                    <RadioButton Classes="farbe" GroupName="Tinte" Tag="#FF2563EB" Background="#2563EB"
                                 IsCheckedChanged="Color_Changed"/>
                    <RadioButton Classes="farbe" GroupName="Tinte" Tag="#FF16A34A" Background="#16A34A"
                                 IsCheckedChanged="Color_Changed"/>
                    <RadioButton Classes="farbe" GroupName="Tinte" Tag="#FFF59E0B" Background="#F59E0B"
                                 IsCheckedChanged="Color_Changed"/>
                    <RadioButton Classes="farbe" GroupName="Tinte" Tag="#FF7C3AED" Background="#7C3AED"
                                 IsCheckedChanged="Color_Changed"/>

                    <Border Classes="trenner"/>

                    <!-- Größe. Bedient je nach Werkzeug die Strichstärke oder den
                         Radierradius — beide Werte werden getrennt gemerkt, damit ein
                         Werkzeugwechsel den jeweils anderen nicht überschreibt. -->
                    <TextBlock x:Name="WidthLabel" VerticalAlignment="Center" Width="26"
                               TextAlignment="Right" FontSize="12"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                    <Slider x:Name="WidthSlider" Width="110" Minimum="0.5" Maximum="40" Value="2.5"
                            VerticalAlignment="Center" Margin="6,0"
                            PropertyChanged="WidthSlider_Changed"/>

                    <Border Classes="trenner"/>

                    <Button Classes="flach symbol" Click="ZoomOut_Click" ToolTip.Tip="{loc:T Zoom.Out}">
                        <views:Symbol Icon="ZoomOut"
                              Stroke="{DynamicResource Brush.Text}"/>
                    </Button>
                    <Button x:Name="ZoomLabel" Classes="flach" Click="ZoomReset_Click"
                            ToolTip.Tip="{loc:T Zoom.Reset}" MinWidth="52" Content="100 %"
                            FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <Button Classes="flach symbol" Click="ZoomIn_Click" ToolTip.Tip="{loc:T Zoom.In}">
                        <views:Symbol Icon="ZoomIn"
                              Stroke="{DynamicResource Brush.Text}"/>
                    </Button>

                    <Border Classes="trenner"/>

                    <Button x:Name="BtnEinstellungen" Classes="flach symbol"
                            Click="Einstellungen_Click" ToolTip.Tip="{loc:T Wb.Settings.PageTip}">
                        <views:Symbol Icon="Settings"
                              Stroke="{DynamicResource Brush.Text}"/>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ==================== Seitenleiste unten ==================== -->
        <Border x:Name="PageBar" DockPanel.Dock="Bottom"
                Background="{DynamicResource Brush.ToolbarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="8,4" Spacing="2">
                <Button Classes="flach symbol" Click="PrevPage_Click">
                    <views:Symbol Icon="ChevronLeft"
                          Stroke="{DynamicResource Brush.Text}"/>
                </Button>
                <TextBlock x:Name="PageLabel" VerticalAlignment="Center" MinWidth="110"
                           TextAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource Brush.TextMuted}"/>
                <Button Classes="flach symbol" Click="NextPage_Click">
                    <views:Symbol Icon="ChevronRight"
                          Stroke="{DynamicResource Brush.Text}"/>
                </Button>
                <Border Classes="trenner"/>
                <Button Classes="flach symbol" Click="AddPage_Click" ToolTip.Tip="{loc:T Page.Add}">
                    <views:Symbol Icon="Plus"
                          Stroke="{DynamicResource Brush.Text}"/>
                </Button>
                <Button Classes="flach symbol" Click="DeletePage_Click" ToolTip.Tip="{loc:T Page.Delete}">
                    <views:Symbol Icon="Trash"
                          Stroke="{DynamicResource Brush.Text}"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ==================== Einstellungen (rechte Seitenleiste) ==================== -->
        <!-- **Nur die Seite.** Der WPF-Kopf hat hier zusätzlich Formen, Text, Notizzettel,
             Sticker und Cover — Werkzeuge, die es im Linux-Kopf nicht gibt (nicht M1,
             HANDOFF §6). Eine Sektion für ein fehlendes Werkzeug wäre ein halbes Feature,
             und ein halbes Feature ist schlechter als ein fehlendes: niemand sieht ihm an,
             dass es halb ist.

             Änderungen wirken sofort auf die aktuelle Seite, ohne OK-Knopf — genau wie
             drüben (WhiteboardView.Settings.cs, PageSetting_Changed). -->
        <Border x:Name="EinstellungenLeiste" DockPanel.Dock="Right" Width="262" IsVisible="False"
                Background="{DynamicResource Brush.ToolbarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="14,8"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="flach symbol"
                                ToolTip.Tip="{loc:T Wb.Settings.Close}" Click="Einstellungen_Click">
                            <views:Symbol Icon="Close"
                                  Stroke="{DynamicResource Brush.Text}"/>
                        </Button>
                        <TextBlock Text="{loc:T Settings.Page}" FontWeight="SemiBold" FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text}"/>
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12">

                        <!-- Muster -->
                        <TextBlock Text="{loc:T Settings.Page.Pattern}" FontWeight="SemiBold"
                                   Margin="0,0,0,4" Foreground="{DynamicResource Brush.Text}"/>
                        <UniformGrid Columns="2" Margin="0,0,0,14">
                            <RadioButton x:Name="SetzeMusterBlanko" GroupName="setzeMuster" Margin="0,2"
                                         Content="{loc:T Settings.Page.Blank}"
                                         IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                            <RadioButton x:Name="SetzeMusterLinien" GroupName="setzeMuster" Margin="0,2"
                                         Content="{loc:T Settings.Page.Lines}"
                                         IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                            <RadioButton x:Name="SetzeMusterKaro" GroupName="setzeMuster" Margin="0,2"
                                         Content="{loc:T Settings.Page.Grid}"
                                         IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                            <RadioButton x:Name="SetzeMusterPunkte" GroupName="setzeMuster" Margin="0,2"
                                         Content="{loc:T Settings.Page.Dots}"
                                         IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                        </UniformGrid>

                        <!-- Farbton -->
                        <TextBlock Text="{loc:T Settings.Page.Shade}" FontWeight="SemiBold"
                                   Margin="0,0,0,4" Foreground="{DynamicResource Brush.Text}"/>
                        <StackPanel Margin="0,0,0,14">
                            <RadioButton x:Name="SetzeTonAuto" GroupName="setzeTon" Margin="0,2"
                                         Content="{loc:T Settings.Page.Shade.Auto}"
                                         IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                            <RadioButton x:Name="SetzeTonHell" GroupName="setzeTon" Margin="0,2"
                                         Content="{loc:T Settings.Page.Shade.Light}"
                                         IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                            <RadioButton x:Name="SetzeTonDunkel" GroupName="setzeTon" Margin="0,2"
                                         Content="{loc:T Settings.Page.Shade.Dark}"
                                         IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                        </StackPanel>

                        <!-- Format und Ausrichtung. Die unendliche Fläche hat kein Blatt,
                             dessen Maße man setzen könnte — dort verschwindet der Abschnitt. -->
                        <StackPanel x:Name="FormatAbschnitt">
                            <TextBlock Text="{loc:T Settings.Page.Format}" FontWeight="SemiBold"
                                       Margin="0,0,0,4" Foreground="{DynamicResource Brush.Text}"/>
                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <RadioButton x:Name="SetzeFormatA4" GroupName="setzeFormat" Margin="0,2"
                                             Content="A4" IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                                <RadioButton x:Name="SetzeFormatA3" GroupName="setzeFormat" Margin="0,2"
                                             Content="A3" IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                            </UniformGrid>

                            <TextBlock Text="{loc:T Settings.Page.Orientation}" FontWeight="SemiBold"
                                       Margin="0,0,0,4" Foreground="{DynamicResource Brush.Text}"/>
                            <StackPanel Margin="0,0,0,14">
                                <RadioButton x:Name="SetzeHochformat" GroupName="setzeLage" Margin="0,2"
                                             Content="{loc:T Settings.Page.Portrait}"
                                             IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                                <RadioButton x:Name="SetzeQuerformat" GroupName="setzeLage" Margin="0,2"
                                             Content="{loc:T Settings.Page.Landscape}"
                                             IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                            </StackPanel>

                            <CheckBox x:Name="SetzeAlsStandard" Margin="0,0,0,12"
                                      Content="{loc:T Settings.Page.AsDefault}"
                                      IsCheckedChanged="Seiteneinstellung_Geaendert"/>
                        </StackPanel>

                        <!-- Auf dem Cover ändert nichts davon etwas: es hat weder Muster
                             noch Farbton, sein Aussehen kommt aus WhiteboardDoc.Cover. -->
                        <TextBlock x:Name="CoverHinweis" IsVisible="False" TextWrapping="Wrap"
                                   FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="{loc:T Settings.Page.CoverHint}"/>

                        <!-- ==================== Formen ==================== -->
                        <!-- Neu in Phase 4.5. Die Sektion erscheint nur, solange das
                             Formen-Werkzeug aktiv ist — dieselbe Regel wie drüben, wo sie in
                             einem Expander sitzt: eine Füllfarbe ohne Form daneben ist eine
                             Einstellung ohne Gegenstand. -->
                        <StackPanel x:Name="FormenBereich" IsVisible="False" Margin="0,18,0,0">
                            <TextBlock Text="{loc:T Settings.Shapes}" FontWeight="SemiBold" FontSize="14"
                                       Margin="0,0,0,6" Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="{loc:T Settings.Shapes.Hint}" TextWrapping="Wrap" FontSize="11"
                                       Margin="0,0,0,8" Foreground="{DynamicResource Brush.TextMuted}"/>

                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
                                <!-- Der Schalter trägt die Vorschau: er zeigt, was er
                                     einschaltet. Das Schachbrett dahinter macht die
                                     Deckkraft sichtbar. -->
                                <ToggleButton x:Name="FuellungAn" Classes="werkzeug"
                                              ToolTip.Tip="{loc:T Settings.Shapes.FillToggle}"
                                              IsCheckedChanged="Fuellung_Umgeschaltet">
                                    <Border Width="16" Height="16" CornerRadius="3" ClipToBounds="True"
                                            Background="{StaticResource Schachbrett}">
                                        <Border x:Name="FuellungVorschau"/>
                                    </Border>
                                </ToggleButton>
                                <Button Classes="flach symbol" Click="Fuellfarbe_Click"
                                        ToolTip.Tip="{loc:T Settings.Shapes.FillColor}">
                                    <views:Symbol Icon="Palette" Stroke="{DynamicResource Brush.Text}"/>
                                </Button>
                                <TextBlock Text="{loc:T Settings.Shapes.Fill}" VerticalAlignment="Center"
                                           Margin="6,0,0,0" Foreground="{DynamicResource Brush.Text}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{loc:T Settings.Shapes.Opacity}" VerticalAlignment="Center"
                                           Margin="0,0,6,0" FontSize="11"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                                <Slider x:Name="FuellungDeckkraft" Width="110" Minimum="0" Maximum="100" Value="40"
                                        VerticalAlignment="Center"
                                        PropertyChanged="Deckkraft_Geaendert"/>
                                <TextBlock x:Name="DeckkraftAnzeige" Text="40 %" Width="38" VerticalAlignment="Center"
                                           Margin="4,0,0,0" FontSize="11"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ==================== Textfeld ==================== -->
                        <StackPanel x:Name="TextBereich" IsVisible="False" Margin="0,18,0,0">
                            <TextBlock Text="{loc:T Settings.Text}" FontWeight="SemiBold" FontSize="14"
                                       Margin="0,0,0,6" Foreground="{DynamicResource Brush.Text}"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <!-- Der Schalter trägt die Vorschau, wie bei der Formfüllung. -->
                                <ToggleButton x:Name="TextGrundAn" Classes="werkzeug"
                                              ToolTip.Tip="{loc:T Settings.Text.BgTip}"
                                              IsCheckedChanged="TextGrund_Umgeschaltet">
                                    <Border Width="16" Height="16" CornerRadius="3" ClipToBounds="True"
                                            Background="{StaticResource Schachbrett}">
                                        <Border x:Name="TextGrundVorschau"/>
                                    </Border>
                                </ToggleButton>
                                <Button Classes="flach symbol" Click="TextGrundfarbe_Click"
                                        ToolTip.Tip="{loc:T Settings.Text.BgTip}">
                                    <views:Symbol Icon="Palette" Stroke="{DynamicResource Brush.Text}"/>
                                </Button>
                                <TextBlock Text="{loc:T Settings.Text.Bg}" VerticalAlignment="Center"
                                           Margin="6,0,0,0" Foreground="{DynamicResource Brush.Text}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ==================== Notizzettel ==================== -->
                        <StackPanel x:Name="ZettelBereich" IsVisible="False" Margin="0,18,0,0">
                            <TextBlock Text="{loc:T Settings.Sticky}" FontWeight="SemiBold" FontSize="14"
                                       Margin="0,0,0,6" Foreground="{DynamicResource Brush.Text}"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border x:Name="ZettelVorschau" Width="26" Height="26" CornerRadius="4"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"/>
                                <Button Classes="flach symbol" Click="Zettelfarbe_Click"
                                        ToolTip.Tip="{loc:T Settings.Sticky.CustomColor}">
                                    <views:Symbol Icon="Palette" Stroke="{DynamicResource Brush.Text}"/>
                                </Button>
                                <TextBlock Text="{loc:T Settings.Sticky.Color}" VerticalAlignment="Center"
                                           Margin="6,0,0,0" Foreground="{DynamicResource Brush.Text}"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ==================== Die Fläche ==================== -->
        <!-- ClipToBounds, damit ein Strich am Rand nicht über die Werkzeugleiste läuft. -->
        <Panel ClipToBounds="True">
            <views:SkiaCanvas x:Name="Skia"/>

            <!-- Die Überlagerung fürs Tippen (Phase 4.5). Textfelder und Notizzettel werden
                 nicht auf der Skia-Fläche bearbeitet, sondern in einem echten Eingabefeld
                 darüber — nur so gibt es Marke, Auswahl, Zwischenablage und die
                 Eingabemethode für Umlaute und tote Tasten geschenkt. Dasselbe Verfahren wie
                 im WPF-Kopf (WhiteboardView.xaml, „Overlay").

                 **Der Canvas hat bewusst KEINEN Hintergrund** (`{x:Null}`, nicht
                 `Transparent`): er liegt über der ganzen Fläche, und mit Hintergrund finge er
                 jeden Zeigerdruck ab — es ließe sich kein Strich mehr zeichnen. Ohne
                 Hintergrund ist nur anfassbar, was darin steht, also das Eingabefeld.
                 `IsHitTestVisible="False"` wäre der falsche Weg: das schlägt auf die Kinder
                 durch, und dann ließe sich der Text nicht mehr mit der Maus markieren. -->
            <Canvas x:Name="Ueberlagerung" Background="{x:Null}">
                <!-- KeyDown wird im Code-Behind mit `Tunnel` angehängt und NICHT hier: als
                     gewöhnliches (Bubble-)Ereignis kommt der Handler erst, nachdem der
                     TextBox die Taste schon verarbeitet hat — Strg+Eingabe stand dann als
                     Zeichen im Text, bevor die Bearbeitung abschloss. Am laufenden Programm
                     gesehen. -->
                <TextBox x:Name="EditFeld" IsVisible="False" AcceptsReturn="True"
                         MinWidth="60" BorderThickness="1"
                         LostFocus="EditFeld_Verlassen"/>
            </Canvas>
        </Panel>

    </DockPanel>
</UserControl>
