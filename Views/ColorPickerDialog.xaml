<Window x:Class="GonkNote.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Farbe wählen" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.WindowBg}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource Brush.Text}"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Sättigung/Helligkeit-Fläche -->
            <Border x:Name="SvArea" Grid.Column="0" Height="240" CornerRadius="8"
                    MouseDown="SvArea_MouseDown" MouseMove="SvArea_MouseMove" MouseUp="Area_MouseUp"
                    ClipToBounds="True">
                <Border.Background>
                    <SolidColorBrush x:Name="HueBrush" Color="Red"/>
                </Border.Background>
                <Grid>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Canvas>
                        <Ellipse x:Name="SvThumb" Width="14" Height="14" Stroke="White" StrokeThickness="2"
                                 Fill="Transparent" IsHitTestVisible="False">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                </Grid>
            </Border>

            <!-- Farbton-Regler -->
            <Border x:Name="HueArea" Grid.Column="1" Width="22" Height="240" Margin="12,0,0,0"
                    CornerRadius="6" MouseDown="HueArea_MouseDown" MouseMove="HueArea_MouseMove"
                    MouseUp="Area_MouseUp" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF0000" Offset="0"/>
                        <GradientStop Color="#FFFF00" Offset="0.167"/>
                        <GradientStop Color="#00FF00" Offset="0.333"/>
                        <GradientStop Color="#00FFFF" Offset="0.5"/>
                        <GradientStop Color="#0000FF" Offset="0.667"/>
                        <GradientStop Color="#FF00FF" Offset="0.833"/>
                        <GradientStop Color="#FF0000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Canvas>
                    <Border x:Name="HueThumb" Width="22" Height="6" Background="Transparent"
                            BorderBrush="White" BorderThickness="2" CornerRadius="3"
                            IsHitTestVisible="False"/>
                </Canvas>
            </Border>
        </Grid>

        <!-- Deckkraft -->
        <DockPanel x:Name="AlphaRow" Margin="0,14,0,0">
            <TextBlock Text="Deckkraft" DockPanel.Dock="Left" VerticalAlignment="Center" Width="70"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
            <TextBlock x:Name="AlphaLabel" DockPanel.Dock="Right" VerticalAlignment="Center" Width="44"
                       TextAlignment="Right" Text="100 %"/>
            <Border Height="18" CornerRadius="6" Background="{StaticResource CheckerBrush}"
                    x:Name="AlphaArea" MouseDown="AlphaArea_MouseDown" MouseMove="AlphaArea_MouseMove"
                    MouseUp="Area_MouseUp" ClipToBounds="True" Margin="0,0,8,0">
                <Grid>
                    <Border CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush x:Name="AlphaGradient" StartPoint="0,0" EndPoint="1,0">
                                <GradientStop x:Name="AlphaStop0" Color="#00FF0000" Offset="0"/>
                                <GradientStop x:Name="AlphaStop1" Color="#FFFF0000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Canvas>
                        <Border x:Name="AlphaThumb" Width="6" Height="18" Background="Transparent"
                                BorderBrush="White" BorderThickness="2" CornerRadius="3"
                                IsHitTestVisible="False"/>
                    </Canvas>
                </Grid>
            </Border>
        </DockPanel>

        <!-- Hex + Vorschau -->
        <DockPanel Margin="0,14,0,0">
            <Border DockPanel.Dock="Right" Width="64" Height="30" CornerRadius="6"
                    Background="{StaticResource CheckerBrush}" ClipToBounds="True">
                <Border x:Name="Preview" CornerRadius="6"/>
            </Border>
            <TextBlock Text="Hex" VerticalAlignment="Center" Width="70"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
            <TextBox x:Name="HexBox" VerticalAlignment="Center" Margin="0,0,10,0"
                     KeyDown="HexBox_KeyDown" LostKeyboardFocus="HexBox_LostFocus"/>
        </DockPanel>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Abbrechen" Style="{StaticResource FlatButton}" MinWidth="90"
                    IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Übernehmen" Style="{StaticResource AccentButton}" MinWidth="110"
                    Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
