<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AssemblyName>GonkNote</AssemblyName>
    <RootNamespace>GonkNote</RootNamespace>
    <Version>0.1.0</Version>
    <Company>GonkNote</Company>
    <Product>Gonk Note</Product>
    <ApplicationIcon>Assets\GonkNote.ico</ApplicationIcon>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Single-File-Publish: dotnet publish -c Release -r win-x64 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.9" />
    <PackageReference Include="Svg.Skia" Version="1.0.0.18" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <!-- Plattformneutrale Kernlogik (Models + DB + reine Services); von WPF und Avalonia
       gemeinsam genutzt (HANDOFF.md §9.2). -->
  <ItemGroup>
    <ProjectReference Include="GonkNote.Core\GonkNote.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\gonk-note-Icon.png" />
    <Resource Include="README.md" />
    <!-- Geodreieck: je Theme eine Vektorgrafik, wie die Sticker als lose Begleitdatei
         neben die Exe. Eigene Zeichnungen des Nutzers liegen in %APPDATA%\GonkNote und
         haben Vorrang (WbAidRenderer.UserAssetFolder). -->
    <Content Include="Assets\Geodreieck-Light.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Geodreieck-Dark.svg" CopyToOutputDirectory="PreserveNewest" />
    <!-- Sticker: es werden bewusst KEINE mitgeliefert (dafür gäbe es keine Lizenz). Die Regel
         bleibt trotzdem stehen: wer eigene Motive fest ins Programm legen will, kopiert sie
         nach Assets\Stickers. Der Normalfall sind Nutzer-Sticker in %APPDATA%\GonkNote\Stickers. -->
    <Content Include="Assets\Stickers\*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Cover-Vorlagen (Nutzer-Motive, JPEG 1600 px lange Kante bzw. Pixel-Art-PNGs):
         wie die Sticker neben die Exe; eigene Vorlagen liegen in %APPDATA%\GonkNote\Covers -->
    <Content Include="Assets\Covers\**\*.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Covers\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- OCR-Sprachdaten (Tesseract, tessdata_fast deu+eng): wie die Sticker als
         lose Begleitdatei neben die Exe. Die nativen Tesseract-DLLs kommen über
         das NuGet-Paket in den x64-/x86-Unterordner. -->
    <Content Include="tessdata\*.traineddata" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Die Kernbibliothek (GonkNote.Core\) ist ein eigenes Projekt und darf nicht in den
       WPF-Build hineingezogen werden — der **/*.cs-Glob vom Repo-Root aus würde sonst
       zugreifen. Die Core-Typen kommen über die ProjectReference oben. -->
  <ItemGroup>
    <Compile Remove="GonkNote.Core\**\*.cs" />
    <None Remove="GonkNote.Core\**" />
    <Page Remove="GonkNote.Core\**" />
    <Resource Remove="GonkNote.Core\**" />
  </ItemGroup>

</Project>
