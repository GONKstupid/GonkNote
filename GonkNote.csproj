<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AssemblyName>GonkNote</AssemblyName>
    <RootNamespace>GonkNote</RootNamespace>
    <Version>0.1.0</Version>
    <Company>GonkNote</Company>
    <Product>Gonk Note</Product>
    <ApplicationIcon>Assets\GonkNote.ico</ApplicationIcon>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Single-File-Publish: dotnet publish -c Release -r win-x64 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="2.88.9" />
    <PackageReference Include="Svg.Skia" Version="1.0.0.18" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\gonk-note-Icon.png" />
    <Resource Include="README.md" />
    <!-- Geodreieck-Overlays (Nutzer-SVGs, je Theme); EmbeddedResource statt
         Resource, damit auch Nicht-WPF-Harnesses sie laden können -->
    <EmbeddedResource Include="Assets\Geodreieck-Light.svg" />
    <EmbeddedResource Include="Assets\Geodreieck-Dark.svg" />
    <!-- Basis-Sticker: neben die Exe kopieren; Nutzer-Sticker liegen in %APPDATA% -->
    <Content Include="Assets\Stickers\*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Cover-Vorlagen (Nutzer-Motive, JPEG 1600 px lange Kante): wie die Sticker
         neben die Exe; eigene Vorlagen liegen in %APPDATA%\GonkNote\Covers -->
    <Content Include="Assets\Covers\**\*.jpg" CopyToOutputDirectory="PreserveNewest" />
    <!-- OCR-Sprachdaten (Tesseract, tessdata_fast deu+eng): wie die Sticker als
         lose Begleitdatei neben die Exe. Die nativen Tesseract-DLLs kommen über
         das NuGet-Paket in den x64-/x86-Unterordner. -->
    <Content Include="tessdata\*.traineddata" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
