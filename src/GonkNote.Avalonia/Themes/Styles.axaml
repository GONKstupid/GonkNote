<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GonkNote.ViewModels;assembly=GonkNote.ViewModels">

    <!-- Aussehen des Linux-Kopfs. **Die Farben stehen hier nicht** — die kommen aus der
         Farbtabelle in Core und werden von AvaloniaThemeHost als „Brush.X"/„Color.X" in
         die Anwendungsressourcen gelegt. Was hier steht, ist Form: Abstände, Ecken,
         Symbole, das Verhalten unter dem Zeiger.

         Deutlich kürzer als das Gegenstück im WPF-Kopf (Themes/Styles.xaml, 609 Zeilen),
         weil Avalonias Fluent-Theme schon Knöpfe, Menüs, Rollbalken und Baumknoten
         mitbringt; überschrieben wird nur, was anders aussehen soll. -->

    <Styles.Resources>

        <!-- ==== Symbole ==================================================== =====
             Vektorformen im 16×16-Raster, dieselbe Machart wie die Icon.*-Geometrien im
             WPF-Kopf.

             **Warum keine Icon-Schrift:** der WPF-Kopf zeichnet die meisten Symbole mit
             Zeichen aus „Segoe Fluent Icons". Die Schrift gehört zu Windows, lässt sich
             nicht mitliefern und existiert unter Linux nicht — jedes Symbol wäre dort ein
             leeres Kästchen. Vektorformen sind der Weg, den derselbe WPF-Kopf schon geht,
             wo die Schrift nichts Passendes hat.

             Sie werden **gestrichen** gezeichnet (Stroke), nicht gefüllt — Ausnahme
             Icon.Stern. Wer eine hinzufügt, hält sich an 16×16 und an Linien statt
             Flächen, sonst passt sie neben den anderen nicht.

             **Vorlage ist das Zeichen, das der WPF-Kopf an derselben Stelle benutzt** — es
             steht im Repo und ist damit nachprüfbar, anders als ein Vorschaubild.
             Icon.Folder und Icon.Textmarker sind am 2026-08-03 genau deshalb neu gezeichnet
             worden (HANDOFF §4.12, Nachtrag). -->

        <!-- Ordner: **der klassische mit Reiter**, nachgezeichnet nach dem Zeichen, das der
             WPF-Kopf dafür benutzt (Segoe Fluent `E8B7`) — Nutzerwunsch 2026-08-03. Der
             erste Anlauf war die „moderne" Fassung ohne Reiter (linke Hälfte höher, eine
             Schräge zur Grundfläche); sie passte nicht zu dem, was V1 zeigt.

             Zwei Teilpfade: die Umrisslinie mit dem Reiter oben links, und darunter die
             waagerechte Linie, die den Reiter erst als Reiter lesbar macht. -->
        <!-- 1:1 aus src/GonkNote.Wpf/Themes/Styles.xaml — dort hatte die Icon-Schrift für
             das Whiteboard schon nichts Passendes. -->

        <!-- Gefüllt: ein gestrichener Stern ist bei 10 px nicht mehr als Stern zu erkennen. -->


        <!-- Werkzeuge der Zeichenfläche (Phase 3, zweiter Brocken).
             Dieselbe Machart: 16×16, gestrichen, keine Flächen. Die Werkzeugleiste des
             WPF-Kopfs holt diese Symbole aus „Segoe Fluent Icons"; hier ist jedes eine
             eigene Form (HANDOFF §7 „Die Icon-Schrift gibt es unter Linux nicht"). -->

        <!-- Textmarker: **aufrecht und von vorn**, nachgezeichnet nach dem Zeichen des
             WPF-Kopfs (Segoe Fluent `E7E6`) — Nutzerwunsch 2026-08-03. Der erste Anlauf war
             ein schräg liegender Marker; V1 zeigt ihn stehend, und daneben sah der Bleistift
             gleich zweimal aus.

             **Oben offen.** Das ist der Punkt, an dem die ersten beiden Anläufe daneben
             lagen: der Schaft ist am oberen Rand abgeschnitten, es gibt keine Kappe, die ihn
             schließt — zwei Stege stehen über der Bandlinie, mehr nicht. Darunter der
             Korpus, unten die Keilspitze.

             **Die Breite ist das Erkennungsmerkmal**, nicht die Neigung: ein schmaler Umriss
             liest sich neben Stift und Bleistift wie ein dritter Stift. -->

        <!-- Zahnrad — die Einstellungen-Seitenleiste (Phase 3, sechster Brocken). -->



        <!-- Fensterknöpfe der einblendbaren Titelleiste (Phase 3, sechster Brocken).
             Icon.Schliessen steht schon oben. -->


        <!-- Ribbon des Textdokuments (§4.28). Export = Blatt mit Pfeil heraus, Seitenbreite
             und Ganze Seite = ein Blatt mit Pfeilen in die Richtung, die eingepasst wird. -->

        <!-- ==== Schachbrett (Phase 4.5) =====================================
             Hinter allem, was durchscheinen kann — Füllvorschau, Farbwähler. Das
             Gegenstück heißt CheckerBrush und steht in Themes/Styles.xaml des WPF-Kopfs.

             **Die Maße stehen ohne Einheit, und das ist gemessen und nicht geraten.**
             Avalonia liest jeden Wert als `double`; ein Suffix wie `px` wirft zur Laufzeit
             eine FormatException, die der Bau nicht sieht (XAML-Attribute werden erst beim
             Laden geparst). Ohne Suffix gilt `RelativeUnit.Absolute` — also Pixel, und
             genau das ist hier gewollt. Ein `%` an den Werten wäre der relative Fall. -->
        <DrawingBrush x:Key="Schachbrett" TileMode="Tile"
                      SourceRect="0,0,12,12" DestinationRect="0,0,12,12">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFFFF" Geometry="M0,0 H12 V12 H0 Z"/>
                    <GeometryDrawing Brush="#FFD4D4D8" Geometry="M0,0 H6 V6 H0 Z M6,6 H12 V12 H6 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

    </Styles.Resources>

    <!-- ==== Knöpfe ==================================================================== -->

    <!-- Flach: kein Rahmen, kein Hintergrund — bis der Zeiger darüber steht. -->
    <Style Selector="Button.flach">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.flach:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
    </Style>
    <Style Selector="Button.flach:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Pressed}"/>
    </Style>

    <!-- Symbolknopf: quadratisch, nur die Form darin. -->
    <Style Selector="Button.symbol">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Eine Taste des Zahlenblocks an der Werkzeuggröße (Phase 4.5, Stück 5).
         Bewusst hoch und mit Abstand: das Ding wird mit dem Finger oder der Stiftspitze
         bedient, nicht mit dem Mauszeiger. Dieselben Maße wie im WPF-Kopf. -->
    <Style Selector="Button.zifferntaste">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.zifferntaste:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
    </Style>
    <Style Selector="Button.zifferntaste:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Pressed}"/>
    </Style>

    <!-- Der Akzentknopf („Neu" in der Galerie). -->
    <Style Selector="Button.akzent">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.akzent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Opacity" Value="0.88"/>
    </Style>

    <!-- Galerie-Kachel: die Fläche darf nur andeuten, dass sie anklickbar ist. -->
    <Style Selector="Button.kachel">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Width" Value="168"/>
        <Setter Property="Margin" Value="8,8,8,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.kachel:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
    </Style>

    <!-- Angepinnter Ordner: die Icon-Kachel im Schnellzugriff (angelehnt an Zen-Browser). -->
    <Style Selector="Button.pinkachel">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Background" Value="{DynamicResource Brush.CardBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.pinkachel:pointerover /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.CardBg}"/>
    </Style>

    <!-- Pfadleiste über dem Galerietitel: wie Text, nicht wie ein Knopf. -->
    <Style Selector="Button.pfad">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="3,0"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.pfad:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
    </Style>

    <!-- ==== Symbolformen ============================================================= -->

    <!-- Gestrichene Symbole. Die Farbe setzt jede Fundstelle selbst (Ordnerfarbe,
         zurückgenommener Text, Weiß auf dem Akzentknopf) — hier steht nur die Machart. -->

    <!-- ==== Baum ===================================================================== -->

    <Style Selector="TreeView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <!-- Aufklappzustand und Auswahl gehören dem ViewModel, nicht dem Knoten: MainViewModel
         klappt beim Springen zu einem Eintrag dessen Vorfahren auf (RevealItem). Ohne die
         beiden Zeilen bliebe der Baum stehen und nur die Galerie wechselte.
         Dieselben zwei Setter stehen im WPF-Kopf (Themes/Styles.xaml, TreeViewItem). -->
    <Style Selector="TreeViewItem" x:DataType="vm:TreeItemViewModel">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
    </Style>

    <!-- **Die Auswahl gehört dem Theme und nicht dem Rahmenwerk** (Nutzer-Entscheidung
         2026-08-29, HANDOFF §4.71). Ohne diese zwei Setter malt Fluent die ausgewählte
         Zeile in `SystemAccentColor` — **violett**, während der Rest der App blau ist. Das
         war keine Gestaltung, sondern eine durchschlagende Vorgabe; im WPF-Kopf steht an
         derselben Stelle seit jeher `Brush.Selection` (Themes/Styles.xaml, TreeViewItem).

         `Brush.Selection` kommt aus der Farbtabelle in Core (`ThemeColor.Selection`) und
         wird von `AvaloniaThemeHost` je Theme neu gebaut. **Damit folgt die Auswahl
         automatisch auch einem später geladenen eigenen Farbschema** — genau das war die
         Vorgabe, und sie ist der Grund, warum hier kein fester Farbwert steht.

         **Beide Setter sind Absicht**, aus demselben Grund wie beim Zielordner darunter. -->
    <Style Selector="TreeViewItem:selected">
        <Setter Property="Background" Value="{DynamicResource Brush.Selection}"/>
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource Brush.Selection}"/>
    </Style>
    <!-- Auch beim Überfahren und beim Zeigerdruck: sonst blitzt in genau diesen zwei
         Zuständen das Violett wieder durch, und zwar nur dann — der unauffälligste Ort,
         an dem eine Rahmenwerk-Vorgabe überleben kann. -->
    <Style Selector="TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource Brush.Selection}"/>
    </Style>
    <Style Selector="TreeViewItem:selected:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource Brush.Selection}"/>
    </Style>

    <!-- Zielordner beim Ziehen. **Beide Setter sind Absicht.** Fluents TreeViewItem malt
         seine Fläche auf einer Border namens `PART_LayoutRoot` im Template; trifft dieser
         Name eines Tages nicht mehr, greift wenigstens der Setter am Knoten selbst. Ein
         Selektor, dessen Template-Teil es nicht gibt, ist in Avalonia kein Fehler — er
         wirkt nur nicht, und genau das wäre hier sonst still. -->
    <Style Selector="TreeViewItem.zielordner">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
    </Style>
    <Style Selector="TreeViewItem.zielordner /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
    </Style>

    <!-- **Die Auswahl in einer Klappliste gehoert ebenfalls dem Theme** (§5 Nr. 27).
         Beim Baum ist das mit §4.72 geschehen; hier stand das Violett noch — gefunden beim
         Aufklappen der Schriftliste. *Eine Rahmenwerk-Vorgabe sitzt nicht an einer Stelle,
         sondern an jeder, die man nicht angefasst hat.*

         `PART_ContentPresenter` ist der Name im Fluent-Template, an 12.1.1 nachgemessen.
         Der Setter am Element selbst steht daneben, aus demselben Grund wie beim
         Zielordner weiter oben: ein Selektor, dessen Template-Teil es nicht mehr gibt,
         wirkt in Avalonia still gar nicht. -->
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Selection}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Selection}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Selection}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    </Style>

    <!-- Dasselbe fuer Listen: `ListBoxItem` teilt sich das Template-Teil mit der
         Klapplisten-Zeile, und was hier nicht steht, faellt spaeter woanders auf. -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Selection}"/>
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Selection}"/>
    </Style>
    <Style Selector="ListBoxItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    </Style>

    <!-- ==== Schieber (Strichstaerke) ================================================== -->

    <!-- **Auch der Schieber gehoert dem Theme** (§5 Nr. 27, HANDOFF §4.74). Fluent malt
         Griff und gefuellten Teil in `SystemAccentColor` — in der Werkzeugleiste stand
         damit ein **violetter** Knopf neben blauen Kacheln, waehrend der WPF-Kopf an
         derselben Stelle einen kleinen blauen Punkt auf duennem Band zeigt
         (Themes/Styles.xaml, Slider).

         Die Masse sind die des WPF-Templates: Band 4 px, Griff 14 px. -->
    <!-- **Der Griff des Schiebers bekommt eine eigene Vorlage** (§5 Nr. 27, HANDOFF §4.74).
         Fluent malt ihn in `SystemAccentColor` — in der Werkzeugleiste stand damit ein
         violetter Knopf neben blauen Kacheln, waehrend der WPF-Kopf dort einen kleinen
         blauen Punkt auf duennem Band zeigt.

         ⚠ **Drei Anlaeufe, und nur der dritte traegt — damit es niemand wiederholt:**
         (1) Ein Setter auf `Background` des Thumbs erreicht Fluents eigene Thumb-Vorlage
             nicht; der Knopf blieb violett.
         (2) Die **ganze** Slider-Vorlage in einem `Style` zu ersetzen wirkt gar nicht:
             Fluents `ControlTheme` setzt `Template` und gewinnt — der Schieber sah danach
             aus wie ohne jede Aenderung.
         (3) Eine Vorlage nur fuer den **Thumb** traegt. Alles am laufenden Programm
             gesehen, nicht hergeleitet.

         ⚠ **Was danach uebrig bleibt und offen ist:** links vom Griff steht ein schmaler
         violetter Stummel, den Fluent aus einem Element malt, dessen Namen die Assembly
         nicht preisgibt (weder als `PART_` noch als Ressourcenschluessel). Der Rest des
         Bandes ist grau wie drueben. -->
    <Style Selector="Slider /template/ Thumb">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Ellipse Width="14" Height="14" Fill="{DynamicResource Brush.Accent}"/>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- Der bereits zurueckgelegte Teil des Bandes; dahinter der Rest in der Randfarbe. -->
    <Style Selector="Slider /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <Style Selector="Slider /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
    </Style>

    <!-- Ein flacher Knopf bleibt flach, auch wenn er nicht kann. Fluent legt im Zustand
         `:disabled` eine graue Flaeche unter — in der Werkzeugleiste sahen Rueckgaengig und
         Wiederholen dadurch aus wie zwei gedrueckte Kaesten, waehrend drueben nur die
         Pfeile blasser werden (§4.74). -->
    <Style Selector="Button.flach:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.flach:disabled">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Opacity" Value="0.4"/>
    </Style>

    <!-- ==== Registerkarten ============================================================ -->

    <Style Selector="TabControl">
        <Setter Property="Background" Value="{DynamicResource Brush.WindowBg}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>
    <!-- Der Strich unter dem gewählten Reiter — **aus dem Theme, nicht aus Fluent**
         (dieselbe Entscheidung wie bei der Baum-Auswahl oben). Fluent malt ihn sonst in
         `SystemAccentColor`, also violett.

         `PART_SelectedPipe` ist der Name im Fluent-Template und **an der gebundenen Fassung
         12.1.1 nachgemessen**, nicht geraten (dieselbe Methode wie §4.42). Trifft der Name
         eines Tages nicht mehr, wirkt der Selektor still gar nicht — deshalb steht er hier
         mit dieser Zeile und nicht ohne.

         ⚠ **Die Gestalt bleibt vorerst verschieden:** der WPF-Kopf zeichnet den gewählten
         Reiter als gefüllte Fläche mit runden oberen Ecken und **ohne** Strich. Das ist ein
         offener Punkt von Schritt ①b und keine Farbfrage (HANDOFF §4.71). -->
    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
    </Style>

    <!-- ==== Werkzeugleiste der Zeichenfläche ========================================== -->

    <!-- Werkzeugknopf: quadratisch und flach wie „Button.symbol", aber schaltend. Der
         eingerastete Zustand ist die Akzentfläche — im WPF-Kopf macht das derselbe
         ToggleButton-Stil in Themes/Styles.xaml. -->
    <Style Selector="ToggleButton.werkzeug">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ToggleButton.werkzeug:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
    </Style>
    <Style Selector="ToggleButton.werkzeug:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
    </Style>
    <Style Selector="ToggleButton.werkzeug:checked Path">
        <Setter Property="Stroke" Value="{DynamicResource Brush.Accent}"/>
    </Style>

    <!-- ==== Auswahlpunkte der Einstellungsleiste ====================================== -->

    <!-- **Der Auswahlpunkt gehört dem Theme** (§5 Nr. 27, Phase 5 Schritt ①c). Fluent malt
         Ring und Punkt eines gewählten `RadioButton` in `SystemAccentColor` — in der
         Einstellungsleiste der Tafel standen damit **violette** Punkte („Punktiert", „Hell")
         in einer sonst blauen App, während der WPF-Kopf an derselben Stelle einen neutralen
         Punkt zeigt. **Beide Köpfe nebeneinander am laufenden Programm gesehen**, nicht
         hergeleitet — im Bau war nichts davon zu sehen.

         Das ist dieselbe Sorte Fund wie Baum (§4.72), Klappliste (§4.73), Schieber (§4.74)
         und Reiter oben in dieser Datei: **jede Fläche, die noch nicht angefasst ist, hat
         ihr eigenes Violett.** Die Regel dahinter ist inzwischen fünfmal bestätigt und
         gehört deshalb hierher und nicht in eine Notiz.

         `CheckOuterEllipse` und `CheckGlyph` sind die Namen im Fluent-Template und **an der
         gebundenen Fassung 12.1.1 nachgemessen** (`Avalonia.Themes.Fluent.dll`), nicht
         geraten — dieselbe Methode wie bei `PART_SelectedPipe` oben und wie in §4.42.
         Trifft ein Name eines Tages nicht mehr, wirkt der Selektor **still gar nicht**;
         deshalb steht diese Zeile hier und nicht bloß der Selektor.

         ⚠ **Was das NICHT angleicht:** Der WPF-Kopf lässt seine `RadioButton` unangetastet
         und bekommt damit die Systemdarstellung. Die beiden Köpfe zeigen danach denselben
         *Bezug* (die Farbe kommt aus der Tabelle in Core), aber nicht dieselbe *Gestalt*.
         Das ist ein offener Punkt von ①b und benannt statt halb erledigt. -->
    <Style Selector="RadioButton:checked /template/ Ellipse#CheckOuterEllipse">
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="Stroke" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <Style Selector="RadioButton:checked /template/ Ellipse#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource Brush.Accent}"/>
    </Style>

    <!-- Farbkachel: ein Kreis in der Tintenfarbe. Ausgewählt = Ring drumherum. -->
    <Style Selector="RadioButton.farbe">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Ring" Width="26" Height="26" CornerRadius="13"
                        BorderThickness="2" BorderBrush="Transparent">
                    <Ellipse Width="16" Height="16"
                             Fill="{TemplateBinding Background}"
                             Stroke="{DynamicResource Brush.Border}" StrokeThickness="1"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.farbe:checked /template/ Border#Ring">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <Style Selector="RadioButton.farbe:pointerover /template/ Border#Ring">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
    </Style>

    <!-- ==== Ribbon des Textdokuments (§4.28) ========================================== -->

    <!-- Ribbon-Reiter: aktiv über einen 2-px-Unterstrich in der Akzentfarbe. **Derselbe
         Entwurf wie im WPF-Kopf** (RibbonTab in TextEditorView.xaml, Design-Konzept 7.2) —
         nur als Avalonia-Stil geschrieben, wo WPF Trigger braucht. Wer die Köpfe
         nebeneinanderstellt, soll dieselbe Leiste sehen. -->
    <Style Selector="RadioButton.ribbonreiter">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      Margin="12,5,12,7"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Rectangle Name="Unterstrich" Height="2" VerticalAlignment="Bottom"
                               Margin="10,0" IsVisible="False"
                               Fill="{DynamicResource Brush.Accent}"/>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.ribbonreiter:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    </Style>
    <Style Selector="RadioButton.ribbonreiter:checked">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="RadioButton.ribbonreiter:checked /template/ Rectangle#Unterstrich">
        <Setter Property="IsVisible" Value="True"/>
    </Style>

    <!-- Knopf mit Symbol **und** Beschriftung — im Ribbon ist Platz dafür, und ein Wort
         erspart das Raten, das ein reines Symbol verlangt. -->
    <Style Selector="Button.ribbonknopf">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    </Style>
    <Style Selector="Button.ribbonknopf:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
    </Style>
    <Style Selector="Button.ribbonknopf:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <!-- Formatschalter im Ribbon (F, K, U, S, Ausrichtung) — Schritt 6 des Schreibens.

         **Kleiner als `ToggleButton.werkzeug`** (30 statt 34) und mit eigenem Aussehen für den
         gedrückten Zustand: Der Werkzeugschalter der Zeichenfläche färbt im Template ein
         `Path` ein, hier steht aber meist ein Buchstabe. Beides über einen Stil zu ziehen hieße,
         den einen Fall stumm zu lassen — und stumm heißt hier: der Knopf sieht nicht gedrückt
         aus, obwohl der Text fett ist.

         **Dritter Zustand: unbestimmt.** Über einer Auswahl aus fettem und magerem Text ist der
         Knopf weder gedrückt noch nicht gedrückt (`TdFormatEdit.Gemeinsam` antwortet dort mit
         `null`). Avalonias `IsThreeState` trägt das schon; sichtbar gemacht wird es hier. -->
    <Style Selector="ToggleButton.ribbonschalter">
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleButton.ribbonschalter:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
    </Style>
    <Style Selector="ToggleButton.ribbonschalter:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
    </Style>
    <Style Selector="ToggleButton.ribbonschalter:checked">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <Style Selector="ToggleButton.ribbonschalter:indeterminate /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
    </Style>
    <Style Selector="ToggleButton.ribbonschalter:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <!-- Beschriftung eines Ablesefeldes im Ribbon (Format, Ränder, Kopfzeile …). -->
    <Style Selector="TextBlock.feldname">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
    </Style>
    <Style Selector="TextBlock.feldwert">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    </Style>

    <!-- Trennstrich zwischen den Gruppen der Werkzeugleiste. -->
    <Style Selector="Border.trenner">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Margin" Value="6,7"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
    </Style>

    <!-- ==== Einblendbare Titelleiste ================================================== -->

    <!-- Fensterknopf: schmaler und höher als ein Werkzeugknopf, weil er die ganze Leiste
         ausfüllt — dieselbe Machart wie „CaptionButton" im WPF-Kopf. -->
    <Style Selector="Button.fensterknopf">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.fensterknopf:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
    </Style>
    <!-- Schließen färbt rot, wie überall sonst auch. -->
    <Style Selector="Button.fensterknopf.schliessen:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#C42B1C"/>
    </Style>
    <Style Selector="Button.fensterknopf.schliessen:pointerover Path">
        <Setter Property="Stroke" Value="White"/>
    </Style>

    <!-- ==== Menüleiste ================================================================ -->

    <Style Selector="Menu">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Menu > MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Padding" Value="10,5"/>
    </Style>

</Styles>
