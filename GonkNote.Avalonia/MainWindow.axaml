<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GonkNote.Avalonia.MainWindow"
        Width="960" Height="660"
        Title="Gonk Note — Avalonia-Port (Linux-ready)">
    <DockPanel>

        <!-- Kopfleiste -->
        <Border DockPanel.Dock="Top" Background="#22808080" Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Name="ThemeToggle" Content="🌓 Theme" Padding="10,5"/>
                    <Button Name="OpenEditor" Content="Editor-Prototyp →" Padding="10,5"/>
                    <Button Name="OpenProbe" Content="Render-Probe" Padding="10,5"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Gonk Note — Avalonia-Port" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Opacity="0.7" FontSize="12"
                               Text="Shell (Schritt 3a): Ordnerbaum aus der echten LiteDB, Farbvererbung, Navigation, Theme."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Linkes Panel: Ordnerbaum -->
        <Border DockPanel.Dock="Left" Width="300" BorderBrush="#33808080" BorderThickness="0,0,1,0" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Dokumente" FontWeight="SemiBold"
                           Margin="4,2,0,8" Opacity="0.8"/>
                <TreeView Name="Tree" ItemsSource="{Binding Roots}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                                         Fill="{Binding IconBrush}"/>
                                <TextBlock Text="{Binding Glyph}" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- Inhaltsbereich (Platzhalter bis Schritt 4/5); linksbündig wegen des
             Fill-Panel-Breiten-Quirks (§9.3b/§9.5) -->
        <Panel>
            <!-- Leerzustand -->
            <StackPanel IsVisible="{Binding HasNoSelection}" Margin="28,26" Spacing="6"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="📂" FontSize="40" Opacity="0.5"/>
                <TextBlock Text="Wähle links ein Dokument." Opacity="0.6"/>
            </StackPanel>
            <!-- Auswahl -->
            <StackPanel IsVisible="{Binding HasSelection}" Margin="28,26" Spacing="6"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="{Binding SelectedKindText}" Opacity="0.6" FontSize="12"/>
                <TextBlock Text="{Binding SelectedTitle}" FontSize="26" FontWeight="SemiBold"/>
                <Border Margin="0,14,0,0" Padding="14" CornerRadius="8" Background="#1A808080"
                        HorizontalAlignment="Left">
                    <TextBlock Opacity="0.75" MaxWidth="440" TextWrapping="Wrap"
                               Text="Die echte Dokumentansicht (Whiteboard / Notizbuch / Text) folgt in Schritt 4/5 des Ports. Dieser Bereich beweist die Navigation: Auswahl im Baum ⇒ Kontext hier."/>
                </Border>
            </StackPanel>
        </Panel>

    </DockPanel>
</Window>
