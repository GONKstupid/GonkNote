<Project Sdk="Microsoft.NET.Sdk">

  <!-- Kernbibliothek ohne UI-Bezug: Models, LiteDB-Zugriff, Undo, Bild-Cache, PDF-Import
       und die SkiaSharp-Zeichenroutinen des Whiteboards. Bewusst `net8.0` (kein `-windows`,
       kein WPF), damit die Kernlogik von der Oberfläche entkoppelt bleibt — siehe die
       Cleanup-Leitlinie in HANDOFF §5. Die WPF-App referenziert dieses Projekt. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>GonkNote.Core</RootNamespace>
    <AssemblyName>GonkNote.Core</AssemblyName>
  </PropertyGroup>

  <!-- Symbole einbetten, damit im Single-File-Publish keine lose .pdb neben der Exe liegt
       (die WPF-App macht dasselbe). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <!-- PDF-Rendering (PDFium); hat Linux-Builds → bleibt cross-platform -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <!-- SVG-Rendering für das Geodreieck-Overlay -->
    <PackageReference Include="Svg.Skia" Version="1.0.0.18" />
  </ItemGroup>

  <!-- Hier lagen bis 2026-07-27 die eingebetteten Geodreieck-SVGs. Sie sind entfallen:
       die Vorlage war eine Bearbeitung einer Grafik unbekannter Herkunft und damit für ein
       quelloffenes Projekt nicht haltbar. Gonk Note zeichnet die Kontur jetzt selbst
       (WbAidRenderer.DrawSetSquare); wer eine eigene Zeichnung hat, legt sie als
       %APPDATA%\GonkNote\Geodreieck-Light.svg bzw. -Dark.svg ab. -->

</Project>
