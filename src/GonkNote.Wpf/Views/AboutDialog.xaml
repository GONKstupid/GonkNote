<Window x:Class="GonkNote.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GonkNote.Services"
        Title="{loc:T About.Title}" Width="620" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.WindowBg}"
        FontFamily="{DynamicResource Font.Ui}" FontSize="13"
        Foreground="{DynamicResource Brush.Text}"
        ShowInTaskbar="False">
    <DockPanel Margin="18">

        <!-- Kopf -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Image Source="/Assets/gonk-note-Icon.png" Width="40" Height="40"
                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Gonk Note" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Foreground="{DynamicResource Brush.TextMuted}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource Brush.TextMuted}"
                   TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="{loc:T About.Subtitle}"/>

        <!-- Der Datenordner. `About.Subtitle` nennt seit HANDOFF §4.12 keinen festen Pfad
             mehr — er unterscheidet sich zwischen den Plattformen, und der Linux-Kopf zeigt
             ihn schon so. Ohne diese Zeile fehlte die Angabe unter Windows ganz. -->
        <TextBlock DockPanel.Dock="Top" x:Name="DataFolderText"
                   Foreground="{DynamicResource Brush.TextMuted}"
                   TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"/>

        <!-- Fußzeile -->
        <Button DockPanel.Dock="Bottom" Content="{loc:T Window.Close}" Style="{StaticResource AccentButton}"
                MinWidth="110" HorizontalAlignment="Right" Margin="0,12,0,0"
                IsCancel="True" IsDefault="True"/>

        <!-- README -->
        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource Brush.CardBg}">
            <FlowDocumentScrollViewer x:Name="ReadmeView" Padding="14,10"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsSelectionEnabled="True" Background="Transparent"
                                      Foreground="{DynamicResource Brush.Text}"/>
        </Border>

    </DockPanel>
</Window>
