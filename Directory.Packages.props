<Project>

  <!-- Zentrale Paketversionen (Central Package Management). Ab mehreren Projekten Pflicht,
       sonst driften die Versionen auseinander: die .csproj nennen nur noch den Paketnamen,
       die Version steht ausschließlich hier.

       SkiaSharp 3.x (Roadmap §4): API-Bruchversion — die Textausgabe wandert von SKPaint
       nach SKFont, SKPaint.FilterQuality wird zu SKSamplingOptions. Dafuer ist der
       iOS-Build sauber, was fuer Phase 5 die Voraussetzung ist.
       Svg.Skia 5.1.1 ist die erste Fassung, die auf SkiaSharp >= 3.119.2 aufsetzt. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Erlaubt, auch **mitgezogene** Pakete hier festzuschreiben. Gebraucht für
         SQLitePCLRaw (unten): ohne das ließe sich eine Sicherheitslücke tief in der
         Abhängigkeitskette nur beheben, indem man auf die nächste Fassung des Pakets
         darüber wartet. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.Views.WPF" Version="3.119.4" />
    <PackageVersion Include="Svg.Skia" Version="5.1.1" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.1.0" />
    <!-- PDF-Rasterung (PDFium). Hat Linux-Builds, fehlt auf iOS → Phase 2: IPdfRasterizer -->
    <PackageVersion Include="Docnet.Core" Version="2.6.0" />
    <!-- OCR. Windows/Linux; auf iOS ersetzt durch Vision → Phase 2: IOcrEngine -->
    <PackageVersion Include="Tesseract" Version="5.2.0" />
    <!-- Persistenz seit Phase 2, Schritt 3. Das Paket bringt die native SQLite-Bibliothek
         für Windows, Linux, macOS **und** iOS mit (SQLitePCLRaw.bundle_e_sqlite3) — anders
         als LiteDB kommt es ohne Reflection.Emit aus und ist damit NativeAOT-tauglich. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Die native SQLite-Bibliothek, die Microsoft.Data.Sqlite mitzieht. Hier
         **festgeschrieben**, weil die Fassung 2.1.11 aus dem Paket darüber eine bekannte
         Sicherheitslücke hat (NU1903, GHSA-2m69-gcr7-jv3q). Ein mitgezogenes Paket lässt
         sich nur so anheben — deshalb steht oben CentralPackageTransitivePinningEnabled.
         Beim nächsten Anheben von Microsoft.Data.Sqlite prüfen, ob diese Zeile noch nötig
         ist: ein Pin, den niemand mehr braucht, hält irgendwann eine Fassung fest. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <!-- **Nicht mehr im Produktivpfad.** LiteDB stürzt unter iOS/NativeAOT ab
         (Reflection.Emit) und ist seit Phase 2, Schritt 3 aus GonkNote.Core verschwunden.
         Es lebt nur noch in GonkNote.Legacy weiter — dem Leser, der eine Altdatenbank
         **einmalig** nach SQLite überträgt — und im Core-Testprojekt, das damit echte
         Altdateien als Fixture erzeugt. Kein Kopf für iOS wird dieses Paket je sehen. -->
    <PackageVersion Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

  <!-- Der Linux-Kopf (Phase 3). **12.1.1 ist nicht irgendeine Fassung**, sondern genau die,
       mit der der Stylus-Prototyp auf dem Laptop gemessen hat (HANDOFF §5a): voller
       Druckbereich 0…1, XTilt/YTilt in Grad, `Pointer.Type` unterscheidet Pen/Touch/Mouse.
       Damit ist auch die offene Frage aus §4.3 beantwortet — Avalonia 12 trägt net10.0.
       Wer hier eine andere Fassung einträgt, macht die Messung ungültig und sollte den
       Prototyp erneut laufen lassen, bevor die Zeichenfläche darauf aufsetzt.

       Der Prototyp unter tools/ bleibt bewusst aus der zentralen Verwaltung ausgeklinkt
       (er ist Wegwerf-Werkzeug); dass beide dieselbe Fassung nennen, ist Absicht und
       kein Automatismus. -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <!-- Eine mitgelieferte Schrift. Unter Windows ist immer eine da, unter Linux nicht:
         ohne fontconfig und mindestens eine installierte Schrift bliebe die Oberfläche
         leer. Das Paket macht den Kopf an dieser Stelle unabhängig vom System — was der
         **Renderer** zeichnet, hängt weiterhin an SKTypeface (HANDOFF §4.6). -->
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- Avalonias Skia-Rücken. Er kommt ohnehin über Avalonia.Desktop mit; hier steht er
         **ausdrücklich**, weil die Zeichenfläche `ISkiaSharpApiLeaseFeature` daraus
         benutzt — und was man beim Übersetzen braucht, holt man sich nicht über eine
         Abhängigkeit einer Abhängigkeit. Entscheidend ist dabei: dieses Paket hängt an
         **SkiaSharp 3.119.4**, derselben Fassung wie GonkNote.Core. Nur deshalb ist der
         SKCanvas, den Avalonia herausgibt, für den WbRenderer derselbe Typ (HANDOFF §4.10). -->
    <PackageVersion Include="Avalonia.Skia" Version="12.1.1" />
  </ItemGroup>

  <!-- Testprojekte (Phase 1). xunit 2.9.x, weil der WPF-Kopf über einen eigenen
       STA-Thread getestet wird und dort keine Runner-Eigenheiten dazukommen sollen.
       coverlet ist bewusst nicht dabei: Abdeckungszahlen sind hier kein Ziel, die
       Golden-Files sind es. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Nur fürs Testen unter Linux (CI-Job ubuntu-latest): das Paket `SkiaSharp` bringt die
         native Bibliothek für Windows und macOS mit, für Linux **nicht**. Zum Bauen genügt
         das (Meilenstein M0), zum Ausführen nicht — ohne dieses Paket wirft der erste
         Skia-Aufruf DllNotFoundException.
         Steht hier und nicht in GonkNote.Core: eine Linux-.so gehört nicht in ein Paket, das
         der Windows-Kopf mitschleppt. Für Phase 3 wird das derselbe Punkt beim
         Avalonia-Kopf sein. -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
  </ItemGroup>

</Project>
