<Window x:Class="GonkNote.Views.TableSortDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GonkNote.Services"
        Title="{loc:T Sort.Title}" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Brush.WindowBg}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource Brush.Text}"
        ShowInTaskbar="False">
    <StackPanel Margin="18">
        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="{loc:T Sort.By}" Width="110" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
            <ComboBox x:Name="ColumnCombo"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="{loc:T Chart.Type}" Width="110" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
            <ComboBox x:Name="TypeCombo">
                <ComboBoxItem Content="{loc:T Sort.Type.Text}" IsSelected="True"/>
                <ComboBoxItem Content="{loc:T Sort.Type.Number}"/>
                <ComboBoxItem Content="{loc:T Sort.Type.Date}"/>
            </ComboBox>
        </DockPanel>
        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="{loc:T Sort.Order}" Width="110" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextMuted}"/>
            <ComboBox x:Name="DirCombo">
                <ComboBoxItem Content="{loc:T Sort.Ascending}" IsSelected="True"/>
                <ComboBoxItem Content="{loc:T Sort.Descending}"/>
            </ComboBox>
        </DockPanel>
        <CheckBox x:Name="HeaderCheck" Content="{loc:T Sort.HeaderRow}"
                  IsChecked="True" Foreground="{DynamicResource Brush.Text}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:T Dlg.Cancel}" Style="{StaticResource FlatButton}" MinWidth="90"
                    IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="{loc:T Sort.Do}" Style="{StaticResource AccentButton}" MinWidth="100"
                    Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
