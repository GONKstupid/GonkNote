<UserControl x:Class="GonkNote.Views.WhiteboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GonkNote.Views"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             xmlns:loc="clr-namespace:GonkNote.Services"
             Focusable="True">
    <UserControl.Resources>
        <!-- Numpad-Taste (Strichstärke per Zahlenblock, Vorbild Adobe Fresco) -->
        <Style x:Key="NumpadKey" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel>

        <!-- ===== Werkzeugleiste ===== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.ToolbarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                Padding="8,4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">

                    <!-- Hand (H): Leinwand verschieben -->
                    <ToggleButton x:Name="BtnPan" Style="{StaticResource ToolButton}"
                                  AutomationProperties.Name="{loc:T Tool.Hand}"
                                  ToolTip="{loc:T Tool.Hand.Tip}"
                                  Checked="Tool_Checked" Tag="Pan">
                        <views:Symbol Icon="Hand" Size="16"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <!-- Stifte (klappbare Gruppe) -->
                    <ToggleButton x:Name="BtnPen" Style="{StaticResource ToolButton}" Content="{views:Icon Pen}"
                                  ToolTip="{loc:T Tool.Pen}" Checked="Tool_Checked" Tag="Pen"/>
                    <ToggleButton x:Name="BtnSmoothPen" Style="{StaticResource ToolButton}"
                                  ToolTip="{loc:T Tool.SmoothPen}" Checked="Tool_Checked" Tag="SmoothPen">
                        <views:Symbol Icon="ShapePen" Size="16"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnPencil" Style="{StaticResource ToolButton}" Content="{views:Icon Pencil}"
                                  ToolTip="{loc:T Tool.Pencil}" Checked="Tool_Checked" Tag="Pencil"/>
                    <ToggleButton x:Name="BtnHighlighter" Style="{StaticResource ToolButton}" Content="{views:Icon Highlighter}"
                                  ToolTip="{loc:T Tool.Highlighter}" Checked="Tool_Checked" Tag="Highlighter"/>

                    <!-- Radierer -->
                    <ToggleButton x:Name="BtnEraser" Style="{StaticResource ToolButton}" Content="{views:Icon Eraser}"
                                  ToolTip="{loc:T Tool.Eraser}" Checked="Tool_Checked" Tag="Eraser"/>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <!-- Auswahl (Lasso + Verschieben, klappbare Gruppe wie die Stifte) -->
                    <ToggleButton x:Name="BtnLasso" Style="{StaticResource ToolButton}"
                                  ToolTip="{loc:T Tool.Lasso}"
                                  Checked="Tool_Checked" Tag="Lasso">
                        <views:Symbol Icon="Lasso" Size="16"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnMove" Style="{StaticResource ToolButton}"
                                  AutomationProperties.Name="{loc:T Tool.Move}"
                                  ToolTip="{loc:T Tool.Move.Tip}"
                                  Checked="Tool_Checked" Tag="Move">
                        <views:Symbol Icon="Move" Size="16"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <ToggleButton x:Name="BtnText" Style="{StaticResource ToolButton}" Content="{views:Icon TextTool}"
                                  ToolTip="{loc:T Tool.Text}" Checked="Tool_Checked" Tag="Text"/>

                    <!-- Formen (F): klappbare Gruppe wie die Stifte; Standard Rechteck sichtbar,
                         Rest erscheint, sobald das Formen-Werkzeug aktiv ist. Weitere Optionen
                         (Füllung/Deckkraft) in der Einstellungs-Seitenleiste. -->
                    <!-- Seit Phase 4.5 aus dem Symbolsatz (§4.31) statt als Unicode-Zeichen
                         in „Segoe UI": diese Schrift gibt es unter Linux nicht, und der
                         Linux-Kopf bekommt dieselben Knöpfe. -->
                    <ToggleButton x:Name="BtnShapeRect" Style="{StaticResource ToolButton}"
                                  Content="{views:Icon ShapeRect}"
                                  ToolTip="{loc:T Tool.Shape.Rect}" Checked="ShapeTool_Checked" Tag="Rectangle"/>
                    <ToggleButton x:Name="BtnShapeLine" Style="{StaticResource ToolButton}"
                                  Content="{views:Icon ShapeLine}"
                                  ToolTip="{loc:T Tool.Shape.Line}" Checked="ShapeTool_Checked" Tag="Line"/>
                    <ToggleButton x:Name="BtnShapeArrow" Style="{StaticResource ToolButton}"
                                  Content="{views:Icon ShapeArrow}"
                                  ToolTip="{loc:T Tool.Shape.Arrow}" Checked="ShapeTool_Checked" Tag="Arrow"/>
                    <ToggleButton x:Name="BtnShapeEllipse" Style="{StaticResource ToolButton}"
                                  Content="{views:Icon ShapeEllipse}"
                                  ToolTip="{loc:T Tool.Shape.Ellipse}" Checked="ShapeTool_Checked" Tag="Ellipse"/>
                    <ToggleButton x:Name="BtnShapeTriangle" Style="{StaticResource ToolButton}"
                                  Content="{views:Icon ShapeTriangle}"
                                  ToolTip="{loc:T Tool.Shape.Triangle}" Checked="ShapeTool_Checked" Tag="Triangle"/>

                    <ToggleButton x:Name="BtnChart" Style="{StaticResource ToolButton}" Content="{views:Icon Chart}"
                                  AutomationProperties.Name="{loc:T Tool.Chart}"
                                  ToolTip="{loc:T Tool.Chart.Tip}"
                                  Click="InsertChart_Click"/>

                    <ToggleButton x:Name="BtnSticky" Style="{StaticResource ToolButton}" Content="{views:Icon StickyNote}"
                                  ToolTip="{loc:T Tool.Sticky}" Checked="Tool_Checked" Tag="Sticky"/>
                    <ToggleButton x:Name="BtnSticker" Style="{StaticResource ToolButton}" Content="{views:Icon Sticker}"
                                  AutomationProperties.Name="{loc:T Tool.Sticker}"
                                  ToolTip="{loc:T Tool.Sticker.Tip}" Checked="Tool_Checked" Tag="Sticker"/>
                    <ToggleButton x:Name="BtnRuler" Style="{StaticResource ToolButton}"
                                  AutomationProperties.Name="{loc:T Tool.Ruler}"
                                  ToolTip="{loc:T Tool.Ruler.Tip}"
                                  Click="Ruler_Click">
                        <views:Symbol Icon="Ruler" Size="16"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnSetSquare" Style="{StaticResource ToolButton}"
                                  AutomationProperties.Name="{loc:T Tool.SetSquare}"
                                  ToolTip="{loc:T Tool.SetSquare.Tip}"
                                  Click="SetSquare_Click">
                        <views:Symbol Icon="SetSquare" Size="16"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </ToggleButton>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <!-- Farben -->
                    <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Standardfarbe folgt der Seite: Schwarz auf hellen, Weiß auf
                             dunklen Seiten (RefreshAutoSwatch aktualisiert die Anzeige) -->
                        <RadioButton x:Name="AutoSwatch" Style="{StaticResource ColorSwatch}" GroupName="ink" IsChecked="True"
                                     Background="#000000" Tag="auto"
                                     ToolTip="{loc:T Color.Auto}" Checked="Color_Checked"/>
                        <!-- **Die Farbkacheln entstehen im Code aus WbTinte.Palette** (Core).
                             Bis zum 2026-08-30 hatte dieser Kopf sieben Kacheln aus der
                             Theme-Tabelle, der Linux-Kopf fuenf aus den Tintenfarben — zwei
                             Paletten mit zwei fast gleichen Rottoenen, genau wovor
                             TdTextfarben seit §4.40 woertlich warnt (§4.74). -->
                        <RadioButton x:Name="CustomSwatch" Style="{StaticResource ColorSwatch}" GroupName="ink"
                                     Tag="#FF000000" ToolTip="{loc:T Color.Custom}" Checked="Color_Checked"
                                     Visibility="Collapsed"/>
                        <Button Style="{StaticResource IconButton}" ToolTip="{loc:T Color.Pick}"
                                Click="PickColor_Click">
                            <Ellipse Width="16" Height="16">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#EF4444" Offset="0"/>
                                        <GradientStop Color="#EAB308" Offset="0.25"/>
                                        <GradientStop Color="#22C55E" Offset="0.5"/>
                                        <GradientStop Color="#2563EB" Offset="0.75"/>
                                        <GradientStop Color="#8B5CF6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Button>
                    </StackPanel>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <!-- Werkzeuggröße. Alle drei Bedienelemente (Icon, Schieber, Wertanzeige)
                         öffnen per Langdruck denselben Zahlenblock. -->
                    <views:Symbol x:Name="WidthIcon" Icon="Pencil" Size="12" Cursor="Hand"
                               Stroke="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="2,0"
                               ToolTip="{loc:T Size.Tip}"
                               PreviewMouseLeftButtonDown="SizeInput_Down" PreviewMouseMove="SizeInput_Move"
                               PreviewMouseLeftButtonUp="SizeInput_Up"
                               TouchDown="SizeInput_TouchDown" TouchMove="SizeInput_TouchMove" TouchUp="SizeInput_TouchUp"/>
                    <!-- **0,5 bis 40, und das ist seit V2-85 in beiden Köpfen gleich**
                         (Nutzer-Entscheidung 2026-08-25, §5 Nr. 16). Hier stand vorher
                         1 bis 20, im Linux-Kopf 0,5 bis 40 — aufgefallen ist es erst, als
                         mit dem Zahlenblock dasselbe Bedienelement in beiden Köpfen stand.
                         Der weitere Bereich nimmt nichts weg: 0,5 ist ein feiner Strich,
                         den 1 nicht kann, und ein Strich der Stärke 30 aus dem Linux-Kopf
                         ließ sich hier vorher nicht auf seinen eigenen Wert einstellen.
                         **Der Zahlenblock klemmt gegen diese Werte** (WbZahlenblock). -->
                    <Slider x:Name="WidthSlider" Width="90" Minimum="0.5" Maximum="40" Value="2.5"
                            VerticalAlignment="Center" ValueChanged="WidthSlider_ValueChanged"
                            ToolTip="{loc:T Size.Tip}"
                            PreviewMouseLeftButtonDown="SizeInput_Down" PreviewMouseMove="SizeInput_Move"
                            PreviewMouseLeftButtonUp="SizeInput_Up"
                            TouchDown="SizeInput_TouchDown" TouchMove="SizeInput_TouchMove" TouchUp="SizeInput_TouchUp"/>
                    <Button x:Name="WidthLabel" Content="2,5" MinWidth="26" VerticalAlignment="Center" Margin="4,0,0,0"
                            Style="{StaticResource FlatButton}" Padding="4,2" FontSize="11"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            ToolTip="{loc:T Size.Tip}"
                            PreviewMouseLeftButtonDown="SizeInput_Down" PreviewMouseMove="SizeInput_Move"
                            PreviewMouseLeftButtonUp="SizeInput_Up"
                            TouchDown="SizeInput_TouchDown" TouchMove="SizeInput_TouchMove" TouchUp="SizeInput_TouchUp"/>

                    <!-- Zahlenblock (Popup) – Vorbild Adobe Fresco, im App-Stil -->
                    <Popup x:Name="SizeNumpad" PlacementTarget="{Binding ElementName=WidthSlider}"
                           Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                        <Border Background="{DynamicResource Brush.CardBg}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="12" Padding="10" Margin="8" Width="196">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.28"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock x:Name="NumpadDisplay" Text="2,5" FontSize="28" Margin="8,2,8,10"
                                           Foreground="{DynamicResource Brush.Text}"/>
                                <UniformGrid Columns="3" Rows="4">
                                    <Button Style="{StaticResource NumpadKey}" Content="7" Click="NumpadKey_Click"/>
                                    <Button Style="{StaticResource NumpadKey}" Content="8" Click="NumpadKey_Click"/>
                                    <Button Style="{StaticResource NumpadKey}" Content="9" Click="NumpadKey_Click"/>
                                    <Button Style="{StaticResource NumpadKey}" Content="4" Click="NumpadKey_Click"/>
                                    <Button Style="{StaticResource NumpadKey}" Content="5" Click="NumpadKey_Click"/>
                                    <Button Style="{StaticResource NumpadKey}" Content="6" Click="NumpadKey_Click"/>
                                    <Button Style="{StaticResource NumpadKey}" Content="1" Click="NumpadKey_Click"/>
                                    <Button Style="{StaticResource NumpadKey}" Content="2" Click="NumpadKey_Click"/>
                                    <Button Style="{StaticResource NumpadKey}" Content="3" Click="NumpadKey_Click"/>
                                    <Button Style="{StaticResource NumpadKey}" Content="0" Click="NumpadKey_Click"/>
                                    <Button Style="{StaticResource NumpadKey}" Content="," Click="NumpadKey_Click"/>
                                    <Button Style="{StaticResource NumpadKey}" Content="{views:Icon Backspace}" FontSize="16"
                                            Click="NumpadBack_Click" ToolTip="{loc:T Action.Delete}"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <!-- Undo / Redo -->
                    <Button x:Name="BtnUndo" Style="{StaticResource IconButton}" Content="{views:Icon Undo}"
                            ToolTip="{loc:T Action.Undo}" Click="Undo_Click" IsEnabled="False"/>
                    <Button x:Name="BtnRedo" Style="{StaticResource IconButton}" Content="{views:Icon Redo}"
                            ToolTip="{loc:T Action.Redo}" Click="Redo_Click" IsEnabled="False"/>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <!-- Zoom -->
                    <Button Style="{StaticResource IconButton}" Content="{views:Icon ZoomOut}" ToolTip="{loc:T Zoom.Out}"
                            Click="ZoomOut_Click"/>
                    <Button x:Name="ZoomLabel" Style="{StaticResource FlatButton}" Content="100 %"
                            ToolTip="{loc:T Zoom.Reset}" Click="ZoomReset_Click" MinWidth="52"/>
                    <Button Style="{StaticResource IconButton}" Content="{views:Icon ZoomIn}" ToolTip="{loc:T Zoom.In}"
                            Click="ZoomIn_Click"/>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <Button Style="{StaticResource IconButton}" Content="{views:Icon Image}"
                            AutomationProperties.Name="{loc:T Wb.InsertFile}"
                            ToolTip="{loc:T Wb.InsertFile.Tip}"
                            Click="InsertFile_Click"/>

                    <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="6,4"/>

                    <Button Style="{StaticResource IconButton}" Content="{views:Icon Settings}"
                            AutomationProperties.Name="{loc:T Wb.Settings}"
                            ToolTip="{loc:T Wb.Settings.Tip}" Click="PageSetup_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===== Seitenleiste unten (nur Notizbücher) ===== -->
        <Border x:Name="PageBar" DockPanel.Dock="Bottom" Background="{DynamicResource Brush.ToolbarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="8,3" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="{views:Icon ChevronLeft}" ToolTip="{loc:T Page.Previous}"
                        AutomationProperties.Name="{loc:T Page.Previous}" Click="PrevPage_Click"/>
                <TextBlock x:Name="PageLabel" Text="{loc:T Page.Label}" VerticalAlignment="Center" Margin="10,0"
                           Foreground="{DynamicResource Brush.Text}"/>
                <Button Style="{StaticResource IconButton}" Content="{views:Icon ChevronRight}" ToolTip="{loc:T Page.Next}"
                        AutomationProperties.Name="{loc:T Page.Next}" Click="NextPage_Click"/>
                <Border Width="1" Background="{DynamicResource Brush.Border}" Margin="8,4"/>
                <Button Style="{StaticResource IconButton}" Content="{views:Icon Plus}" ToolTip="{loc:T Page.Add}"
                        AutomationProperties.Name="{loc:T Page.Add}" Click="AddPage_Click"/>
                <Button Style="{StaticResource IconButton}" Content="{views:Icon Trash}" ToolTip="{loc:T Page.Delete}"
                        AutomationProperties.Name="{loc:T Page.Delete}" Click="DeletePage_Click"/>
            </StackPanel>
        </Border>

        <!-- ===== Einstellungen (rechte Seitenleiste, wie Word-Formatbereich) ===== -->
        <Border x:Name="SettingsPanel" DockPanel.Dock="Right" Width="270" Visibility="Collapsed"
                Background="{DynamicResource Brush.ToolbarBg}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1" Padding="14,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{views:Icon Close}"
                                ToolTip="{loc:T Wb.Settings.Close}" Click="PageSetup_Click"/>
                        <TextBlock Text="{loc:T Wb.Settings}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,12">

                        <!-- Seite -->
                        <Expander Header="{loc:T Settings.Page}" IsExpanded="True">
                        <StackPanel>
                        <TextBlock Text="{loc:T Settings.Page.Pattern}" FontWeight="SemiBold" Margin="0,0,0,4"
                                   Foreground="{DynamicResource Brush.Text}"/>
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <RadioButton x:Name="SetBgBlank" Content="{loc:T Settings.Page.Blank}" GroupName="setBg" Margin="0,2"
                                         Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                            <RadioButton x:Name="SetBgLines" Content="{loc:T Settings.Page.Lines}" GroupName="setBg" Margin="0,2"
                                         Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                            <RadioButton x:Name="SetBgGrid" Content="{loc:T Settings.Page.Grid}" GroupName="setBg" Margin="0,2"
                                         Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                            <RadioButton x:Name="SetBgDots" Content="{loc:T Settings.Page.Dots}" GroupName="setBg" Margin="0,2"
                                         Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                        </UniformGrid>

                        <TextBlock Text="{loc:T Settings.Page.Shade}" FontWeight="SemiBold" Margin="0,0,0,4"
                                   Foreground="{DynamicResource Brush.Text}"/>
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <RadioButton x:Name="SetShadeAuto" Content="{loc:T Settings.Page.Shade.Auto}" GroupName="setShade" Margin="0,2"
                                         Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                            <RadioButton x:Name="SetShadeLight" Content="{loc:T Settings.Page.Shade.Light}" GroupName="setShade" Margin="0,2"
                                         Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                            <RadioButton x:Name="SetShadeDark" Content="{loc:T Settings.Page.Shade.Dark}" GroupName="setShade" Margin="0,2"
                                         Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                        </UniformGrid>

                        <StackPanel x:Name="SetSizeSection">
                            <TextBlock Text="{loc:T Settings.Page.Format}" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <RadioButton x:Name="SetSizeA4" Content="A4" GroupName="setSize" Margin="0,2"
                                             Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                                <RadioButton x:Name="SetSizeA3" Content="A3" GroupName="setSize" Margin="0,2"
                                             Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                            </UniformGrid>

                            <TextBlock Text="{loc:T Settings.Page.Orientation}" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <RadioButton x:Name="SetOrientPortrait" Content="{loc:T Settings.Page.Portrait}" GroupName="setOrient" Margin="0,2"
                                             Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                                <RadioButton x:Name="SetOrientLandscape" Content="{loc:T Settings.Page.Landscape}" GroupName="setOrient" Margin="0,2"
                                             Foreground="{DynamicResource Brush.Text}" Checked="PageSetting_Changed"/>
                            </UniformGrid>

                            <CheckBox x:Name="SetAsDefault" Content="{loc:T Settings.Page.AsDefault}"
                                      Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,12"
                                      Checked="PageSetting_Changed" Unchecked="PageSetting_Changed"/>
                        </StackPanel>
                        </StackPanel>
                        </Expander>

                        <!-- Formen (nur bei aktivem Formen-Werkzeug sichtbar) -->
                        <Expander x:Name="ShapeSection" Header="{loc:T Settings.Shapes}" IsExpanded="True">
                        <StackPanel>
                            <TextBlock Text="{loc:T Settings.Shapes.Hint}"
                                       Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ToggleButton x:Name="BtnShapeFill" Style="{StaticResource ToolButton}"
                                              ToolTip="{loc:T Settings.Shapes.FillToggle}"
                                              Checked="ShapeFill_Changed" Unchecked="ShapeFill_Changed">
                                    <Border Width="14" Height="14" CornerRadius="3"
                                            Background="{StaticResource CheckerBrush}" ClipToBounds="True">
                                        <Rectangle x:Name="FillPreviewRect" Fill="#6614B8A6"/>
                                    </Border>
                                </ToggleButton>
                                <Button Style="{StaticResource IconButton}" ToolTip="{loc:T Settings.Shapes.FillColor}"
                                        Click="PickFillColor_Click" Content="{views:Icon Palette}"/>
                                <TextBlock Text="{loc:T Settings.Shapes.Fill}" VerticalAlignment="Center" Margin="6,0,0,0"
                                           Foreground="{DynamicResource Brush.Text}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="{loc:T Settings.Shapes.Opacity}" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                                <Slider x:Name="FillOpacitySlider" Width="110" Minimum="0" Maximum="100" Value="40"
                                        VerticalAlignment="Center" ValueChanged="FillOpacity_ValueChanged"/>
                                <TextBlock x:Name="FillOpacityLabel" Text="40 %" Width="34" VerticalAlignment="Center"
                                           Margin="4,0,0,0" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                        </Expander>

                        <!-- Text-Werkzeug -->
                        <Expander x:Name="TextSection" Header="{loc:T Settings.Text}" IsExpanded="False">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Style="{StaticResource FlatButton}" Click="TextColor_Click" ToolTip="{loc:T Settings.Text.ColorTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="TextColorSwatch" Width="14" Height="14" CornerRadius="3"
                                                Background="#000000" Margin="0,0,6,0"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"/>
                                        <TextBlock Text="{loc:T Settings.Text.Color}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Style="{StaticResource FlatButton}" Click="TextBg_Click" ToolTip="{loc:T Settings.Text.BgTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,6,0"
                                                Background="{StaticResource CheckerBrush}" ClipToBounds="True"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                            <Border x:Name="TextBgSwatch" Background="Transparent"/>
                                        </Border>
                                        <TextBlock Text="{loc:T Settings.Text.Bg}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource FlatButton}" Content="{loc:T Settings.Text.Transparent}"
                                        Click="TextBgClear_Click" Margin="8,0,0,0"/>
                            </StackPanel>

                            <TextBlock Text="{loc:T Settings.Text.Font}" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <ComboBox x:Name="TextFontBox" Margin="0,0,0,4"
                                      SelectionChanged="TextFont_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{loc:T Settings.Text.Hint}"
                                       Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>
                        </StackPanel>
                        </Expander>

                        <!-- Notizzettel (nur bei aktivem Notizzettel-Werkzeug sichtbar) -->
                        <Expander x:Name="StickySection" Header="{loc:T Settings.Sticky}" IsExpanded="True">
                        <StackPanel>
                            <TextBlock Text="{loc:T Settings.Sticky.Color}" FontWeight="SemiBold" Margin="0,0,0,6"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <StackPanel x:Name="StickyColorPanel" Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton Style="{StaticResource ColorSwatch}" GroupName="sticky" IsChecked="True"
                                             Background="#FEF08A" Tag="#FFFEF08A" ToolTip="{loc:T Color.Yellow}" Checked="StickyColor_Checked"/>
                                <RadioButton Style="{StaticResource ColorSwatch}" GroupName="sticky"
                                             Background="#BBF7D0" Tag="#FFBBF7D0" ToolTip="{loc:T Color.Green}" Checked="StickyColor_Checked"/>
                                <RadioButton Style="{StaticResource ColorSwatch}" GroupName="sticky"
                                             Background="#BFDBFE" Tag="#FFBFDBFE" ToolTip="{loc:T Color.Blue}" Checked="StickyColor_Checked"/>
                                <RadioButton Style="{StaticResource ColorSwatch}" GroupName="sticky"
                                             Background="#FBCFE8" Tag="#FFFBCFE8" ToolTip="{loc:T Color.Pink}" Checked="StickyColor_Checked"/>
                                <RadioButton Style="{StaticResource ColorSwatch}" GroupName="sticky"
                                             Background="#FED7AA" Tag="#FFFED7AA" ToolTip="{loc:T Color.Orange}" Checked="StickyColor_Checked"/>
                                <RadioButton x:Name="StickyCustomSwatch" Style="{StaticResource ColorSwatch}" GroupName="sticky"
                                             Tag="#FFFEF08A" ToolTip="{loc:T Color.Custom}" Checked="StickyColor_Checked"
                                             Visibility="Collapsed"/>
                                <Button Style="{StaticResource IconButton}" ToolTip="{loc:T Settings.Sticky.CustomColor}"
                                        Click="StickyColorPick_Click" Content="{views:Icon Palette}"/>
                            </StackPanel>
                            <TextBlock Text="{loc:T Settings.Sticky.Hint}"
                                       Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>
                        </StackPanel>
                        </Expander>

                        <!-- Sticker (Bild-Aufkleber) -->
                        <Expander x:Name="StickerSection" Header="{loc:T Tool.Sticker}" IsExpanded="True" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{loc:T Settings.Sticker.Hint}"
                                       Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="StickerGrid"/>
                            </ScrollViewer>
                            <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Click="AddSticker_Click" AutomationProperties.Name="{loc:T Settings.Sticker.Add}">
                                <StackPanel Orientation="Horizontal">
                                    <views:Symbol Icon="Plus" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:T Settings.Sticker.Add}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        </Expander>

                        <!-- Cover (nur Notizbücher) -->
                        <Expander Header="{loc:T Settings.Export}" IsExpanded="False">
                            <StackPanel>
                                <TextBlock Text="{loc:T Settings.Export.Hint}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="{DynamicResource Brush.TextMuted}"/>
                                <Button Content="{loc:T Settings.Export.Pdf}" Style="{StaticResource FlatButton}"
                                        Click="ExportPdf_Click" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                                <Button Content="{loc:T Settings.Export.Png}" Style="{StaticResource FlatButton}"
                                        Click="ExportPng_Click" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Expander>

                        <Expander x:Name="CoverSection" Header="{loc:T Settings.Cover}" IsExpanded="False" Visibility="Collapsed"
                                  Expanded="CoverSection_Expanded">
                        <StackPanel>
                            <TextBlock Text="{loc:T Settings.Cover.Gradient}" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Style="{StaticResource FlatButton}" Click="CoverStart_Click" ToolTip="{loc:T Settings.Cover.StartColor}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="CoverStartSwatch" Width="14" Height="14" CornerRadius="3"
                                                Background="#1E3A8A" Margin="0,0,6,0"/>
                                        <TextBlock Text="{loc:T Settings.Cover.Start}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource FlatButton}" Click="CoverEnd_Click" Margin="8,0,0,0"
                                        ToolTip="{loc:T Settings.Cover.EndColor}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="CoverEndSwatch" Width="14" Height="14" CornerRadius="3"
                                                Background="#7C3AED" Margin="0,0,6,0"/>
                                        <TextBlock Text="{loc:T Settings.Cover.End}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock Text="{loc:T Settings.Cover.Font}" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <ComboBox x:Name="CoverFontBox" Margin="0,0,0,12"
                                      SelectionChanged="CoverFont_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="{loc:T Settings.Cover.Image}" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="{loc:T Settings.Cover.ChooseImage}" Style="{StaticResource FlatButton}" Click="CoverImage_Click"/>
                                <Button x:Name="BtnCoverImageRemove" Content="{loc:T Settings.Cover.RemoveImage}" Style="{StaticResource FlatButton}"
                                        Click="CoverImageRemove_Click" Margin="8,0,0,0" IsEnabled="False"/>
                            </StackPanel>
                            <TextBlock Text="{loc:T Settings.Cover.ImageHint}"
                                       Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <!-- Cover-Vorlagen (Assets\Covers neben der Exe + eigene in
                                 %APPDATA%\GonkNote\Covers); befüllt beim ersten Aufklappen -->
                            <TextBlock Text="{loc:T Settings.Cover.Presets}" FontWeight="SemiBold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <StackPanel x:Name="CoverPresetHost"/>
                        </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Zeichenfläche ===== -->
        <Grid x:Name="CanvasHost" Background="Transparent" ClipToBounds="True"
              AllowDrop="True" DragOver="CanvasHost_DragOver" Drop="CanvasHost_Drop">
            <skia:SKElement x:Name="Skia" PaintSurface="Skia_PaintSurface"/>
            <Canvas x:Name="Overlay" Background="{x:Null}">
                <TextBox x:Name="EditBox" Visibility="Collapsed" AcceptsReturn="True"
                         MinWidth="60" FontFamily="Segoe UI" BorderThickness="1"
                         LostKeyboardFocus="EditBox_LostFocus" PreviewKeyDown="EditBox_KeyDown"/>
            </Canvas>

            <!-- Schnellaktionen (Quick-Options): floatende Icon-Leiste im Toolbar-Look.
                 Ersetzt das Rechtsklick-Menü; öffnet per Rechtsklick / zweiter Stift-
                 Taste bzw. automatisch nach einer Lasso-/Verschieben-Auswahl. Position
                 wird per Margin im Code gesetzt. -->
            <Border x:Name="QuickMenu" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="50"
                    Background="{DynamicResource Brush.CardBg}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="10" Padding="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.28"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="Qm_Cut" Style="{StaticResource IconButton}" Content="{views:Icon Cut}"
                            ToolTip="{loc:T Quick.Cut.Tip}" AutomationProperties.Name="{loc:T Quick.Cut}"
                            Click="Cm_Cut_Click"/>
                    <Button x:Name="Qm_Copy" Style="{StaticResource IconButton}" Content="{views:Icon Copy}"
                            ToolTip="{loc:T Quick.Copy.Tip}" AutomationProperties.Name="{loc:T Quick.Copy}"
                            Click="Cm_Copy_Click"/>
                    <Button x:Name="Qm_Duplicate" Style="{StaticResource IconButton}" Content="{views:Icon Duplicate}"
                            ToolTip="{loc:T Quick.Duplicate.Tip}" AutomationProperties.Name="{loc:T Quick.Duplicate}"
                            Click="Cm_Duplicate_Click"/>
                    <Button x:Name="Qm_Paste" Style="{StaticResource IconButton}" Content="{views:Icon Paste}"
                            ToolTip="{loc:T Quick.Paste.Tip}" AutomationProperties.Name="{loc:T Quick.Paste}"
                            Click="Cm_Paste_Click"/>
                    <Border x:Name="Qm_SepOcr" Width="1" Background="{DynamicResource Brush.Border}" Margin="3,5"/>
                    <Button x:Name="Qm_Ocr" Style="{StaticResource IconButton}" Content="{views:Icon Ocr}"
                            ToolTip="{loc:T Quick.Ocr}" AutomationProperties.Name="{loc:T Quick.Ocr}"
                            Click="Cm_Ocr_Click"/>
                    <Border x:Name="Qm_Sep2" Width="1" Background="{DynamicResource Brush.Border}" Margin="3,5"/>
                    <Button x:Name="Qm_Delete" Style="{StaticResource IconButton}" Content="{views:Icon Trash}"
                            ToolTip="{loc:T Quick.Delete.Tip}" AutomationProperties.Name="{loc:T Action.Delete}"
                            Click="Cm_Delete_Click"/>
                    <Button x:Name="Qm_SelectAll" Style="{StaticResource IconButton}" Content="{views:Icon SelectAll}"
                            ToolTip="{loc:T Quick.SelectAll.Tip}" AutomationProperties.Name="{loc:T Quick.SelectAll}"
                            Click="Cm_SelectAll_Click"/>
                </StackPanel>
            </Border>

            <!-- Fortschritts-Overlay während des Imports (blockiert Eingaben) -->
            <Border x:Name="BusyOverlay" Visibility="Collapsed" Background="#66000000">
                <Border Background="{DynamicResource Brush.CardBg}" CornerRadius="10" Padding="26,20"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <StackPanel>
                        <ProgressBar x:Name="BusyBar" Width="240" Height="6" Minimum="0" Maximum="100"
                                     IsIndeterminate="True"/>
                        <TextBlock x:Name="BusyText" Text="{loc:T Busy.Importing}" Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text}"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

    </DockPanel>
</UserControl>
